<%- include('../partials/header') %>
<%- include('../partials/server/header') %>

<div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">

        <div class="flex items-center gap-3">
            <div class="glass px-4 py-2 rounded-xl flex items-center gap-2">
                <i class="fa-solid fa-user-group text-indigo-400"></i>
                <span class="text-white font-bold"><%= users.length %></span>
                <span class="text-gray-400 text-sm">Users</span>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-8">
        <div class="glass p-5 rounded-2xl">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-yellow-500/20 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-crown text-yellow-400 text-xl"></i>
                </div>
                <div>
                    <div class="text-2xl font-bold text-white">1</div>
                    <div class="text-xs text-gray-500">Owner</div>
                </div>
            </div>
        </div>
        <div class="glass p-5 rounded-2xl">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-user-check text-blue-400 text-xl"></i>
                </div>
                <div>
                    <div class="text-2xl font-bold text-white"><%= users.length - 1 %></div>
                    <div class="text-xs text-gray-500">Collaborators</div>
                </div>
            </div>
        </div>
        <div class="glass p-5 rounded-2xl col-span-2 md:col-span-1">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-shield-check text-green-400 text-xl"></i>
                </div>
                <div>
                    <div class="text-2xl font-bold text-white"><%= users.length %></div>
                    <div class="text-xs text-gray-500">Total Access</div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">
        <!-- Add User Card -->
        <% if(isOwner || user.isAdmin) { %>
        <div class="lg:col-span-1">
            <div class="glass p-6 rounded-2xl sticky top-4">
                <h3 class="text-lg font-bold mb-4 flex items-center gap-2 text-white">
                    <div class="w-8 h-8 bg-green-500/20 rounded-lg flex items-center justify-center">
                        <i class="fa-solid fa-user-plus text-green-400"></i>
                    </div>
                    Add User
                </h3>

                <form method="POST" action="/server/<%= s.id %>/users/add" class="space-y-4">
                    <div>
                        <label class="text-xs font-bold text-gray-500 uppercase mb-2 block">User ID</label>
                        <input 
                            type="text"
                            name="userId"
                            placeholder="Enter Discord User ID"
                            required
                            class="w-full bg-black/30 border border-white/10 text-white px-4 py-3 rounded-xl placeholder-gray-500 focus:outline-none focus:border-green-500 transition"
                        />
                    </div>
                    <button 
                        type="submit" 
                        class="w-full bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-xl font-bold transition flex items-center justify-center gap-2"
                    >
                        <i class="fa-solid fa-plus"></i>
                        Add Collaborator
                    </button>
                </form>

                <div class="mt-4 p-3 bg-indigo-500/10 border border-indigo-500/20 rounded-xl">
                    <div class="flex items-start gap-2">
                        <i class="fa-solid fa-circle-info text-indigo-400 mt-0.5"></i>
                        <p class="text-xs text-gray-400">
                            Collaborators can view and manage this server but cannot delete it or manage other users.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        <% } %>

        <!-- Users List -->
        <div class="<%= (isOwner || user.isAdmin) ? 'lg:col-span-2' : 'lg:col-span-3' %>">
            <div class="glass rounded-2xl overflow-hidden">
                <!-- List Header -->
                <div class="p-4 border-b border-white/10 flex items-center justify-between">
                    <h3 class="font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-list text-gray-400"></i>
                        All Users
                    </h3>
                    <span class="text-xs text-gray-500"><%= users.length %> total</span>
                </div>

                <!-- Users -->
                <div class="divide-y divide-white/5">
                    <% users.forEach((u, index) => { %>
                    <div class="p-4 hover:bg-white/5 transition group">
                        <div class="flex items-center justify-between gap-4">
                            <!-- User Info -->
                            <div class="flex items-center gap-4 flex-1 min-w-0">
                                <div class="relative">
                                    <img
                                        src="<%= u.avatar ? `https://cdn.discordapp.com/avatars/${u.id}/${u.avatar}.png?size=128` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" 
                                        alt="avatar"
                                        class="w-12 h-12 rounded-full object-cover border-2 <%= u.id === s.ownerId ? 'border-yellow-500' : 'border-white/20' %>"
                                    />
                                    <% if(u.id === s.ownerId) { %>
                                    <div class="absolute -top-1 -right-1 w-5 h-5 bg-yellow-500 rounded-full flex items-center justify-center">
                                        <i class="fa-solid fa-crown text-[10px] text-yellow-900"></i>
                                    </div>
                                    <% } %>
                                </div>
                                <div class="min-w-0">
                                    <div class="font-semibold text-white truncate"><%= u.username %></div>
                                    <div class="text-xs text-gray-500 font-mono"><%= u.id %></div>
                                </div>
                            </div>

                            <!-- Role Badge -->
                            <div class="flex-shrink-0">
                                <% if(u.id === s.ownerId) { %>
                                <span class="inline-flex items-center gap-1.5 bg-gradient-to-r from-yellow-500/20 to-orange-500/20 text-yellow-400 px-3 py-1.5 rounded-lg text-xs font-bold border border-yellow-500/30">
                                    <i class="fa-solid fa-crown"></i>
                                    Owner
                                </span>
                                <% } else { %>
                                <span class="inline-flex items-center gap-1.5 bg-blue-500/20 text-blue-400 px-3 py-1.5 rounded-lg text-xs font-bold border border-blue-500/30">
                                    <i class="fa-solid fa-user-check"></i>
                                    Collaborator
                                </span>
                                <% } %>
                            </div>

                            <!-- Actions -->
                            <div class="flex-shrink-0">
                                <% if((isOwner || user.isAdmin) && u.id !== s.ownerId) { %>
                                <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition">
                                    <form 
                                        method="POST" 
                                        action="/server/<%= s.id %>/users/remove"
                                        onsubmit="return confirm('Are you sure you want to remove this user from the server?')"
                                    >
                                        <input type="hidden" name="userId" value="<%= u.id %>">
                                        <button class="w-9 h-9 bg-red-500/20 hover:bg-red-500 text-red-400 hover:text-white rounded-lg transition flex items-center justify-center" title="Remove User">
                                            <i class="fa-solid fa-user-minus"></i>
                                        </button>
                                    </form>
                                </div>
                                <% } else if(u.id === s.ownerId) { %>
                                <div class="w-9 h-9 flex items-center justify-center text-gray-600">
                                    <i class="fa-solid fa-lock"></i>
                                </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>

                <% if(users.length === 0) { %>
                <div class="p-12 text-center">
                    <div class="w-16 h-16 bg-gray-800 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fa-solid fa-users text-2xl text-gray-600"></i>
                    </div>
                    <h3 class="text-gray-400 font-medium mb-1">No Users Found</h3>
                    <p class="text-sm text-gray-600">Add collaborators to give them access to this server.</p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
