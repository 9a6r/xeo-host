<%- include('../partials/header') %>
<%- include('../partials/server/header') %>



    <!-- Alert Messages -->
    <% if(message) { %>
    <div class="mb-6 p-4 rounded-xl <%= message.type === 'success' ? 'bg-green-500/20 border border-green-500/30 text-green-400' : 'bg-red-500/20 border border-red-500/30 text-red-400' %>">
        <i class="fa-solid <%= message.type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle' %> mr-2"></i>
        <%= message.text %>
    </div>
    <% } %>

    <!-- Create Backup -->
    <div class="glass p-6 rounded-2xl mb-6 border border-white/5">
        <h3 class="font-bold text-white mb-4 flex items-center gap-2">
            <i class="fa-solid fa-plus-circle text-green-400"></i>
            Create New Backup
        </h3>
        <form action="/server/<%= s.id %>/backup/create" method="POST" class="flex gap-4">
            <input type="text" name="name" placeholder="Backup name (optional)" 
                class="flex-1 bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white outline-none focus:border-indigo-500 transition"
                pattern="[a-zA-Z0-9_-]+" title="Only letters, numbers, underscores and dashes allowed">
            <button class="bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-xl font-bold transition shadow-lg whitespace-nowrap">
                <i class="fa-solid fa-cloud-arrow-up mr-2"></i>Create Backup
            </button>
        </form>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="glass p-4 rounded-xl flex items-center gap-4">
            <div class="w-10 h-10 bg-indigo-600/20 rounded-lg flex items-center justify-center">
                <i class="fa-solid fa-file-zipper text-indigo-400"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-white"><%= backups.length %></div>
                <div class="text-xs text-gray-400">Total Backups</div>
            </div>
        </div>
        <div class="glass p-4 rounded-xl flex items-center gap-4">
            <div class="w-10 h-10 bg-yellow-600/20 rounded-lg flex items-center justify-center">
                <i class="fa-solid fa-weight-hanging text-yellow-400"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-white"><%= totalSize %> MB</div>
                <div class="text-xs text-gray-400">Total Size</div>
            </div>
        </div>
        <div class="glass p-4 rounded-xl flex items-center gap-4">
            <div class="w-10 h-10 bg-green-600/20 rounded-lg flex items-center justify-center">
                <i class="fa-solid fa-server text-green-400"></i>
            </div>
            <div>
                <div class="text-lg font-bold text-white truncate max-w-[150px]"><%= s.name %></div>
                <div class="text-xs text-gray-400">Server</div>
            </div>
        </div>
    </div>

    <!-- Backups List -->
    <div class="glass p-6 rounded-2xl border border-white/5">
        <h3 class="font-bold text-gray-400 uppercase text-xs mb-4">
            <i class="fa-solid fa-folder-open mr-2"></i>Your Backups
        </h3>

        <% if(backups.length === 0) { %>
        <div class="text-center py-16 text-gray-500">
            <i class="fa-solid fa-box-open text-5xl mb-4"></i>
            <p class="text-lg">No backups yet</p>
            <p class="text-sm mt-2">Create your first backup to protect your project</p>
        </div>
        <% } else { %>
        <div class="space-y-3 max-h-[500px] overflow-y-auto custom-scroll">
            <% backups.forEach(b => { %>
            <div class="bg-white/5 p-4 rounded-xl hover:bg-white/10 transition border border-white/5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-indigo-600/20 rounded-xl flex items-center justify-center">
                            <i class="fa-solid fa-file-zipper text-indigo-400 text-xl"></i>
                        </div>
                        <div>
                            <div class="font-bold text-white"><%= b.name %></div>
                            <div class="text-xs text-gray-400 mt-1">
                                <span class="mr-4"><i class="fa-solid fa-calendar mr-1"></i><%= b.date %></span>
                                <span class="mr-4"><i class="fa-solid fa-clock mr-1"></i><%= b.time %></span>
                                <span><i class="fa-solid fa-weight-hanging mr-1"></i><%= b.size %></span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <!-- Download -->
                        <a href="/server/<%= s.id %>/backup/download/<%= b.filename %>" 
                            class="bg-blue-600/20 text-blue-400 p-2.5 rounded-lg hover:bg-blue-600 hover:text-white transition" title="Download">
                            <i class="fa-solid fa-download"></i>
                        </a>
                        <!-- Rename -->
                        <button onclick="openRenameModal('<%= b.filename %>', '<%= b.name %>')"
                            class="bg-yellow-600/20 text-yellow-400 p-2.5 rounded-lg hover:bg-yellow-600 hover:text-white transition" title="Rename">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <!-- Restore -->
                        <form action="/server/<%= s.id %>/backup/restore" method="POST" class="inline"
                            onsubmit="return confirm('⚠️ This will replace all current files with this backup. Are you sure?')">
                            <input type="hidden" name="filename" value="<%= b.filename %>">
                            <button class="bg-green-600/20 text-green-400 p-2.5 rounded-lg hover:bg-green-600 hover:text-white transition" title="Restore">
                                <i class="fa-solid fa-rotate-left"></i>
                            </button>
                        </form>
                        <!-- Delete -->
                        <form action="/server/<%= s.id %>/backup/delete" method="POST" class="inline"
                            onsubmit="return confirm('Delete this backup?')">
                            <input type="hidden" name="filename" value="<%= b.filename %>">
                            <button class="bg-red-600/20 text-red-400 p-2.5 rounded-lg hover:bg-red-600 hover:text-white transition" title="Delete">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>
    </div>

    <!-- Info -->
    <div class="glass p-4 rounded-xl mt-6 border border-indigo-500/20">
        <div class="flex items-start gap-3">
            <i class="fa-solid fa-lightbulb text-indigo-400 mt-0.5"></i>
            <div class="text-sm text-gray-400">
                <p class="font-bold text-indigo-400 mb-1">Tips</p>
                <ul class="list-disc list-inside space-y-1">
                    <li>Create backups before making major changes</li>
                    <li>Download important backups to your local machine</li>
                    <li>Restoring a backup will replace all current files</li>
                    <li>Give your backups meaningful names for easy identification</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Rename Modal -->
<div id="renameModal" class="hidden fixed inset-0 bg-black/90 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="glass bg-[#151515] p-8 rounded-3xl w-full max-w-md border border-white/10 shadow-2xl relative">
        <button onclick="closeRenameModal()" class="absolute top-4 right-4 text-gray-500 hover:text-white">
            <i class="fa-solid fa-xmark text-xl"></i>
        </button>
        <h3 class="text-xl font-bold mb-1">Rename Backup</h3>
        <p class="text-gray-400 text-sm mb-6">Enter a new name for this backup</p>
        
        <form action="/server/<%= s.id %>/backup/rename" method="POST">
            <input type="hidden" name="filename" id="renameFilename">
            <input type="text" name="newName" id="renameInput" placeholder="New name" required
                class="w-full bg-black/50 border border-white/10 p-3 rounded-xl text-white outline-none mb-4 focus:border-indigo-500"
                pattern="[a-zA-Z0-9_-]+" title="Only letters, numbers, underscores and dashes allowed">
            <div class="flex gap-3">
                <button type="button" onclick="closeRenameModal()" 
                    class="flex-1 bg-gray-700 hover:bg-gray-600 text-white py-3 rounded-xl font-bold transition">
                    Cancel
                </button>
                <button type="submit" 
                    class="flex-1 bg-indigo-600 hover:bg-indigo-500 text-white py-3 rounded-xl font-bold transition">
                    <i class="fa-solid fa-check mr-2"></i>Rename
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function openRenameModal(filename, currentName) {
    document.getElementById('renameFilename').value = filename;
    document.getElementById('renameInput').value = currentName;
    document.getElementById('renameModal').classList.remove('hidden');
    document.getElementById('renameInput').focus();
}

function closeRenameModal() {
    document.getElementById('renameModal').classList.add('hidden');
}

// Close modal on escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeRenameModal();
});
</script>

<%- include('../partials/footer') %>
