    // Render files table
    function renderFiles(files) {
        var tbody = document.getElementById('fileTableBody');
        if (!tbody) return;
        
        var html = '';
        for (var i = 0; i < files.length; i++) {
            var f = files[i];
            var safeName = escapeHtml(f.name);
            html += '<tr class="border-b border-white/5 hover:bg-white/5 transition file-row group" data-name="' + encodeURIComponent(f.name) + '" data-isdir="' + f.isDir + '">';
            html += '<td class="p-3"><input type="checkbox" class="file-checkbox w-4 h-4 rounded cursor-pointer accent-yellow-500" data-name="' + encodeURIComponent(f.name) + '"></td>';
            html += '<td class="p-3 cursor-pointer file-name" dir="auto">';
            if (f.isDir) {
                html += '<i class="fa-solid fa-folder text-yellow-500 mr-2"></i>';
            } else {
                var ext = f.name.split('.').pop().toLowerCase();
                var fileName = f.name.toLowerCase();
                var iconData = getFileIcon(fileName, ext);
                html += '<i class="' + iconData.icon + ' ' + iconData.color + ' mr-2"></i>';
            }
            html += safeName;
            html += '</td>';
            html += '<td class="p-3 text-gray-400">' + (f.size/1024).toFixed(1) + ' KB</td>';
            html += '<td class="p-3"><div class="flex justify-end items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">';
            if (!f.isDir) {
                html += '<button class="btn-edit w-8 h-8 flex items-center justify-center rounded-lg bg-indigo-500/20 hover:bg-indigo-500 text-indigo-400 hover:text-white transition-all duration-200 hover:scale-110" title="Edit"><i class="fa-solid fa-pen-to-square text-sm"></i></button>';
                // Check if file is an archive
                var isArchive = f.name.endsWith('.zip') || f.name.endsWith('.tar') || f.name.endsWith('.tar.gz') || f.name.endsWith('.rar') || f.name.endsWith('.7z');
                if (isArchive) {
                    html += '<button class="btn-unarchive w-8 h-8 flex items-center justify-center rounded-lg bg-emerald-500/20 hover:bg-emerald-500 text-emerald-400 hover:text-white transition-all duration-200 hover:scale-110" title="Extract"><i class="fa-solid fa-box-open text-sm"></i></button>';
                }
            }
            html += '<button class="btn-rename w-8 h-8 flex items-center justify-center rounded-lg bg-orange-500/20 hover:bg-orange-500 text-orange-400 hover:text-white transition-all duration-200 hover:scale-110" title="Rename"><i class="fa-solid fa-i-cursor text-sm"></i></button>';
            html += '<button class="btn-delete w-8 h-8 flex items-center justify-center rounded-lg bg-red-500/20 hover:bg-red-500 text-red-400 hover:text-white transition-all duration-200 hover:scale-110" title="Delete"><i class="fa-solid fa-trash-can text-sm"></i></button>';
            html += '</div></td></tr>';
        }
        tbody.innerHTML = html;
        attachRowEvents();
        attachCheckboxEvents();
        updateSelectAllState();
    }
    
    // Update selection count and button visibility
    function updateSelectionUI() {
        var count = document.querySelectorAll('.file-checkbox:checked').length;
        var bar = document.getElementById('selectionBar');
        var countSpan = document.getElementById('selectedCount');

        if (count > 0) {
            bar.classList.remove('hidden');
            countSpan.textContent = count + ' item' + (count > 1 ? 's' : '') + ' selected';
        } else {
            bar.classList.add('hidden');
        }
    }

    
    // Update select all checkbox state
    function updateSelectAllState() {
        var allCheckboxes = document.querySelectorAll('.file-checkbox');
        var checkedCheckboxes = document.querySelectorAll('.file-checkbox:checked');
        var selectAllCheckbox = document.getElementById('selectAllCheckbox');
        
        if (allCheckboxes.length === 0) {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
        } else if (checkedCheckboxes.length === 0) {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = false;
        } else if (checkedCheckboxes.length === allCheckboxes.length) {
            selectAllCheckbox.checked = true;
            selectAllCheckbox.indeterminate = false;
        } else {
            selectAllCheckbox.checked = false;
            selectAllCheckbox.indeterminate = true;
        }
        
        updateSelectionUI();
    }
    
    // Attach checkbox events
    function attachCheckboxEvents() {
        var checkboxes = document.querySelectorAll('.file-checkbox');
        checkboxes.forEach(function(cb) {
            cb.onclick = function(e) {
                e.stopPropagation();
                updateSelectAllState();
            };
        });
    }
    
    // Select all files
    function selectAllFiles() {
        var checkboxes = document.querySelectorAll('.file-checkbox');
        var allChecked = document.querySelectorAll('.file-checkbox:checked').length === checkboxes.length;
        
        checkboxes.forEach(function(cb) {
            cb.checked = !allChecked;
        });
        
        updateSelectAllState();
    }
    
    // Delete selected files
    function deleteSelectedFiles() {
        var checkboxes = document.querySelectorAll('.file-checkbox:checked');
        if (checkboxes.length === 0) return;
        
        var files = [];
        checkboxes.forEach(function(cb) {
            files.push(decodeURIComponent(cb.getAttribute('data-name')));
        });
        
        if (!confirm('Are you sure you want to delete ' + files.length + ' file(s)?')) return;
        
        var deletePromises = files.map(function(file) {
            return fetch('/server/<%= s.id %>/file/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ file: file, path: currentPath })
            });
        });
        
        Promise.all(deletePromises)
            .then(function() {
                showToast('Deleted ' + files.length + ' file(s)');
                loadFiles(currentPath);
            })
            .catch(function() {
                showToast('Some files failed to delete', 'error');
                loadFiles(currentPath);
            });
    }

    // Archive selected files
    function archiveSelectedFiles() {
        var checkboxes = document.querySelectorAll('.file-checkbox:checked');
        if (checkboxes.length === 0) return;
        
        var files = [];
        checkboxes.forEach(function(cb) {
            files.push(decodeURIComponent(cb.getAttribute('data-name')));
        });
        
        var archiveName = prompt('Enter archive name:', 'archive.tar.gz');
        if (!archiveName) return;
        
        showToast('Creating archive...', 'success', 5000);
        
        fetch('/server/<%= s.id %>/file/compress', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ 
                files: files, 
                path: currentPath,
                archiveName: archiveName
            })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.error) {
                showToast(data.error, 'error');
            } else {
                showToast('Archive created: ' + archiveName);
                loadFiles(currentPath);
            }
        })
        .catch(function() {
            showToast('Failed to create archive', 'error');
        });
    }

    // Load files from API
let currentPath = ''; // معرف مرة واحدة، قابل للتغيير

function loadFiles(relPath) {
    // relPath يجب أن يكون نسبي فقط
    const url = relPath
        ? `/server/<%= s.id %>/api/files/${relPath}`
        : `/server/<%= s.id %>/api/files/${relPath}`;
    
    fetch(url, { credentials: 'same-origin' })
        .then(r => r.json())
        .then(data => {
            if (data.error) { 
                showToast(data.error, 'error'); 
                return; 
            }
            renderFiles(data.files);
            currentPath = relPath || ''; // تحديث المسار النسبي
            document.getElementById('currentPath').innerText = '/home/container' + (currentPath ? '/' + currentPath : '');
        })
        .catch(err => {
            console.error('Load files error:', err);
            showToast('Failed to load files', 'error');
        });
}

// دخول مجلد
function enterFolder(name) {
    const newPath = currentPath ? currentPath + '/' + name : name;
    loadFiles(newPath);
}

// العودة للخلف
function goBack() {
    if (!currentPath) return;
    const parts = currentPath.split('/');
    parts.pop();
    loadFiles(parts.join('/'));
}



