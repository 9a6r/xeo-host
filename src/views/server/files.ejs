<%- include('../partials/header') %>
<%- include('../partials/server/header') %>



<div id="global-toast" class="fixed top-4 right-4 z-50 flex flex-col gap-2"></div>

<div class="flex flex-col md:flex-row justify-between mb-4 items-start md:items-center gap-3">
    <div class="flex items-center gap-2">
        <button id="btnGoBack" class="w-9 h-9 flex items-center justify-center bg-white/10 hover:bg-white/20 text-white rounded-lg transition">
            <i class="fa-solid fa-arrow-left"></i>
        </button>
        <div class="bg-black/30 border border-white/10 px-4 py-2 rounded-lg">
            <div id="currentPath" class="text-gray-400 text-sm font-mono" dir="auto">/home/container</div>
        </div>
    </div>
    <div class="flex gap-2">
        <button id="btnUpload" class="flex items-center gap-2 bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg font-medium transition text-sm">
            <i class="fa-solid fa-upload"></i>
            <span>Upload</span>
        </button>
        <button id="btnNewFile" class="flex items-center gap-2 bg-green-600 hover:bg-green-500 text-white px-4 py-2 rounded-lg font-medium transition text-sm">
            <i class="fa-solid fa-file-circle-plus"></i>
            <span>New File</span>
        </button>
        <button id="btnNewFolder" class="flex items-center gap-2 bg-purple-600 hover:bg-purple-500 text-white px-4 py-2 rounded-lg font-medium transition text-sm">
            <i class="fa-solid fa-folder-plus"></i>
            <span>New Folder</span>
        </button>
    </div>
</div>

<!-- Drag & Drop Overlay -->
<div id="dropOverlay" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center">
    <div class="text-center p-8 border-2 border-dashed border-blue-500 rounded-3xl bg-blue-500/10">
        <i class="fa-solid fa-cloud-arrow-up text-6xl text-blue-400 mb-4"></i>
        <h3 class="text-2xl font-bold text-white mb-2">Drop files here</h3>
        <p class="text-gray-400">Release to upload files to current directory</p>
    </div>
</div>





<div class="glass rounded-xl overflow-hidden shadow-inner">
    <table class="w-full text-left text-sm">
        <thead class="bg-white/5 text-gray-400 text-xs uppercase">
            <tr>
                <th class="p-3 w-10">
                    <input type="checkbox" id="selectAllCheckbox" class="w-4 h-4 rounded cursor-pointer accent-yellow-500">
                </th>
                <th class="p-3">Name</th>
                <th class="p-3">Size</th>
                <th class="p-3 text-right">Actions</th>
            </tr>
        </thead>
        <tbody id="fileTableBody">
            <% files.forEach(f => { %>
            <tr class="border-b border-white/5 hover:bg-white/5 transition file-row group" data-name="<%= encodeURIComponent(f.name) %>" data-isdir="<%= f.isDir %>">
                <td class="p-3">
                    <input type="checkbox" class="file-checkbox w-4 h-4 rounded cursor-pointer accent-yellow-500" data-name="<%= encodeURIComponent(f.name) %>">
                </td>
                <td class="p-3 cursor-pointer file-name" dir="auto">
                    <% if(f.isDir) { %>
                        <i class="fa-solid fa-folder text-yellow-500 mr-2"></i>
                    <% } else { 
                        const ext = f.name.split('.').pop().toLowerCase();
                        const fileName = f.name.toLowerCase();
                        let icon = 'fa-solid fa-file';
                        let color = 'text-gray-400';
                        
                        // Special files by exact name (check first)
                        if(fileName === 'package.json') { icon = 'fa-brands fa-npm'; color = 'text-red-500'; }
                        else if(fileName === 'package-lock.json' || fileName === 'yarn.lock' || fileName === 'pnpm-lock.yaml' || fileName === 'bun.lockb') { icon = 'fa-solid fa-lock'; color = 'text-yellow-600'; }
                        else if(fileName === 'dockerfile' || fileName.startsWith('dockerfile.')) { icon = 'fa-brands fa-docker'; color = 'text-blue-500'; }
                        else if(fileName === 'docker-compose.yml' || fileName === 'docker-compose.yaml' || fileName === 'compose.yml' || fileName === 'compose.yaml') { icon = 'fa-brands fa-docker'; color = 'text-blue-400'; }
                        else if(fileName === '.dockerignore') { icon = 'fa-brands fa-docker'; color = 'text-gray-500'; }
                        else if(fileName === '.gitignore' || fileName === '.gitattributes' || fileName === '.gitmodules') { icon = 'fa-brands fa-git-alt'; color = 'text-orange-500'; }
                        else if(fileName === '.env' || fileName.startsWith('.env.')) { icon = 'fa-solid fa-key'; color = 'text-green-500'; }
                        else if(fileName === 'license' || fileName === 'license.md' || fileName === 'license.txt') { icon = 'fa-solid fa-scale-balanced'; color = 'text-yellow-400'; }
                        else if(fileName === 'readme.md' || fileName === 'readme.txt' || fileName === 'readme') { icon = 'fa-solid fa-book'; color = 'text-blue-400'; }
                        else if(fileName === 'makefile' || fileName === 'gnumakefile') { icon = 'fa-solid fa-gear'; color = 'text-orange-500'; }
                        else if(fileName === 'cmakelists.txt') { icon = 'fa-solid fa-gear'; color = 'text-blue-500'; }
                        else if(fileName === 'rakefile') { icon = 'fa-solid fa-gem'; color = 'text-red-500'; }
                        else if(fileName === 'gemfile' || fileName === 'gemfile.lock') { icon = 'fa-solid fa-gem'; color = 'text-red-400'; }
                        else if(fileName === 'cargo.toml' || fileName === 'cargo.lock') { icon = 'fa-brands fa-rust'; color = 'text-orange-600'; }
                        else if(fileName === 'go.mod' || fileName === 'go.sum') { icon = 'fa-brands fa-golang'; color = 'text-cyan-500'; }
                        else if(fileName === 'requirements.txt' || fileName === 'pipfile' || fileName === 'pipfile.lock' || fileName === 'pyproject.toml' || fileName === 'setup.py' || fileName === 'setup.cfg') { icon = 'fa-brands fa-python'; color = 'text-yellow-300'; }
                        else if(fileName === 'composer.json' || fileName === 'composer.lock') { icon = 'fa-brands fa-php'; color = 'text-indigo-400'; }
                        else if(fileName === 'tsconfig.json' || fileName === 'jsconfig.json') { icon = 'fa-solid fa-gear'; color = 'text-blue-500'; }
                        else if(fileName === 'webpack.config.js' || fileName === 'webpack.config.ts') { icon = 'fa-solid fa-cube'; color = 'text-blue-400'; }
                        else if(fileName === 'vite.config.js' || fileName === 'vite.config.ts') { icon = 'fa-solid fa-bolt'; color = 'text-purple-500'; }
                        else if(fileName === 'rollup.config.js' || fileName === 'rollup.config.ts') { icon = 'fa-solid fa-cube'; color = 'text-red-500'; }
                        else if(fileName === 'babel.config.js' || fileName === '.babelrc') { icon = 'fa-solid fa-cube'; color = 'text-yellow-500'; }
                        else if(fileName === '.eslintrc' || fileName === '.eslintrc.js' || fileName === '.eslintrc.json' || fileName === 'eslint.config.js') { icon = 'fa-solid fa-spell-check'; color = 'text-purple-500'; }
                        else if(fileName === '.prettierrc' || fileName === '.prettierrc.js' || fileName === '.prettierrc.json' || fileName === 'prettier.config.js') { icon = 'fa-solid fa-wand-magic-sparkles'; color = 'text-pink-400'; }
                        else if(fileName === '.editorconfig') { icon = 'fa-solid fa-sliders'; color = 'text-gray-400'; }
                        else if(fileName === '.htaccess') { icon = 'fa-solid fa-server'; color = 'text-green-600'; }
                        else if(fileName === 'nginx.conf') { icon = 'fa-solid fa-server'; color = 'text-green-500'; }
                        else if(fileName === 'procfile') { icon = 'fa-solid fa-server'; color = 'text-purple-500'; }
                        else if(fileName === 'vercel.json' || fileName === 'now.json') { icon = 'fa-solid fa-triangle'; color = 'text-white'; }
                        else if(fileName === 'netlify.toml') { icon = 'fa-solid fa-globe'; color = 'text-teal-400'; }
                        else if(fileName === '.travis.yml') { icon = 'fa-solid fa-circle-check'; color = 'text-red-400'; }
                        else if(fileName === 'jenkinsfile') { icon = 'fa-solid fa-circle-check'; color = 'text-red-500'; }
                        else if(fileName === '.gitlab-ci.yml') { icon = 'fa-brands fa-gitlab'; color = 'text-orange-500'; }
                        else if(fileName === 'azure-pipelines.yml') { icon = 'fa-brands fa-microsoft'; color = 'text-blue-500'; }
                        else if(fileName === '.github') { icon = 'fa-brands fa-github'; color = 'text-white'; }
                        
                        // JavaScript / TypeScript / Node
                        else if(['js', 'mjs', 'cjs'].includes(ext)) { icon = 'fa-brands fa-js'; color = 'text-yellow-400'; }
                        else if(['ts'].includes(ext)) { icon = 'fa-solid fa-code'; color = 'text-blue-500'; }
                        else if(['tsx'].includes(ext)) { icon = 'fa-brands fa-react'; color = 'text-blue-400'; }
                        else if(['jsx'].includes(ext)) { icon = 'fa-brands fa-react'; color = 'text-cyan-400'; }
                        else if(['vue'].includes(ext)) { icon = 'fa-brands fa-vuejs'; color = 'text-green-500'; }
                        else if(['svelte'].includes(ext)) { icon = 'fa-solid fa-fire'; color = 'text-orange-500'; }
                        else if(['astro'].includes(ext)) { icon = 'fa-solid fa-rocket'; color = 'text-purple-400'; }
                        
                        // Web
                        else if(['html', 'htm', 'xhtml'].includes(ext)) { icon = 'fa-brands fa-html5'; color = 'text-orange-500'; }
                        else if(['css'].includes(ext)) { icon = 'fa-brands fa-css3-alt'; color = 'text-blue-400'; }
                        else if(['scss', 'sass'].includes(ext)) { icon = 'fa-brands fa-sass'; color = 'text-pink-400'; }
                        else if(['less'].includes(ext)) { icon = 'fa-brands fa-less'; color = 'text-blue-600'; }
                        else if(['styl', 'stylus'].includes(ext)) { icon = 'fa-solid fa-paintbrush'; color = 'text-green-400'; }
                        
                        // Programming Languages
                        else if(['py', 'pyw', 'pyx', 'pxd', 'pxi'].includes(ext)) { icon = 'fa-brands fa-python'; color = 'text-yellow-300'; }
                        else if(['ipynb'].includes(ext)) { icon = 'fa-solid fa-book-open'; color = 'text-orange-400'; }
                        else if(['java'].includes(ext)) { icon = 'fa-brands fa-java'; color = 'text-red-400'; }
                        else if(['jar', 'war', 'ear'].includes(ext)) { icon = 'fa-brands fa-java'; color = 'text-red-600'; }
                        else if(['class'].includes(ext)) { icon = 'fa-brands fa-java'; color = 'text-red-500'; }
                        else if(['kt', 'kts'].includes(ext)) { icon = 'fa-solid fa-k'; color = 'text-purple-500'; }
                        else if(['scala', 'sc'].includes(ext)) { icon = 'fa-solid fa-s'; color = 'text-red-500'; }
                        else if(['groovy', 'gvy', 'gy', 'gsh'].includes(ext)) { icon = 'fa-solid fa-star'; color = 'text-blue-400'; }
                        else if(['php', 'phtml', 'php3', 'php4', 'php5', 'php7', 'phps'].includes(ext)) { icon = 'fa-brands fa-php'; color = 'text-indigo-400'; }
                        else if(['rb', 'erb', 'rake'].includes(ext)) { icon = 'fa-solid fa-gem'; color = 'text-red-500'; }
                        else if(['go'].includes(ext)) { icon = 'fa-brands fa-golang'; color = 'text-cyan-500'; }
                        else if(['rs'].includes(ext)) { icon = 'fa-brands fa-rust'; color = 'text-orange-600'; }
                        else if(['c'].includes(ext)) { icon = 'fa-solid fa-c'; color = 'text-blue-600'; }
                        else if(['h'].includes(ext)) { icon = 'fa-solid fa-h'; color = 'text-blue-500'; }
                        else if(['cpp', 'cc', 'cxx', 'c++'].includes(ext)) { icon = 'fa-solid fa-c'; color = 'text-blue-500'; }
                        else if(['hpp', 'hh', 'hxx', 'h++'].includes(ext)) { icon = 'fa-solid fa-h'; color = 'text-blue-400'; }
                        else if(['cs'].includes(ext)) { icon = 'fa-solid fa-hashtag'; color = 'text-purple-500'; }
                        else if(['fs', 'fsx', 'fsi'].includes(ext)) { icon = 'fa-solid fa-f'; color = 'text-blue-400'; }
                        else if(['vb', 'vbs'].includes(ext)) { icon = 'fa-solid fa-v'; color = 'text-blue-600'; }
                        else if(['swift'].includes(ext)) { icon = 'fa-brands fa-swift'; color = 'text-orange-500'; }
                        else if(['m', 'mm'].includes(ext)) { icon = 'fa-brands fa-apple'; color = 'text-gray-400'; }
                        else if(['dart'].includes(ext)) { icon = 'fa-solid fa-bullseye'; color = 'text-blue-400'; }
                        else if(['lua'].includes(ext)) { icon = 'fa-solid fa-moon'; color = 'text-blue-500'; }
                        else if(['pl', 'pm', 'pod', 't'].includes(ext)) { icon = 'fa-solid fa-camel'; color = 'text-blue-400'; }
                        else if(['r', 'rdata', 'rds', 'rda'].includes(ext)) { icon = 'fa-brands fa-r-project'; color = 'text-blue-500'; }
                        else if(['jl'].includes(ext)) { icon = 'fa-solid fa-circle-dot'; color = 'text-purple-500'; }
                        else if(['ex', 'exs'].includes(ext)) { icon = 'fa-solid fa-droplet'; color = 'text-purple-400'; }
                        else if(['erl', 'hrl'].includes(ext)) { icon = 'fa-solid fa-e'; color = 'text-red-500'; }
                        else if(['clj', 'cljs', 'cljc', 'edn'].includes(ext)) { icon = 'fa-solid fa-circle'; color = 'text-green-500'; }
                        else if(['hs', 'lhs'].includes(ext)) { icon = 'fa-solid fa-lambda'; color = 'text-purple-500'; }
                        else if(['ml', 'mli'].includes(ext)) { icon = 'fa-solid fa-o'; color = 'text-orange-500'; }
                        else if(['nim'].includes(ext)) { icon = 'fa-solid fa-crown'; color = 'text-yellow-500'; }
                        else if(['zig'].includes(ext)) { icon = 'fa-solid fa-z'; color = 'text-orange-400'; }
                        else if(['v', 'vh'].includes(ext)) { icon = 'fa-solid fa-microchip'; color = 'text-blue-400'; }
                        else if(['vhd', 'vhdl'].includes(ext)) { icon = 'fa-solid fa-microchip'; color = 'text-green-500'; }
                        else if(['asm', 's'].includes(ext)) { icon = 'fa-solid fa-microchip'; color = 'text-yellow-600'; }
                        else if(['wasm', 'wat'].includes(ext)) { icon = 'fa-solid fa-cube'; color = 'text-purple-600'; }
                        else if(['sol'].includes(ext)) { icon = 'fa-brands fa-ethereum'; color = 'text-gray-400'; }
                        else if(['move'].includes(ext)) { icon = 'fa-solid fa-coins'; color = 'text-blue-400'; }
                        
                        // Shell & Scripts
                        else if(['sh', 'bash', 'zsh', 'fish'].includes(ext)) { icon = 'fa-solid fa-terminal'; color = 'text-green-400'; }
                        else if(['bat', 'cmd'].includes(ext)) { icon = 'fa-brands fa-windows'; color = 'text-blue-400'; }
                        else if(['ps1', 'psm1', 'psd1'].includes(ext)) { icon = 'fa-solid fa-terminal'; color = 'text-blue-500'; }
                        else if(['awk'].includes(ext)) { icon = 'fa-solid fa-terminal'; color = 'text-gray-400'; }
                        
                        // Data & Config
                        else if(['json', 'jsonc', 'json5'].includes(ext)) { icon = 'fa-solid fa-brackets-curly'; color = 'text-yellow-500'; }
                        else if(['xml'].includes(ext)) { icon = 'fa-solid fa-code'; color = 'text-orange-400'; }
                        else if(['yaml', 'yml'].includes(ext)) { icon = 'fa-solid fa-file-code'; color = 'text-red-400'; }
                        else if(['toml'].includes(ext)) { icon = 'fa-solid fa-file-code'; color = 'text-gray-500'; }
                        else if(['ini', 'cfg', 'conf', 'config'].includes(ext)) { icon = 'fa-solid fa-gear'; color = 'text-gray-400'; }
                        else if(['properties'].includes(ext)) { icon = 'fa-solid fa-list'; color = 'text-purple-400'; }
                        else if(['env'].includes(ext)) { icon = 'fa-solid fa-key'; color = 'text-green-500'; }
                        else if(['csv'].includes(ext)) { icon = 'fa-solid fa-table'; color = 'text-green-500'; }
                        else if(['tsv'].includes(ext)) { icon = 'fa-solid fa-table'; color = 'text-blue-400'; }
                        else if(['graphql', 'gql'].includes(ext)) { icon = 'fa-solid fa-diagram-project'; color = 'text-pink-500'; }
                        else if(['proto'].includes(ext)) { icon = 'fa-solid fa-diagram-project'; color = 'text-blue-400'; }
                        
                        // Documents
                        else if(['md', 'markdown', 'mdown', 'mkd'].includes(ext)) { icon = 'fa-brands fa-markdown'; color = 'text-white'; }
                        else if(['mdx'].includes(ext)) { icon = 'fa-brands fa-markdown'; color = 'text-yellow-400'; }
                        else if(['txt', 'text'].includes(ext)) { icon = 'fa-solid fa-file-lines'; color = 'text-gray-400'; }
                        else if(['log'].includes(ext)) { icon = 'fa-solid fa-scroll'; color = 'text-gray-500'; }
                        else if(['pdf'].includes(ext)) { icon = 'fa-solid fa-file-pdf'; color = 'text-red-500'; }
                        else if(['doc', 'docx'].includes(ext)) { icon = 'fa-solid fa-file-word'; color = 'text-blue-600'; }
                        else if(['xls', 'xlsx'].includes(ext)) { icon = 'fa-solid fa-file-excel'; color = 'text-green-600'; }
                        else if(['ppt', 'pptx'].includes(ext)) { icon = 'fa-solid fa-file-powerpoint'; color = 'text-orange-500'; }
                        else if(['odt', 'ods', 'odp'].includes(ext)) { icon = 'fa-solid fa-file'; color = 'text-blue-400'; }
                        else if(['rtf'].includes(ext)) { icon = 'fa-solid fa-file-lines'; color = 'text-blue-500'; }
                        else if(['tex', 'latex'].includes(ext)) { icon = 'fa-solid fa-square-root-variable'; color = 'text-green-600'; }
                        else if(['bib'].includes(ext)) { icon = 'fa-solid fa-book'; color = 'text-green-500'; }
                        else if(['rst'].includes(ext)) { icon = 'fa-solid fa-file-lines'; color = 'text-gray-500'; }
                        else if(['adoc', 'asciidoc'].includes(ext)) { icon = 'fa-solid fa-file-lines'; color = 'text-blue-400'; }
                        else if(['org'].includes(ext)) { icon = 'fa-solid fa-sitemap'; color = 'text-teal-500'; }
                        
                        // Images
                        else if(['png'].includes(ext)) { icon = 'fa-solid fa-image'; color = 'text-purple-400'; }
                        else if(['jpg', 'jpeg'].includes(ext)) { icon = 'fa-solid fa-image'; color = 'text-orange-400'; }
                        else if(['gif'].includes(ext)) { icon = 'fa-solid fa-image'; color = 'text-green-400'; }
                        else if(['webp'].includes(ext)) { icon = 'fa-solid fa-image'; color = 'text-blue-400'; }
                        else if(['svg'].includes(ext)) { icon = 'fa-solid fa-bezier-curve'; color = 'text-yellow-500'; }
                        else if(['ico', 'icns'].includes(ext)) { icon = 'fa-solid fa-icons'; color = 'text-blue-500'; }
                        else if(['bmp'].includes(ext)) { icon = 'fa-solid fa-image'; color = 'text-gray-400'; }
                        else if(['tiff', 'tif'].includes(ext)) { icon = 'fa-solid fa-image'; color = 'text-purple-500'; }
                        else if(['psd'].includes(ext)) { icon = 'fa-solid fa-image'; color = 'text-blue-600'; }
                        else if(['ai'].includes(ext)) { icon = 'fa-solid fa-bezier-curve'; color = 'text-orange-600'; }
                        else if(['sketch'].includes(ext)) { icon = 'fa-solid fa-pen-ruler'; color = 'text-yellow-500'; }
                        else if(['fig', 'figma'].includes(ext)) { icon = 'fa-brands fa-figma'; color = 'text-purple-500'; }
                        else if(['xd'].includes(ext)) { icon = 'fa-solid fa-pen-ruler'; color = 'text-pink-500'; }
                        else if(['raw', 'cr2', 'nef', 'arw'].includes(ext)) { icon = 'fa-solid fa-camera'; color = 'text-gray-500'; }
                        
