                        else if(['wav'].includes(ext)) { icon = 'fa-solid fa-file-audio'; color = 'text-blue-400'; }
                        else if(['ogg', 'oga'].includes(ext)) { icon = 'fa-solid fa-file-audio'; color = 'text-orange-400'; }
                        else if(['flac'].includes(ext)) { icon = 'fa-solid fa-file-audio'; color = 'text-yellow-500'; }
