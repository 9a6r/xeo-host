                        else if(['pgsql'].includes(ext)) { icon = 'fa-solid fa-database'; color = 'text-blue-600'; }
                        else if(['mysql'].includes(ext)) { icon = 'fa-solid fa-database'; color = 'text-orange-500'; }
                        else if(['mongodb'].includes(ext)) { icon = 'fa-solid fa-database'; color = 'text-green-500'; }
                        else if(['redis'].includes(ext)) { icon = 'fa-solid fa-database'; color = 'text-red-500'; }
                        
                        // 3D & CAD
                        else if(['obj', 'fbx', 'dae', 'gltf', 'glb'].includes(ext)) { icon = 'fa-solid fa-cube'; color = 'text-orange-400'; }
                        else if(['stl'].includes(ext)) { icon = 'fa-solid fa-cube'; color = 'text-gray-400'; }
                        else if(['blend'].includes(ext)) { icon = 'fa-solid fa-cube'; color = 'text-orange-500'; }
                        else if(['max', '3ds'].includes(ext)) { icon = 'fa-solid fa-cube'; color = 'text-blue-500'; }
                        else if(['dwg', 'dxf'].includes(ext)) { icon = 'fa-solid fa-compass-drafting'; color = 'text-red-500'; }
                        
                        // Executables & Binaries
                        else if(['exe'].includes(ext)) { icon = 'fa-brands fa-windows'; color = 'text-blue-500'; }
                        else if(['msi'].includes(ext)) { icon = 'fa-brands fa-windows'; color = 'text-blue-400'; }
                        else if(['dll'].includes(ext)) { icon = 'fa-solid fa-gear'; color = 'text-blue-400'; }
                        else if(['so'].includes(ext)) { icon = 'fa-solid fa-gear'; color = 'text-gray-400'; }
                        else if(['dylib'].includes(ext)) { icon = 'fa-solid fa-gear'; color = 'text-gray-500'; }
                        else if(['app'].includes(ext)) { icon = 'fa-brands fa-apple'; color = 'text-gray-400'; }
                        else if(['bin'].includes(ext)) { icon = 'fa-solid fa-microchip'; color = 'text-gray-500'; }
                        else if(['out'].includes(ext)) { icon = 'fa-solid fa-terminal'; color = 'text-green-400'; }
                        
                        // Certificates & Keys
                        else if(['pem', 'crt', 'cer', 'der'].includes(ext)) { icon = 'fa-solid fa-certificate'; color = 'text-green-500'; }
                        else if(['key'].includes(ext)) { icon = 'fa-solid fa-key'; color = 'text-yellow-500'; }
                        else if(['pub'].includes(ext)) { icon = 'fa-solid fa-key'; color = 'text-green-400'; }
                        else if(['p12', 'pfx'].includes(ext)) { icon = 'fa-solid fa-lock'; color = 'text-blue-500'; }
                        else if(['csr'].includes(ext)) { icon = 'fa-solid fa-file-signature'; color = 'text-blue-400'; }
                        
                        // Other
                        else if(['map'].includes(ext)) { icon = 'fa-solid fa-map'; color = 'text-blue-400'; }
                        else if(['lock'].includes(ext)) { icon = 'fa-solid fa-lock'; color = 'text-yellow-600'; }
                        else if(['pid'].includes(ext)) { icon = 'fa-solid fa-hashtag'; color = 'text-gray-400'; }
                        else if(['tmp', 'temp', 'swp', 'swo'].includes(ext)) { icon = 'fa-solid fa-clock-rotate-left'; color = 'text-gray-500'; }
                        else if(['bak', 'backup', 'old'].includes(ext)) { icon = 'fa-solid fa-box-archive'; color = 'text-gray-500'; }
                        else if(['diff', 'patch'].includes(ext)) { icon = 'fa-solid fa-code-compare'; color = 'text-green-400'; }
                    %>
                        <i class="<%= icon %> <%= color %> mr-2"></i>
                    <% } %>
                    <%= f.name %>
                </td>
                <td class="p-3 text-gray-400"><%= (f.size/1024).toFixed(1) %> KB</td>
                <td class="p-3">
                    <div class="flex justify-end items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                        <% if(!f.isDir){ %>
                        <button class="btn-edit w-8 h-8 flex items-center justify-center rounded-lg bg-indigo-500/20 hover:bg-indigo-500 text-indigo-400 hover:text-white transition-all duration-200 hover:scale-110" title="Edit">
                            <i class="fa-solid fa-pen-to-square text-sm"></i>
                        </button>
                        <% if(f.name.endsWith('.zip') || f.name.endsWith('.tar') || f.name.endsWith('.tar.gz') || f.name.endsWith('.rar') || f.name.endsWith('.7z')) { %>
                        <button class="btn-unarchive w-8 h-8 flex items-center justify-center rounded-lg bg-emerald-500/20 hover:bg-emerald-500 text-emerald-400 hover:text-white transition-all duration-200 hover:scale-110" title="Extract">
                            <i class="fa-solid fa-box-open text-sm"></i>
                        </button>
                        <% } %>
                        <% } %>
                        <button class="btn-rename w-8 h-8 flex items-center justify-center rounded-lg bg-orange-500/20 hover:bg-orange-500 text-orange-400 hover:text-white transition-all duration-200 hover:scale-110" title="Rename">
                            <i class="fa-solid fa-i-cursor text-sm"></i>
                        </button>
                        <button class="btn-delete w-8 h-8 flex items-center justify-center rounded-lg bg-red-500/20 hover:bg-red-500 text-red-400 hover:text-white transition-all duration-200 hover:scale-110" title="Delete">
                            <i class="fa-solid fa-trash-can text-sm"></i>
                        </button>
                    </div>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>


