                        else if(['7z'].includes(ext)) { icon = 'fa-solid fa-file-zipper'; color = 'text-green-500'; }
                        else if(['tar'].includes(ext)) { icon = 'fa-solid fa-file-zipper'; color = 'text-orange-500'; }
                        else if(['gz', 'gzip'].includes(ext)) { icon = 'fa-solid fa-file-zipper'; color = 'text-red-400'; }
                        else if(['tgz'].includes(ext)) { icon = 'fa-solid fa-file-zipper'; color = 'text-orange-400'; }
                        else if(['bz2', 'bzip2'].includes(ext)) { icon = 'fa-solid fa-file-zipper'; color = 'text-yellow-500'; }
                        else if(['xz'].includes(ext)) { icon = 'fa-solid fa-file-zipper'; color = 'text-blue-500'; }
                        else if(['lz', 'lzma'].includes(ext)) { icon = 'fa-solid fa-file-zipper'; color = 'text-gray-500'; }
                        else if(['zst', 'zstd'].includes(ext)) { icon = 'fa-solid fa-file-zipper'; color = 'text-green-400'; }
