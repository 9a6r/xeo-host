    // Fetch file content for editing
    function fetchContent(f) {
        curFile = f;
        document.getElementById('edTitle').innerText = f;
        
        // Update file icon in editor
        var iconData = getFileIcon(f.toLowerCase(), f.split('.').pop().toLowerCase());
        document.getElementById('edFileIcon').className = iconData.icon + ' ' + iconData.color;
        
        // Update language display
        var lang = getLanguage(f);
        document.getElementById('edLanguage').innerHTML = '<i class="fa-solid fa-code"></i> <span>' + lang.charAt(0).toUpperCase() + lang.slice(1) + '</span>';

        fetch('/server/<%= s.id %>/file/read', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ 
                path: currentPath,
                file: f
            })
        })
        .then(r => {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.text();
        })
        .then(t => {
            originalContent = t;
            isModified = false;
            document.getElementById('edModified').classList.add('hidden');
            
            // Update file size
            var size = new Blob([t]).size;
            document.getElementById('edFileSize').innerText = formatFileSize(size);
            
            if (editor) {
                var lang = getLanguage(f);
                monaco.editor.setModelLanguage(editor.getModel(), lang);
                editor.setValue(t);
                document.getElementById('edModal').classList.remove('hidden');
                setTimeout(() => editor.layout(), 100);
            }
        })
        .catch(err => { 
            console.error('Fetch error:', err);
            showToast('Failed to load file', 'error'); 
        });
    }
    
    // Format file size
    function formatFileSize(bytes) {
        if (bytes < 1024) return bytes + ' bytes';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    // Save file
    function saveFile() {
        if (!editor) return;
        
        var content = editor.getValue();
        
        fetch('/server/<%= s.id %>/file/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ file: curFile, content: content, path: currentPath })
        })
        .then(function(r) { return r.json(); })
        .then(function() {
            showToast('Saved!');
            originalContent = content;
            isModified = false;
            document.getElementById('edModified').classList.add('hidden');
        })
        .catch(function() { showToast('Failed to save', 'error'); });
    }
    
    // Close editor
    function closeEditor() {
        if (isModified) {
            if (!confirm('You have unsaved changes. Are you sure you want to close?')) {
                return;
            }
        }
        document.getElementById('edModal').classList.add('hidden');
    }
    
    // Format code
    function formatCode() {
        if (editor) {
            editor.getAction('editor.action.formatDocument').run();
        }
    }

    // Open rename modal
    function openRenameModal(oldName) {
        var modal = document.getElementById('renameModal');
        var input = document.getElementById('renameInput');
        modal.classList.remove('hidden');
        input.value = oldName;
        input.focus();
        
        document.getElementById('renameConfirm').onclick = function() {
            var n = input.value.trim();
            if (n && n !== oldName) {
                fetch('/server/<%= s.id %>/file/rename', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ oldName: oldName, newName: n, path: currentPath })
                })
                .then(function() {
                    showToast('Renamed ' + oldName + ' to ' + n);
                    loadFiles(currentPath);
                })
                .catch(function() { showToast('Rename failed', 'error'); });
            }
            modal.classList.add('hidden');
        };
    }

    // Open delete modal
    function openDeleteModal(name, isDir) {
        var modal = document.getElementById('deleteModal');
        document.getElementById('deleteText').innerText = 'Delete "' + name + '"?';
        modal.classList.remove('hidden');
        
        document.getElementById('deleteConfirm').onclick = function() {
            fetch('/server/<%= s.id %>/file/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ file: name, path:  currentPath })
            })
            .then(function() {
                showToast('Deleted ' + name);
                loadFiles(currentPath);
            })
            .catch(function() { showToast('Delete failed', 'error'); });
            modal.classList.add('hidden');
        };
    }

    // Attach events to file rows
    function attachRowEvents() {
        var rows = document.querySelectorAll('.file-row');
        rows.forEach(function(row) {
            var name = decodeURIComponent(row.getAttribute('data-name'));
            var isDir = row.getAttribute('data-isdir') === 'true';
            
            // Click on file name
            var nameCell = row.querySelector('.file-name');
            if (nameCell) {
                nameCell.onclick = function() {
                    if (isDir) {
                        enterFolder(name);
                    } else {
                        fetchContent(name);
                    }
                };
            }
            
            // Edit button
            var editBtn = row.querySelector('.btn-edit');
            if (editBtn) {
                editBtn.onclick = function(e) {
                    e.stopPropagation();
                    fetchContent(name);
                };
            }
            
            // Rename button
            var renameBtn = row.querySelector('.btn-rename');
            if (renameBtn) {
                renameBtn.onclick = function(e) {
                    e.stopPropagation();
                    openRenameModal(name);
                };
            }
            
            // Delete button
            var deleteBtn = row.querySelector('.btn-delete');
            if (deleteBtn) {
                deleteBtn.onclick = function(e) {
                    e.stopPropagation();
                    openDeleteModal(name, isDir);
                };
            }
            
            // Unarchive button
            var unarchiveBtn = row.querySelector('.btn-unarchive');
            if (unarchiveBtn) {
                unarchiveBtn.onclick = function(e) {
                    e.stopPropagation();
                    unarchiveFile(name);
                };
            }
        });
    }
    
    // Unarchive file function
    function unarchiveFile(fileName) {
        if (!confirm('Are you sure you want to extract "' + fileName + '"?')) return;
        
        showToast('Extracting...', 'success', 2000);
        
        fetch('/server/<%= s.id %>/file/unarchive', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ file: fileName, path: currentPath })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.ok) {
                showToast('Extracted successfully!');
                loadFiles(currentPath);
            } else {
                showToast(data.error || 'Failed to extract', 'error');
            }
        })
        .catch(function(err) {
            showToast('Failed to extract: ' + err.message, 'error');
        });
    }

    // Initialize when DOM is ready
    function init() {
        // Initialize Monaco Editor
        require(['vs/editor/editor.main'], function() {
            // Define custom dark theme
            monaco.editor.defineTheme('xeo-dark', {
                base: 'vs-dark',
                inherit: true,
                rules: [
                    { token: 'comment', foreground: '6A9955' },
                    { token: 'keyword', foreground: 'C586C0' },
                    { token: 'string', foreground: 'CE9178' },
                    { token: 'number', foreground: 'B5CEA8' },
                    { token: 'type', foreground: '4EC9B0' },
                ],
                colors: {
                    'editor.background': '#1e1e1e',
                    'editor.foreground': '#d4d4d4',
                    'editor.lineHighlightBackground': '#2d2d2d',
                    'editorLineNumber.foreground': '#858585',
                    'editorLineNumber.activeForeground': '#c6c6c6',
                    'editor.selectionBackground': '#264f78',
                    'editor.inactiveSelectionBackground': '#3a3d41',
                    'editorCursor.foreground': '#aeafad',
                    'editorWhitespace.foreground': '#3b3b3b'
                }
            });
            
            editor = monaco.editor.create(document.getElementById('editorContainer'), {
                value: '',
                language: 'javascript',
                theme: 'xeo-dark',
                fontSize: 14,
                fontFamily: "'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace",
                fontLigatures: true,
                lineNumbers: 'on',
                wordWrap: 'on',
                minimap: { enabled: false },
                scrollBeyondLastLine: false,
                automaticLayout: true,
                tabSize: 2,
                insertSpaces: true,
                renderWhitespace: 'selection',
                bracketPairColorization: { enabled: true },
                guides: {
                    bracketPairs: true,
                    indentation: true
                },
                smoothScrolling: true,
                cursorBlinking: 'smooth',
                cursorSmoothCaretAnimation: 'on',
                padding: { top: 10, bottom: 10 },
                suggest: {
                    showKeywords: true,
                    showSnippets: true
                },
                quickSuggestions: true,
                parameterHints: { enabled: true },
                folding: true,
                foldingHighlight: true,
                showFoldingControls: 'mouseover',
                matchBrackets: 'always',
                renderLineHighlight: 'all',
                scrollbar: {
                    verticalScrollbarSize: 10,
                    horizontalScrollbarSize: 10
                }
            });
            
            // Track content changes
            editor.onDidChangeModelContent(function() {
                var currentContent = editor.getValue();
                isModified = currentContent !== originalContent;
                if (isModified) {
                    document.getElementById('edModified').classList.remove('hidden');
                } else {
                    document.getElementById('edModified').classList.add('hidden');
                }
            });
            
            // Track cursor position
            editor.onDidChangeCursorPosition(function(e) {
                document.getElementById('edCursor').innerText = 'Ln ' + e.position.lineNumber + ', Col ' + e.position.column;
            });
            
            // Track selection
            editor.onDidChangeCursorSelection(function(e) {
                var selection = editor.getSelection();
                var selectedText = editor.getModel().getValueInRange(selection);
                if (selectedText.length > 0) {
                    document.getElementById('edSelection').classList.remove('hidden');
                    document.getElementById('edSelection').innerText = 'Selected: ' + selectedText.length;
                } else {
                    document.getElementById('edSelection').classList.add('hidden');
                }
            });
            
            // Keyboard shortcuts
            editor.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.KeyS, function() {
                saveFile();
            });
            
            // Font size change
            document.getElementById('edFontSize').onchange = function() {
                editor.updateOptions({ fontSize: parseInt(this.value) });
            };
            
            // Word wrap toggle
            document.getElementById('edWordWrap').onchange = function() {
                editor.updateOptions({ wordWrap: this.checked ? 'on' : 'off' });
            };
            
            // Minimap toggle
            document.getElementById('edMinimap').onchange = function() {
                editor.updateOptions({ minimap: { enabled: this.checked } });
            };
        });

        // Button events
        document.getElementById('btnGoBack').onclick = goBack;
        document.getElementById('btnUpload').onclick = function() {
            document.getElementById('uploadPath').value = currentPath;
            document.getElementById('upModal').classList.remove('hidden');
        };
        document.getElementById('btnNewFile').onclick = openCreateFileModal;
        document.getElementById('btnNewFolder').onclick = openCreateFolderModal;
        
        // Select All button
        var selectAllCb = document.getElementById('selectAllCheckbox');
        if (selectAllCb) {
            selectAllCb.onclick = selectAllFiles;
        }
        
        // Delete Selected button
        document.getElementById('btnDeleteSelected').onclick = deleteSelectedFiles;
        
        // Archive Selected button
        document.getElementById('btnArchiveSelected').onclick = archiveSelectedFiles;
        
        // Editor buttons
        document.getElementById('btnSaveFile').onclick = saveFile;
        document.getElementById('btnCloseEditor').onclick = closeEditor;
        document.getElementById('btnFormat').onclick = formatCode;
        
        // Escape key to close editor
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && !document.getElementById('edModal').classList.contains('hidden')) {
                closeEditor();
            }
        });

        // Create File Modal events
        document.getElementById('createFileConfirm').onclick = function() {
            var name = document.getElementById('newFileName').value.trim();
            if (name) createFile(name);
        };
        document.getElementById('createFileCancel').onclick = function() {
            document.getElementById('createFileModal').classList.add('hidden');
        };
        document.getElementById('newFileName').onkeypress = function(e) {
            if (e.key === 'Enter') {
                var name = this.value.trim();
                if (name) createFile(name);
            }
        };

        // Create Folder Modal events
        document.getElementById('createFolderConfirm').onclick = function() {
            var name = document.getElementById('newFolderName').value.trim();
            if (name) createFolder(name);
        };
        document.getElementById('createFolderCancel').onclick = function() {
            document.getElementById('createFolderModal').classList.add('hidden');
        };
        document.getElementById('newFolderName').onkeypress = function(e) {
            if (e.key === 'Enter') {
                var name = this.value.trim();
                if (name) createFolder(name);
            }
        };

        // Upload form
        var uploadForm = document.getElementById('uploadForm');
        if (uploadForm) {
            uploadForm.onsubmit = function(e) {
                e.preventDefault();
                var data = new FormData(this);
                data.append('path', currentPath);
                
                fetch(this.action, { method: 'POST', body: data })
                    .then(function(res) {
                        if (!res.ok) throw new Error('Upload failed');
                        return res.text();
                    })
                    .then(function() {
                        showToast('Uploaded!');
                        loadFiles(currentPath);
                        document.getElementById('upModal').classList.add('hidden');
                    })
                    .catch(function() { showToast('Upload failed', 'error'); });
            };
        }

        // Cancel buttons for modals
        var cancelUpload = document.querySelector('#upModal button[type="button"]');
        if (cancelUpload) {
            cancelUpload.onclick = function() {
                document.getElementById('upModal').classList.add('hidden');
            };
        }

        var cancelRename = document.querySelector('#renameModal .bg-gray-700');
        if (cancelRename) {
            cancelRename.onclick = function() {
                document.getElementById('renameModal').classList.add('hidden');
            };
        }

        var cancelDelete = document.querySelector('#deleteModal .bg-gray-700');
        if (cancelDelete) {
            cancelDelete.onclick = function() {
                document.getElementById('deleteModal').classList.add('hidden');
            };
        }

        // Attach events to initial file rows
        attachRowEvents();
        attachCheckboxEvents();
        updateSelectAllState();
        
    }

    // Run init when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    // ========== DRAG & DROP UPLOAD ==========
    var dropOverlay = document.getElementById('dropOverlay');
    var dragCounter = 0;

    // Prevent default drag behaviors on window
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(function(eventName) {
        document.body.addEventListener(eventName, function(e) {
            e.preventDefault();
            e.stopPropagation();
        });
    });

    // Show overlay when dragging files over the page
    document.body.addEventListener('dragenter', function(e) {
        dragCounter++;
        if (e.dataTransfer.types.includes('Files')) {
            dropOverlay.classList.remove('hidden');
        }
    });

    document.body.addEventListener('dragleave', function(e) {
        dragCounter--;
        if (dragCounter === 0) {
            dropOverlay.classList.add('hidden');
        }
    });

    // Handle drop on overlay
    dropOverlay.addEventListener('drop', function(e) {
        dragCounter = 0;
        dropOverlay.classList.add('hidden');
        
        var files = e.dataTransfer.files;
        if (files.length > 0) {
            uploadFilesDirectly(files);
        }
    });

    // Upload files directly via drag & drop
    function uploadFilesDirectly(files) {
        var totalFiles = files.length;
        var uploadedCount = 0;
        var failedCount = 0;

        showToast('Uploading ' + totalFiles + ' file(s)...', 'info');

        for (var i = 0; i < files.length; i++) {
            (function(file) {
                var formData = new FormData();
                formData.append('file', file);
                formData.append('path', currentPath);

                fetch('/server/<%= s.id %>/file/upload', {
                    method: 'POST',
                    body: formData
                })
                .then(function(response) {
                    if (response.ok) {
                        uploadedCount++;
                    } else {
                        failedCount++;
                    }
                    checkComplete();
                })
                .catch(function() {
                    failedCount++;
                    checkComplete();
                });
            })(files[i]);
        }

        function checkComplete() {
            if (uploadedCount + failedCount === totalFiles) {
                if (failedCount === 0) {
                    showToast('Successfully uploaded ' + uploadedCount + ' file(s)', 'success');
                } else {
                    showToast('Uploaded ' + uploadedCount + ', failed ' + failedCount, 'warning');
                }
                loadFiles(currentPath);
            }
        }
    }

    // ========== MODAL DROP ZONE & FILE PREVIEW ==========
    var modalDropZone = document.getElementById('modalDropZone');
    var fileInput = document.getElementById('fileInput');
    var selectedFilesDiv = document.getElementById('selectedFiles');

    if (modalDropZone) {
        ['dragenter', 'dragover'].forEach(function(eventName) {
            modalDropZone.addEventListener(eventName, function() {
                modalDropZone.classList.add('border-blue-500', 'bg-blue-500/10');
            });
        });

        ['dragleave', 'drop'].forEach(function(eventName) {
            modalDropZone.addEventListener(eventName, function() {
                modalDropZone.classList.remove('border-blue-500', 'bg-blue-500/10');
            });
        });
    }

    if (fileInput) {
        fileInput.addEventListener('change', function() {
            updateFilePreview(this.files);
        });
    }

    function updateFilePreview(files) {
        if (!selectedFilesDiv) return;
        
        if (files.length === 0) {
            selectedFilesDiv.classList.add('hidden');
            selectedFilesDiv.innerHTML = '';
            return;
        }

        selectedFilesDiv.classList.remove('hidden');
        var html = '';
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var size = (file.size / 1024).toFixed(1);
            var icon = getFileIconSimple(file.name);
            html += '<div class="flex items-center gap-2 bg-white/5 px-3 py-2 rounded-lg">';
            html += '<i class="' + icon + ' text-sm"></i>';
            html += '<span class="text-sm text-gray-300 flex-1 truncate">' + escapeHtml(file.name) + '</span>';
            html += '<span class="text-xs text-gray-500">' + size + ' KB</span>';
            html += '</div>';
        }
        selectedFilesDiv.innerHTML = html;
    }

    function getFileIconSimple(name) {
        var ext = name.split('.').pop().toLowerCase();
        if (['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg'].includes(ext)) return 'fa-solid fa-image text-green-400';
        if (['mp4', 'webm', 'mov', 'avi'].includes(ext)) return 'fa-solid fa-video text-purple-400';
        if (['mp3', 'wav', 'ogg', 'flac'].includes(ext)) return 'fa-solid fa-music text-pink-400';
        if (['zip', 'rar', '7z', 'tar', 'gz'].includes(ext)) return 'fa-solid fa-file-zipper text-yellow-400';
        if (['pdf'].includes(ext)) return 'fa-solid fa-file-pdf text-red-400';
        if (['doc', 'docx'].includes(ext)) return 'fa-solid fa-file-word text-blue-400';
        if (['js', 'ts', 'jsx', 'tsx'].includes(ext)) return 'fa-brands fa-js text-yellow-400';
        if (['py'].includes(ext)) return 'fa-brands fa-python text-blue-300';
        if (['html', 'htm'].includes(ext)) return 'fa-brands fa-html5 text-orange-400';
        if (['css', 'scss', 'sass'].includes(ext)) return 'fa-brands fa-css3-alt text-blue-400';
        if (['json', 'xml', 'yaml', 'yml'].includes(ext)) return 'fa-solid fa-file-code text-gray-400';
        return 'fa-solid fa-file text-gray-400';
    }
})();
</script>

<style>
.glass { background: rgba(255,255,255,0.05); backdrop-filter: blur(8px); }
#editorContainer { height: 100%; }
</style>

