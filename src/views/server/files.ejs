<!-- Monaco Editor -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>
<script>
(function() {
    // Variables
    var editor = null;
    var curFile = '';
    var originalContent = '';
    var isModified = false;
    
    // Monaco Editor configuration
    require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs' } });
    
    // Language mapping
    var languageMap = {
        'js': 'javascript', 'mjs': 'javascript', 'cjs': 'javascript',
        'ts': 'typescript', 'tsx': 'typescript',
        'jsx': 'javascript',
        'json': 'json', 'jsonc': 'json',
        'html': 'html', 'htm': 'html',
        'css': 'css', 'scss': 'scss', 'sass': 'scss', 'less': 'less',
        'xml': 'xml', 'svg': 'xml',
        'md': 'markdown', 'markdown': 'markdown',
        'py': 'python', 'pyw': 'python',
        'java': 'java',
        'c': 'c', 'h': 'c',
        'cpp': 'cpp', 'cc': 'cpp', 'cxx': 'cpp', 'hpp': 'cpp',
        'cs': 'csharp',
        'go': 'go',
        'rs': 'rust',
        'rb': 'ruby',
        'php': 'php',
        'swift': 'swift',
        'kt': 'kotlin', 'kts': 'kotlin',
        'scala': 'scala',
        'sql': 'sql',
        'sh': 'shell', 'bash': 'shell', 'zsh': 'shell',
        'bat': 'bat', 'cmd': 'bat',
        'ps1': 'powershell',
        'yaml': 'yaml', 'yml': 'yaml',
        'toml': 'ini',
        'ini': 'ini', 'cfg': 'ini', 'conf': 'ini',
        'dockerfile': 'dockerfile',
        'lua': 'lua',
        'r': 'r',
        'dart': 'dart',
        'vue': 'html',
        'graphql': 'graphql', 'gql': 'graphql',
        'sol': 'sol'
    };
    
    function getLanguage(filename) {
        var ext = filename.split('.').pop().toLowerCase();
        var name = filename.toLowerCase();
        if (name === 'dockerfile') return 'dockerfile';
        if (name === 'makefile' || name === 'gnumakefile') return 'makefile';
        return languageMap[ext] || 'plaintext';
    }

    // Show toast notification
    function showToast(msg, type, duration) {
        type = type || 'success';
        duration = duration || 3000;
        var container = document.getElementById('global-toast');
        var toast = document.createElement('div');
        toast.innerText = msg;
        toast.className = 'px-4 py-2 rounded shadow text-sm font-bold transition-all ' + (type === 'success' ? 'bg-green-600 text-white' : 'bg-red-600 text-white');
        container.appendChild(toast);
        setTimeout(function() { toast.style.opacity = 0; toast.style.transform = 'translateX(20px)'; }, duration - 500);
        setTimeout(function() { toast.remove(); }, duration);
    }

    // Escape HTML
    function escapeHtml(str) {
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    // Get file icon based on filename and extension
    function getFileIcon(fileName, ext) {
        var icon = 'fa-solid fa-file';
        var color = 'text-gray-400';
        
        // Special files by exact name
        if(fileName === 'package.json') { icon = 'fa-brands fa-npm'; color = 'text-red-500'; }
        else if(['package-lock.json', 'yarn.lock', 'pnpm-lock.yaml', 'bun.lockb'].indexOf(fileName) !== -1) { icon = 'fa-solid fa-lock'; color = 'text-yellow-600'; }
        else if(fileName === 'dockerfile' || fileName.indexOf('dockerfile.') === 0) { icon = 'fa-brands fa-docker'; color = 'text-blue-500'; }
        else if(['docker-compose.yml', 'docker-compose.yaml', 'compose.yml', 'compose.yaml'].indexOf(fileName) !== -1) { icon = 'fa-brands fa-docker'; color = 'text-blue-400'; }
        else if(fileName === '.dockerignore') { icon = 'fa-brands fa-docker'; color = 'text-gray-500'; }
        else if(['.gitignore', '.gitattributes', '.gitmodules'].indexOf(fileName) !== -1) { icon = 'fa-brands fa-git-alt'; color = 'text-orange-500'; }
        else if(fileName === '.env' || fileName.indexOf('.env.') === 0) { icon = 'fa-solid fa-key'; color = 'text-green-500'; }
        else if(['license', 'license.md', 'license.txt'].indexOf(fileName) !== -1) { icon = 'fa-solid fa-scale-balanced'; color = 'text-yellow-400'; }
        else if(['readme.md', 'readme.txt', 'readme'].indexOf(fileName) !== -1) { icon = 'fa-solid fa-book'; color = 'text-blue-400'; }
        else if(['makefile', 'gnumakefile'].indexOf(fileName) !== -1) { icon = 'fa-solid fa-gear'; color = 'text-orange-500'; }
        else if(fileName === 'cmakelists.txt') { icon = 'fa-solid fa-gear'; color = 'text-blue-500'; }
        else if(['cargo.toml', 'cargo.lock'].indexOf(fileName) !== -1) { icon = 'fa-brands fa-rust'; color = 'text-orange-600'; }
        else if(['go.mod', 'go.sum'].indexOf(fileName) !== -1) { icon = 'fa-brands fa-golang'; color = 'text-cyan-500'; }
        else if(['requirements.txt', 'pipfile', 'pyproject.toml', 'setup.py'].indexOf(fileName) !== -1) { icon = 'fa-brands fa-python'; color = 'text-yellow-300'; }
        else if(['composer.json', 'composer.lock'].indexOf(fileName) !== -1) { icon = 'fa-brands fa-php'; color = 'text-indigo-400'; }
        else if(['tsconfig.json', 'jsconfig.json'].indexOf(fileName) !== -1) { icon = 'fa-solid fa-gear'; color = 'text-blue-500'; }
        else if(['webpack.config.js', 'webpack.config.ts'].indexOf(fileName) !== -1) { icon = 'fa-solid fa-cube'; color = 'text-blue-400'; }
        else if(['vite.config.js', 'vite.config.ts'].indexOf(fileName) !== -1) { icon = 'fa-solid fa-bolt'; color = 'text-purple-500'; }
        else if(['.eslintrc', '.eslintrc.js', '.eslintrc.json', 'eslint.config.js'].indexOf(fileName) !== -1) { icon = 'fa-solid fa-spell-check'; color = 'text-purple-500'; }
        else if(['.prettierrc', 'prettier.config.js'].indexOf(fileName) !== -1) { icon = 'fa-solid fa-wand-magic-sparkles'; color = 'text-pink-400'; }
        else if(fileName === '.editorconfig') { icon = 'fa-solid fa-sliders'; color = 'text-gray-400'; }
        else if(fileName === '.htaccess') { icon = 'fa-solid fa-server'; color = 'text-green-600'; }
        else if(fileName === 'nginx.conf') { icon = 'fa-solid fa-server'; color = 'text-green-500'; }
        else if(fileName === 'procfile') { icon = 'fa-solid fa-server'; color = 'text-purple-500'; }
        else if(['vercel.json', 'now.json'].indexOf(fileName) !== -1) { icon = 'fa-solid fa-triangle'; color = 'text-white'; }
        else if(fileName === 'netlify.toml') { icon = 'fa-solid fa-globe'; color = 'text-teal-400'; }
        else if(fileName === '.gitlab-ci.yml') { icon = 'fa-brands fa-gitlab'; color = 'text-orange-500'; }
        
        // JavaScript / TypeScript / Node
        else if(['js', 'mjs', 'cjs'].indexOf(ext) !== -1) { icon = 'fa-brands fa-js'; color = 'text-yellow-400'; }
        else if(['ts'].indexOf(ext) !== -1) { icon = 'fa-solid fa-code'; color = 'text-blue-500'; }
        else if(['tsx'].indexOf(ext) !== -1) { icon = 'fa-brands fa-react'; color = 'text-blue-400'; }
        else if(['jsx'].indexOf(ext) !== -1) { icon = 'fa-brands fa-react'; color = 'text-cyan-400'; }
        else if(['vue'].indexOf(ext) !== -1) { icon = 'fa-brands fa-vuejs'; color = 'text-green-500'; }
