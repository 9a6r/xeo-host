<%- include('../partials/header') %>

<%- include('../partials/server/header') %>

<!-- Toast Container -->
<div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2"></div>

<div class="glass p-6 rounded-2xl space-y-6">
    <div>
        <h3 class="font-bold mb-4 text-gray-300"><i class="fa-solid fa-rocket mr-2 text-indigo-400"></i>Boot & Language Configuration</h3>
        <div class="space-y-4">
            <div>
                <label class="text-xs text-gray-400 uppercase font-bold">Quick Runtime Preset (اختيار سريع للغة)</label>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-2">
                    <button type="button" onclick="setPreset('index.js')" class="p-3 rounded-xl bg-black/40 border border-white/10 hover:border-green-500 text-left transition flex items-center gap-3">
                        <i class="fa-brands fa-node-js text-2xl text-green-500"></i>
                        <div>
                            <div class="font-bold text-white text-sm">Node.js</div>
                            <div class="text-xs text-gray-400">index.js</div>
                        </div>
                    </button>
                    <button type="button" onclick="setPreset('main.py')" class="p-3 rounded-xl bg-black/40 border border-white/10 hover:border-yellow-400 text-left transition flex items-center gap-3">
                        <i class="fa-brands fa-python text-2xl text-yellow-400"></i>
                        <div>
                            <div class="font-bold text-white text-sm">Python 3</div>
                            <div class="text-xs text-gray-400">main.py</div>
                        </div>
                    </button>
                    <button type="button" onclick="setPreset('index.ts')" class="p-3 rounded-xl bg-black/40 border border-white/10 hover:border-blue-400 text-left transition flex items-center gap-3">
                        <i class="fa-solid fa-code text-2xl text-blue-400"></i>
                        <div>
                            <div class="font-bold text-white text-sm">TypeScript</div>
                            <div class="text-xs text-gray-400">index.ts</div>
                        </div>
                    </button>
                </div>
            </div>

            <div>
                <label class="text-xs text-gray-400 uppercase font-bold">Startup File (ملف التشغيل الرئيسي)</label>
                <input id="startFile" value="<%= s.startup_file %>" placeholder="e.g. index.js or main.py or bot.py" class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white mt-1 focus:border-indigo-500 outline-none transition">
                <p class="text-xs text-gray-500 mt-1">
                    الاستضافة تتعرف تلقائياً على اللغة من امتداد الملف: <code>.js</code> لـ Node.js، أو <code>.py</code> لـ Python (مع تثبيت <code>requirements.txt</code> تلقائياً).
                </p>
            </div>
            <button onclick="saveStartup()" class="bg-indigo-600 w-full py-2.5 rounded-xl font-bold hover:bg-indigo-500 transition">
                <i class="fa-solid fa-save mr-2"></i>Save Configuration
            </button>
        </div>
    </div>

    <div class="border-t border-white/10 pt-6">
        <h3 class="font-bold mb-4 text-gray-300"><i class="fa-brands fa-npm mr-2 text-red-500"></i>Node.js (NPM) Package Manager</h3>
        <div class="flex gap-2">
            <input id="npmPkgName" placeholder="Package name (e.g. discord.js axios express)" class="flex-1 bg-black/40 border border-white/10 rounded-xl p-3 text-white focus:border-green-500 outline-none transition">
            <button id="installNpmBtn" onclick="installPkg('npm')" class="bg-green-600 px-6 rounded-xl font-bold hover:bg-green-500 transition flex items-center gap-2">
                <i class="fa-solid fa-download"></i>
                <span>Install NPM</span>
            </button>
        </div>
    </div>

    <div class="border-t border-white/10 pt-6">
        <h3 class="font-bold mb-4 text-gray-300"><i class="fa-brands fa-python mr-2 text-yellow-400"></i>Python (PIP) Package Manager</h3>
        <div class="flex gap-2">
            <input id="pipPkgName" placeholder="Package name (e.g. discord.py py-cord pyTelegramBotAPI aiohttp)" class="flex-1 bg-black/40 border border-white/10 rounded-xl p-3 text-white focus:border-yellow-400 outline-none transition">
            <button id="installPipBtn" onclick="installPkg('pip')" class="bg-yellow-600 px-6 rounded-xl font-bold hover:bg-yellow-500 transition flex items-center gap-2">
                <i class="fa-solid fa-download"></i>
                <span>Install PIP</span>
            </button>
        </div>
        <p class="text-xs text-gray-500 mt-2">
            <i class="fa-solid fa-info-circle mr-1"></i>
            تُثبت مكاتب بايثون داخل بيئة معزولة (<code>.venv</code>) خاصة بالسيرفر وتُحفظ في <code>requirements.txt</code>. تابع التقدم من شاشة الـ Console.
        </p>
    </div>
</div>

<script>
function setPreset(filename) {
    document.getElementById('startFile').value = filename;
    saveStartup();
}

function showToast(message, type) {
    type = type || 'success';
    var container = document.getElementById('toast-container');
    var toast = document.createElement('div');
    toast.className = 'px-4 py-3 rounded-xl shadow-lg text-sm font-medium flex items-center gap-2 transition-all transform translate-x-0 ' + 
        (type === 'success' ? 'bg-green-600 text-white' : type === 'error' ? 'bg-red-600 text-white' : 'bg-blue-600 text-white');
    
    var icon = type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-times-circle' : 'fa-info-circle';
    toast.innerHTML = '<i class="fa-solid ' + icon + '"></i>' + message;
    
    container.appendChild(toast);
    
    setTimeout(function() {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(20px)';
    }, 2500);
    
    setTimeout(function() {
        toast.remove();
    }, 3000);
}

function saveStartup() {
    var startFile = document.getElementById('startFile').value;
    
    fetch('/server/<%= s.id %>/startup/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ startup_file: startFile })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
        if (data.ok) {
            showToast('Configuration saved! (' + startFile + ')', 'success');
        } else {
            showToast('Failed to save', 'error');
        }
    })
    .catch(function() {
        showToast('Failed to save', 'error');
    });
}

function installPkg(manager) {
    var inputId = manager === 'pip' ? 'pipPkgName' : 'npmPkgName';
    var btnId = manager === 'pip' ? 'installPipBtn' : 'installNpmBtn';
    var pkgInput = document.getElementById(inputId);
    var pkg = pkgInput.value.trim();
    var btn = document.getElementById(btnId);
    
    if (!pkg) {
        showToast('Please enter a package name', 'error');
        return;
    }
    
    btn.disabled = true;
    var oldHtml = btn.innerHTML;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>Installing...</span>';
    
    fetch('/server/<%= s.id %>/startup/install', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ pkg: pkg, manager: manager })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
        if (data.ok) {
            showToast('Installing ' + pkg + ' via ' + manager.toUpperCase() + '... Check console!', 'info');
            pkgInput.value = '';
        } else {
            showToast(data.error || 'Failed to install', 'error');
        }
    })
    .catch(function() {
        showToast('Failed to install package', 'error');
    })
    .finally(function() {
        btn.disabled = false;
        btn.innerHTML = oldHtml;
    });
}
</script>

<%- include('../partials/footer') %>

