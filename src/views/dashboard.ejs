<%- include('partials/header') %>

<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400">
                <i class="fa-solid fa-server mr-3"></i><span id="dashboardTitle">My Servers</span>
            </h2>
            <p class="text-gray-400 mt-1" id="dashboardSubtitle">Manage your active deployments</p>
        </div>
        <div class="flex items-center gap-3">
            <% if(user.isAdmin) { %>
            <!-- Admin Toggle Switch -->
            <div class="flex items-center gap-3 bg-[#1a1a1f] border border-white/5 px-4 py-2.5 rounded-xl">
                <span class="text-gray-400 text-sm">View All Servers</span>
                <button id="adminToggle" onclick="toggleAdminView()" class="relative w-11 h-6 rounded-full transition-colors duration-300 bg-gray-700" role="switch" aria-checked="false">
                    <span id="toggleDot" class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full shadow transition-transform duration-300"></span>
                </button>
            </div>
            <% } %>
            
            <!-- Notification Bell Button -->
            <div class="relative">
                <button onclick="toggleNotifications()" class="notification-bell relative w-11 h-11 bg-[#1a1a1f] hover:bg-[#252530] border border-white/5 text-gray-400 hover:text-white rounded-xl transition-all duration-200 flex items-center justify-center">
                    <i class="fa-solid fa-bell text-lg"></i>
                    <% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
                    <span class="notification-badge absolute -top-1 -right-1 bg-red-500 text-white text-[10px] min-w-[18px] h-[18px] px-1 rounded-full flex items-center justify-center font-bold animate-pulse"><%= announcements.length %></span>
                    <% } %>
                </button>
            
            <!-- Notifications Dropdown - Desktop -->
            <div id="notificationsDropdown" class="hidden md:block opacity-0 invisible absolute right-0 top-full mt-3 w-80 bg-[#0d0d0f] rounded-2xl border border-white/5 shadow-2xl shadow-black/50 z-50 overflow-hidden transition-all duration-200 transform scale-95 origin-top-right">
                <!-- Header -->
                <div class="p-4 border-b border-white/5 flex items-center justify-between bg-[#111114]">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-bell text-gray-400"></i>
                        <span class="text-white font-semibold text-sm">Notifications</span>
                    </div>
                    <% if (typeof announcements !== 'undefined' && announcements.length > 0) { %>
                    <button onclick="markAllAsRead()" class="text-xs text-gray-500 hover:text-white transition">
                        Mark all read
                    </button>
                    <% } %>
                </div>
                
                <!-- Content -->
                <div class="max-h-[320px] overflow-y-auto custom-scrollbar" id="notifications-content">
                    <% if (typeof announcements === 'undefined' || announcements.length === 0) { %>
                    <div class="p-10 text-center">
                        <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-white/5 flex items-center justify-center">
                            <i class="fa-solid fa-bell-slash text-2xl text-gray-600"></i>
                        </div>
                        <p class="text-gray-500 text-sm">No notifications</p>
                        <p class="text-gray-600 text-xs mt-1">You're all caught up!</p>
                    </div>
                    <% } else { %>
                    <div class="divide-y divide-white/5">
                        <% announcements.forEach(announcement => { %>
                        <div class="notification-item p-4 hover:bg-white/[0.02] transition-colors cursor-pointer flex gap-3 group" 
                             data-id="<%= announcement.id %>" 
                             data-type="<%= announcement.type %>"
                             onclick="viewAnnouncement(<%= announcement.id %>)">
                            <!-- Icon -->
                            <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0
                                <%= announcement.type === 'info' ? 'bg-blue-500/10' : '' %>
                                <%= announcement.type === 'success' ? 'bg-green-500/10' : '' %>
                                <%= announcement.type === 'warning' ? 'bg-yellow-500/10' : '' %>
                                <%= announcement.type === 'error' ? 'bg-red-500/10' : '' %>
                                <%= announcement.type === 'update' ? 'bg-purple-500/10' : '' %>
                            ">
                                <% if (announcement.type === 'info') { %>
                                <i class="fa-solid fa-info text-blue-400 text-sm"></i>
                                <% } else if (announcement.type === 'success') { %>
                                <i class="fa-solid fa-check text-green-400 text-sm"></i>
                                <% } else if (announcement.type === 'warning') { %>
                                <i class="fa-solid fa-exclamation text-yellow-400 text-sm"></i>
                                <% } else if (announcement.type === 'error') { %>
                                <i class="fa-solid fa-times text-red-400 text-sm"></i>
                                <% } else if (announcement.type === 'update') { %>
                                <i class="fa-solid fa-rocket text-purple-400 text-sm"></i>
                                <% } else { %>
                                <i class="fa-solid fa-bell text-gray-400 text-sm"></i>
                                <% } %>
                            </div>
                            
                            <!-- Content -->
                            <div class="flex-1 min-w-0">
                                <div class="flex items-start justify-between gap-2">
                                    <p class="text-white text-sm font-medium truncate"><%= announcement.title %></p>
                                    <span class="text-gray-600 text-[10px] whitespace-nowrap"><%= timeAgo(new Date(announcement.created_at)) %></span>
                                </div>
                                <p class="text-gray-500 text-xs mt-1 line-clamp-2"><%= announcement.content ? announcement.content.substring(0, 60) + (announcement.content.length > 60 ? '...' : '') : '' %></p>
                                
