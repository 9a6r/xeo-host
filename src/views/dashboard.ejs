<script src="/socket.io/socket.io.js"></script>
<script>
let adminViewActive = false;
let onlineCount = 0;
let offlineCount = <%= servers.length %>;
let allServersData = [];

// Initialize Socket.IO connection for dashboard
const dashboardSocket = io('/dashboard', {
    query: {
        userId: '<%= user.id %>',
        isAdmin: '<%= user.isAdmin %>'
    }
});

// Connection status
dashboardSocket.on('connect', () => {
    console.log('[Dashboard] Connected to real-time updates');
    updateConnectionStatus(true);
});

dashboardSocket.on('disconnect', () => {
    console.log('[Dashboard] Disconnected from real-time updates');
    updateConnectionStatus(false);
});

// Handle stats updates for user's servers
dashboardSocket.on('statsUpdate', (data) => {
    if (!adminViewActive) {
        updateServerCards(data);
    }
});

// Handle stats updates for all servers (admin)
dashboardSocket.on('allStatsUpdate', (data) => {
    if (adminViewActive) {
        updateServerCards(data);
    }
});

// Update connection status indicator
function updateConnectionStatus(connected) {
    const indicator = document.getElementById('connectionStatus');
    if (indicator) {
        if (connected) {
            indicator.className = 'w-2 h-2 bg-green-500 rounded-full animate-pulse';
            indicator.title = 'Real-time connected';
        } else {
            indicator.className = 'w-2 h-2 bg-red-500 rounded-full';
            indicator.title = 'Disconnected';
        }
    }
}

// Update server cards with new stats
function updateServerCards(data) {
    let online = 0;
    let offline = 0;
    let total = 0;
    
    for (const [serverId, info] of Object.entries(data)) {
        total++;
        const card = document.querySelector(`.server-card[data-server-id="${serverId}"]`);
        if (!card) continue;
        
        const statusEl = card.querySelector('.server-status');
        const cpuPercentEl = card.querySelector('.server-cpu-percent');
        const cpuBarEl = card.querySelector('.server-cpu-bar');
        const ramValueEl = card.querySelector('.server-ram-value');
        const ramBarEl = card.querySelector('.server-ram-bar');
        
        const maxCpu = parseInt(card.dataset.maxCpu) || 50;
        const maxRam = parseInt(card.dataset.maxRam) || 512;
        
        // Update status
        if (statusEl && !statusEl.innerHTML.includes('Suspended')) {
            if (info.running) {
                online++;
                statusEl.className = 'server-status flex items-center gap-1.5 bg-green-500/10 text-green-400 border border-green-500/20 px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase';
                statusEl.innerHTML = '<span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span>Online';
            } else {
                offline++;
                statusEl.className = 'server-status flex items-center gap-1.5 bg-gray-500/10 text-gray-400 border border-gray-500/20 px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase';
                statusEl.innerHTML = '<span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span>Offline';
            }
        } else if (statusEl && statusEl.innerHTML.includes('Suspended')) {
            // Don't count suspended as online/offline
        }
        
        // Update CPU & RAM
        if (info.stats) {
            const cpuPercent = Math.min(parseInt(info.stats.cpu) || 0, 100);
            const ramMB = parseInt(info.stats.ram) || 0;
            const ramPercent = Math.min((ramMB / maxRam) * 100, 100);
            
            if (cpuPercentEl) cpuPercentEl.textContent = cpuPercent + '%';
            if (cpuBarEl) cpuBarEl.style.width = cpuPercent + '%';
            if (ramValueEl) ramValueEl.textContent = ramMB + ' MB';
            if (ramBarEl) ramBarEl.style.width = ramPercent + '%';
        } else {
            if (cpuPercentEl) cpuPercentEl.textContent = '0%';
            if (cpuBarEl) cpuBarEl.style.width = '0%';
            if (ramValueEl) ramValueEl.textContent = '0 MB';
            if (ramBarEl) ramBarEl.style.width = '0%';
        }
    }
    
    // Update stats cards
    document.getElementById('onlineServers').textContent = online;
    document.getElementById('offlineServers').textContent = offline;
}

// Admin View Toggle
function toggleAdminView() {
    adminViewActive = !adminViewActive;
    const btn = document.getElementById('adminToggle');
    const dot = document.getElementById('toggleDot');
    const myServers = document.getElementById('serversContainer');
    const allServers = document.getElementById('allServersContainer');
    const title = document.getElementById('dashboardTitle');
    const subtitle = document.getElementById('dashboardSubtitle');
    
    if (adminViewActive) {
        // Toggle ON
        btn.classList.remove('bg-gray-700');
        btn.classList.add('bg-orange-500');
        dot.style.transform = 'translateX(20px)';
        btn.setAttribute('aria-checked', 'true');
        
        myServers.classList.add('hidden');
        allServers.classList.remove('hidden');
        title.textContent = 'All Servers';
        subtitle.textContent = 'Admin view - All users servers';
        
        // Tell socket to send all servers stats
        dashboardSocket.emit('setViewMode', 'all');
        loadAllServers();
    } else {
        // Toggle OFF
        btn.classList.remove('bg-orange-500');
        btn.classList.add('bg-gray-700');
        dot.style.transform = 'translateX(0)';
        btn.setAttribute('aria-checked', 'false');
        
        myServers.classList.remove('hidden');
        allServers.classList.add('hidden');
        title.textContent = 'My Servers';
        subtitle.textContent = 'Manage your active deployments';
        document.getElementById('totalServers').textContent = '<%= servers.length %>';
        
        // Tell socket to send only user's servers stats
        dashboardSocket.emit('setViewMode', 'user');
    }
}

// Load all servers for admin
function loadAllServers() {
    fetch('/dashboard/api/all-servers')
        .then(res => res.json())
        .then(data => {
            allServersData = data.servers;
            const grid = document.getElementById('allServersGrid');
            const countEl = document.getElementById('allServersCount');
            countEl.textContent = data.servers.length;
            document.getElementById('totalServers').textContent = data.servers.length;
            
            grid.innerHTML = data.servers.map(s => `
                <div class="glass p-5 rounded-2xl relative group hover:border-orange-500/30 border border-transparent transition-all duration-300 flex flex-col server-card" data-server-id="${s.id}" data-max-cpu="${s.cpu || 50}" data-max-ram="${s.ram || 512}">
                    <div class="flex justify-between items-start mb-4">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500/20 to-red-500/20 border border-white/10 flex items-center justify-center">
                            <i class="fa-solid fa-cube text-orange-400 text-lg"></i>
                        </div>
                        <div class="flex items-center gap-2">
                            ${s.isSuspended ? `
                            <span class="server-status flex items-center gap-1.5 bg-red-500/10 text-red-400 border border-red-500/20 px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase">
                                <span class="w-1.5 h-1.5 bg-red-400 rounded-full"></span>
                                Suspended
                            </span>` : `
                            <span class="server-status flex items-center gap-1.5 bg-gray-500/10 text-gray-400 border border-gray-500/20 px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase">
                                <span class="w-1.5 h-1.5 bg-gray-400 rounded-full"></span>
                                Offline
                            </span>`}
                        </div>
                    </div>
                    
                    <h3 class="text-lg font-bold text-white mb-1 truncate">${escapeHtml(s.name)}</h3>
                    <div class="flex items-center gap-2 mb-4">
                        <img src="${s.ownerAvatar ? 'https://cdn.discordapp.com/avatars/' + s.ownerId + '/' + s.ownerAvatar + '.png' : 'https://cdn.discordapp.com/embed/avatars/0.png'}" class="w-5 h-5 rounded-full" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                        <span class="text-gray-500 text-xs">${escapeHtml(s.ownerName || 'Unknown')}</span>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-2 mb-4 mt-auto">
                        <div class="bg-black/30 p-3 rounded-xl">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-[10px] text-gray-500 uppercase font-bold">CPU</span>
                                <span class="server-cpu-percent text-xs font-mono text-orange-400">0%</span>
                            </div>
                            <div class="h-1.5 bg-black/50 rounded-full overflow-hidden">
                                <div class="server-cpu-bar h-full bg-gradient-to-r from-orange-500 to-orange-400 rounded-full transition-all duration-500" style="width: 0%"></div>
                            </div>
                        </div>
                        <div class="bg-black/30 p-3 rounded-xl">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-[10px] text-gray-500 uppercase font-bold">RAM</span>
                                <span class="server-ram-value text-xs font-mono text-red-400">0 MB</span>
                            </div>
                            <div class="h-1.5 bg-black/50 rounded-full overflow-hidden">
                                <div class="server-ram-bar h-full bg-gradient-to-r from-red-500 to-red-400 rounded-full transition-all duration-500" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>

                    <a href="/server/${s.id}" class="block w-full text-center bg-orange-600/20 hover:bg-orange-600 border border-orange-500/30 hover:border-orange-500 py-2.5 rounded-xl font-bold transition text-sm text-orange-400 hover:text-white">
                        <i class="fa-solid fa-terminal mr-2"></i>Manage
                    </a>
                </div>
            `).join('');
            
            // Request stats update for all servers
            dashboardSocket.emit('requestStats');
        })
        .catch(err => console.error('Failed to load all servers:', err));
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Notification Functions
let currentAnnouncementId = null;
const announcementsData = <%- JSON.stringify(typeof announcements !== 'undefined' ? announcements : []) %>;
let notificationsOpen = false;

function toggleNotifications() {
    // Check if mobile
    if (window.innerWidth < 768) {
        openMobileNotifications();
    } else {
        toggleDesktopNotifications();
    }
}

function toggleDesktopNotifications() {
    const dropdown = document.getElementById('notificationsDropdown');
    const overlay = document.getElementById('notificationsOverlay');
    
    if (notificationsOpen) {
        closeNotifications();
    } else {
        dropdown.classList.remove('hidden');
        overlay.classList.remove('hidden');
        // Trigger animation
        setTimeout(() => {
            dropdown.classList.remove('opacity-0', 'invisible', 'scale-95');
            dropdown.classList.add('opacity-100', 'visible', 'scale-100');
        }, 10);
        notificationsOpen = true;
    }
}

function closeNotifications() {
    const dropdown = document.getElementById('notificationsDropdown');
    const overlay = document.getElementById('notificationsOverlay');
    
    dropdown.classList.add('opacity-0', 'invisible', 'scale-95');
    dropdown.classList.remove('opacity-100', 'visible', 'scale-100');
    overlay.classList.add('hidden');
    
    setTimeout(() => {
        dropdown.classList.add('hidden');
    }, 200);
    notificationsOpen = false;
}

function openMobileNotifications() {
    const panel = document.getElementById('mobileNotificationsPanel');
    panel.classList.remove('translate-y-full');
    panel.classList.add('translate-y-0');
    document.body.style.overflow = 'hidden';
    notificationsOpen = true;
}

function closeMobileNotifications() {
    const panel = document.getElementById('mobileNotificationsPanel');
    panel.classList.add('translate-y-full');
    panel.classList.remove('translate-y-0');
    document.body.style.overflow = '';
    notificationsOpen = false;
}

function viewAnnouncement(id) {
    currentAnnouncementId = id;
    const announcement = announcementsData.find(a => a.id === id);
    if (!announcement) return;
    
    document.getElementById('view-announcement-title').textContent = announcement.title;
    document.getElementById('view-announcement-content').textContent = announcement.content;
    document.getElementById('view-announcement-date').textContent = new Date(announcement.created_at).toLocaleString();
    
    // Update icon
    const iconContainer = document.getElementById('view-announcement-icon');
    const typeColors = {
        info: { bg: 'bg-blue-500/20', icon: 'fa-info', color: 'text-blue-400' },
        success: { bg: 'bg-green-500/20', icon: 'fa-check', color: 'text-green-400' },
        warning: { bg: 'bg-yellow-500/20', icon: 'fa-exclamation', color: 'text-yellow-400' },
        error: { bg: 'bg-red-500/20', icon: 'fa-times', color: 'text-red-400' },
        update: { bg: 'bg-purple-500/20', icon: 'fa-rocket', color: 'text-purple-400' }
    };
    const style = typeColors[announcement.type] || typeColors.info;
    iconContainer.className = `w-12 h-12 rounded-full flex items-center justify-center mb-4 ${style.bg}`;
    iconContainer.innerHTML = `<i class="fa-solid ${style.icon} ${style.color} text-xl"></i>`;
    
    document.getElementById('viewAnnouncementModal').classList.remove('hidden');
}

function closeViewAnnouncement() {
    document.getElementById('viewAnnouncementModal').classList.add('hidden');
    currentAnnouncementId = null;
}

function dismissCurrentAnnouncement() {
    if (currentAnnouncementId) {
        dismissAnnouncement(currentAnnouncementId);
        closeViewAnnouncement();
    }
}

function dismissAnnouncement(id) {
    fetch('/dashboard/announcement/' + id + '/read', { method: 'POST' })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // Remove from desktop dropdown
                const desktopEl = document.querySelector(`.notification-item[data-id="${id}"]`);
                if (desktopEl) {
                    desktopEl.style.opacity = '0';
                    desktopEl.style.transform = 'translateX(-20px)';
                    desktopEl.style.transition = 'all 0.3s ease';
                    setTimeout(() => {
                        desktopEl.remove();
                        updateNotificationBadge();
                        checkEmptyNotifications();
                    }, 300);
                }
                
                // Remove from mobile panel
                const mobileEl = document.querySelector(`.mobile-notification-item[data-id="${id}"]`);
                if (mobileEl) {
                    mobileEl.style.opacity = '0';
                    mobileEl.style.transform = 'translateX(-20px)';
                    mobileEl.style.transition = 'all 0.3s ease';
                    setTimeout(() => {
                        mobileEl.remove();
                        updateNotificationBadge();
                        checkEmptyNotifications();
                    }, 300);
                }
            }
        })
        .catch(err => console.error('Failed to dismiss announcement:', err));
}

function markAllAsRead() {
    const desktopItems = document.querySelectorAll('.notification-item');
    const mobileItems = document.querySelectorAll('.mobile-notification-item');
    
    // Send requests
    desktopItems.forEach(item => {
        const id = item.dataset.id;
        fetch('/dashboard/announcement/' + id + '/read', { method: 'POST' });
    });
    
    // Animate desktop items out
    desktopItems.forEach((item, i) => {
        setTimeout(() => {
            item.style.opacity = '0';
            item.style.transform = 'translateX(-20px)';
            item.style.transition = 'all 0.3s ease';
        }, i * 50);
    });
    
    // Animate mobile items out
    mobileItems.forEach((item, i) => {
        setTimeout(() => {
            item.style.opacity = '0';
            item.style.transform = 'translateX(-20px)';
            item.style.transition = 'all 0.3s ease';
        }, i * 50);
    });
    
    setTimeout(() => {
        checkEmptyNotifications();
        updateNotificationBadge();
    }, Math.max(desktopItems.length, mobileItems.length) * 50 + 300);
}

function checkEmptyNotifications() {
    const desktopContent = document.getElementById('notifications-content');
    const mobileContent = document.getElementById('mobile-notifications-content');
    
    const emptyHTML = `
        <div class="p-10 text-center">
            <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-white/5 flex items-center justify-center">
                <i class="fa-solid fa-bell-slash text-2xl text-gray-600"></i>
            </div>
            <p class="text-gray-500 text-sm">No notifications</p>
            <p class="text-gray-600 text-xs mt-1">You're all caught up!</p>
        </div>
    `;
    
    const mobileEmptyHTML = `
        <div class="p-10 text-center mt-10">
            <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-white/5 flex items-center justify-center">
                <i class="fa-solid fa-bell-slash text-3xl text-gray-600"></i>
            </div>
            <p class="text-gray-500">No notifications</p>
            <p class="text-gray-600 text-sm mt-1">You're all caught up!</p>
        </div>
    `;
    
    if (desktopContent && !desktopContent.querySelector('.notification-item')) {
        desktopContent.innerHTML = emptyHTML;
    }
    
    if (mobileContent && !mobileContent.querySelector('.mobile-notification-item')) {
        mobileContent.innerHTML = mobileEmptyHTML;
    }
}

function updateNotificationBadge() {
    const count = document.querySelectorAll('.notification-item').length;
    const badges = document.querySelectorAll('.notification-badge');
    badges.forEach(badge => {
        if (count > 0) {
            badge.textContent = count;
            badge.style.display = 'flex';
        } else {
            badge.style.display = 'none';
        }
    });
}

// Close notifications when pressing Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && notificationsOpen) {
        closeNotifications();
        closeMobileNotifications();
    }
});
</script>

