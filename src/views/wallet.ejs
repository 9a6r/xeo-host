<%- include('partials/header') %>

<div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-8">
        <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">
            <i class="fa-solid fa-wallet mr-3"></i>My Wallet
        </h2>
        <a href="/dashboard" class="text-gray-400 hover:text-white transition">
            <i class="fa-solid fa-arrow-left mr-2"></i>Back to Dashboard
        </a>
    </div>

    <!-- Alert Messages -->
    <% if(message) { %>
    <div class="mb-6 p-4 rounded-xl <%= message.type === 'success' ? 'bg-green-500/20 border border-green-500/30 text-green-400' : 'bg-red-500/20 border border-red-500/30 text-red-400' %>">
        <i class="fa-solid <%= message.type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle' %> mr-2"></i>
        <%= message.text %>
    </div>
    <% } %>

    <!-- Balance Card -->
    <div class="glass p-8 rounded-3xl border border-white/5 mb-8 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-600/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        <div class="relative">
            <div class="text-gray-400 text-sm mb-2">Current Balance</div>
            <div class="text-5xl font-bold text-white mb-4">
                <i class="fa-solid fa-coins text-yellow-400 mr-3"></i>
                <%= user.coins %>
                <span class="text-2xl text-gray-400">coins</span>
            </div>
            <div class="text-sm text-gray-500">
                <i class="fa-solid fa-user mr-2"></i><%= user.username %>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Redeem Code -->
        <div class="glass p-6 rounded-2xl border border-white/5">
            <h3 class="font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-ticket text-green-400"></i>
                Redeem Code
            </h3>
            <form action="/wallet/redeem" method="POST" class="space-y-4">
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">Enter your code</label>
                    <input type="text" name="code" required placeholder="XXXX-XXXX-XXXX-XXXX"
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-4 text-white text-center font-mono text-lg tracking-wider outline-none focus:border-indigo-500 transition uppercase"
                        maxlength="19">
                </div>
                <button class="w-full bg-green-600 hover:bg-green-500 text-white py-4 rounded-xl font-bold transition shadow-lg">
                    <i class="fa-solid fa-gift mr-2"></i>Redeem Code
                </button>
            </form>
            <p class="text-xs text-gray-500 mt-4 text-center">
                <i class="fa-solid fa-info-circle mr-1"></i>
                Enter a valid redeem code to add coins to your wallet
            </p>
        </div>

        <!-- Quick Stats -->
        <div class="glass p-6 rounded-2xl border border-white/5">
            <h3 class="font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-chart-pie text-indigo-400"></i>
                Quick Stats
            </h3>
            <div class="space-y-4">
                <div class="bg-white/5 p-4 rounded-xl flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-green-600/20 rounded-lg flex items-center justify-center">
                            <i class="fa-solid fa-arrow-down text-green-400"></i>
                        </div>
                        <div>
                            <div class="text-white font-bold">Total Received</div>
                            <div class="text-xs text-gray-400">From redeemed codes</div>
                        </div>
                    </div>
                    <div class="text-green-400 font-bold">
                        +<%= transactions.filter(t => t.amount > 0).reduce((a, b) => a + b.amount, 0) %>
                    </div>
                </div>
                <div class="bg-white/5 p-4 rounded-xl flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-red-600/20 rounded-lg flex items-center justify-center">
                            <i class="fa-solid fa-arrow-up text-red-400"></i>
                        </div>
                        <div>
                            <div class="text-white font-bold">Total Spent</div>
                            <div class="text-xs text-gray-400">On servers & services</div>
                        </div>
                    </div>
                    <div class="text-red-400 font-bold">
                        <%= transactions.filter(t => t.amount < 0).reduce((a, b) => a + b.amount, 0) %>
                    </div>
                </div>
                <div class="bg-white/5 p-4 rounded-xl flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-indigo-600/20 rounded-lg flex items-center justify-center">
                            <i class="fa-solid fa-receipt text-indigo-400"></i>
                        </div>
                        <div>
                            <div class="text-white font-bold">Transactions</div>
                            <div class="text-xs text-gray-400">Total count</div>
                        </div>
                    </div>
                    <div class="text-indigo-400 font-bold">
                        <%= transactions.length %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction History -->
    <div class="glass p-6 rounded-2xl border border-white/5 mt-8">
        <h3 class="font-bold text-gray-400 uppercase text-xs mb-4">
            <i class="fa-solid fa-clock-rotate-left mr-2"></i>Transaction History
        </h3>

        <% if(transactions.length === 0) { %>
        <div class="text-center py-12 text-gray-500">
            <i class="fa-solid fa-receipt text-4xl mb-4"></i>
            <p>No transactions yet</p>
            <p class="text-sm mt-2">Redeem a code to get started!</p>
        </div>
        <% } else { %>
        <div class="space-y-3 max-h-[400px] overflow-y-auto custom-scroll">
            <% transactions.forEach(t => { %>
            <div class="bg-white/5 p-4 rounded-xl flex items-center justify-between hover:bg-white/10 transition">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center
                        <%= t.amount >= 0 ? 'bg-green-600/20' : 'bg-red-600/20' %>">
                        <i class="fa-solid <%= t.amount >= 0 ? 'fa-arrow-down text-green-400' : 'fa-arrow-up text-red-400' %>"></i>
                    </div>
                    <div>
                        <div class="text-white font-medium">
                            <%= t.type === 'redeem' ? 'Code Redeemed' : 
                               t.type === 'purchase' ? 'Purchase' : 
                               t.type === 'admin' ? 'Admin Action' : 
                               t.type %>
                        </div>
                        <div class="text-xs text-gray-400"><%= t.description || '-' %></div>
                    </div>
                </div>
                <div class="text-right">
                    <div class="font-bold <%= t.amount >= 0 ? 'text-green-400' : 'text-red-400' %>">
                        <%= t.amount >= 0 ? '+' : '' %><%= t.amount %> coins
                    </div>
                    <div class="text-xs text-gray-500"><%= new Date(t.created_at).toLocaleDateString() %></div>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
