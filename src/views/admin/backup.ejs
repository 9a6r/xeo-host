<%- include('./partials/header') %>

<div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">
        <i class="fa-solid fa-cloud-arrow-up mr-3"></i>Backup Management
    </h2>

    <% 
    const success = typeof locals.success !== 'undefined' ? locals.success : null;
    const error = typeof locals.error !== 'undefined' ? locals.error : null;
    %>

    <!-- Alerts -->
    <% if(success || error) { %>
    <div class="mb-6 p-4 rounded-xl <%= success ? 'bg-green-500/20 border border-green-500/30 text-green-400' : 'bg-red-500/20 border border-red-500/30 text-red-400' %>">
        <i class="fa-solid <%= success ? 'fa-check-circle' : 'fa-exclamation-circle' %> mr-2"></i>
        <% if(success === 'created') { %>Backup created successfully!
        <% } else if(success === 'deleted') { %>Backup deleted successfully!
        <% } else if(success === 'restored') { %>Backup restored successfully! Please restart the server.
        <% } else if(error === 'create_failed') { %>Failed to create backup.
        <% } else if(error === 'delete_failed') { %>Failed to delete backup.
        <% } else if(error === 'restore_failed') { %>Failed to restore backup.
        <% } else if(error === 'not_found') { %>Backup not found.
        <% } %>
    </div>
    <% } %>

    <!-- Create Backup -->
    <div class="glass p-6 rounded-2xl mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-plus-circle text-green-400"></i>
                    Create New Backup
                </h3>
                <p class="text-sm text-gray-400 mt-1">Creates a backup of the database and all server instances</p>
            </div>
            <form action="/admin/backup/create" method="POST">
                <button class="bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-xl font-bold transition shadow-lg">
                    <i class="fa-solid fa-cloud-arrow-up mr-2"></i>Create Backup
                </button>
            </form>
        </div>
    </div>

    <!-- Backups List -->
    <div class="glass p-6 rounded-2xl">
        <h3 class="font-bold text-gray-400 uppercase text-xs mb-4">
            <i class="fa-solid fa-folder-open mr-2"></i>Available Backups (<%= backups.length %>)
        </h3>
        
        <% if(backups.length === 0) { %>
        <div class="text-center py-12 text-gray-500">
            <i class="fa-solid fa-box-open text-4xl mb-4"></i>
            <p>No backups found</p>
            <p class="text-sm mt-2">Create your first backup to get started</p>
        </div>
        <% } else { %>
        <div class="space-y-3 max-h-[500px] overflow-y-auto custom-scroll">
            <% backups.forEach(b => { %>
            <div class="bg-white/5 p-4 rounded-xl flex items-center justify-between hover:bg-white/10 transition border border-white/5">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-indigo-600/20 rounded-xl flex items-center justify-center">
                        <i class="fa-solid fa-file-zipper text-indigo-400 text-xl"></i>
                    </div>
                    <div>
                        <div class="font-bold text-white"><%= b.name %></div>
                        <div class="text-xs text-gray-400 mt-1">
                            <span class="mr-4"><i class="fa-solid fa-calendar mr-1"></i><%= b.date %></span>
                            <span class="mr-4"><i class="fa-solid fa-clock mr-1"></i><%= b.time %></span>
                            <span><i class="fa-solid fa-weight-hanging mr-1"></i><%= b.size %></span>
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <!-- Download -->
                    <a href="/admin/backup/download/<%= b.name %>" 
                        class="bg-blue-600/20 text-blue-400 p-2.5 rounded-lg hover:bg-blue-600 hover:text-white transition" title="Download">
                        <i class="fa-solid fa-download"></i>
                    </a>
                    <!-- Restore -->
                    <form action="/admin/backup/restore" method="POST" class="inline" 
                        onsubmit="return confirm('⚠️ This will overwrite current data with this backup. Continue?')">
                        <input type="hidden" name="name" value="<%= b.name %>">
                        <button class="bg-yellow-600/20 text-yellow-400 p-2.5 rounded-lg hover:bg-yellow-600 hover:text-white transition" title="Restore">
                            <i class="fa-solid fa-rotate-left"></i>
                        </button>
                    </form>
                    <!-- Delete -->
                    <form action="/admin/backup/delete" method="POST" class="inline"
                        onsubmit="return confirm('Delete this backup?')">
                        <input type="hidden" name="name" value="<%= b.name %>">
                        <button class="bg-red-600/20 text-red-400 p-2.5 rounded-lg hover:bg-red-600 hover:text-white transition" title="Delete">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>
    </div>

    <!-- Info -->
    <div class="glass p-4 rounded-xl mt-6 border border-yellow-500/20">
        <div class="flex items-start gap-3">
            <i class="fa-solid fa-info-circle text-yellow-400 mt-0.5"></i>
            <div class="text-sm text-gray-400">
                <p class="font-bold text-yellow-400 mb-1">Backup Information</p>
                <ul class="list-disc list-inside space-y-1">
                    <li>Backups include the database and all server instances</li>
                    <li>Restoring a backup will overwrite current data</li>
                    <li>After restoring, you may need to restart the application</li>
                    <li>Keep backups in a safe location for disaster recovery</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>
