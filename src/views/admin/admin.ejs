<%- include('./partials/header') %>
<div class="max-w-7xl mx-auto">
    <h2 class="text-4xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">Admin Control</h2>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- CONFIG PANEL -->
        <div class="glass p-6 rounded-3xl border border-white/5 space-y-6">
            
            <!-- Active Settings -->
            <div>
                <h3 class="font-bold mb-4 text-gray-400 uppercase text-xs">General Settings</h3>
                <form action="/admin/config" method="POST" class="space-y-4">
                    <div>
                        <label class="text-xs text-gray-500 font-bold ml-1">Site Name</label>
                        <input name="sitename" value="<%= config.sitename %>" class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                    </div>
                    <div>
                        <label class="text-xs text-gray-500 font-bold ml-1">Server Price (Coins)</label>
                        <input type="number" name="price" value="<%= config.price %>" class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                    </div>
                    <button class="bg-indigo-600 w-full py-3 rounded-xl font-bold hover:bg-indigo-500 transition shadow-lg">Save Settings</button>
                </form>
            </div>

            <!-- Coming Soon Section -->
            <div class="relative p-6 rounded-2xl border border-dashed border-white/10 bg-white/5 overflow-hidden">
                <div class="absolute inset-0 bg-black/60 backdrop-blur-[2px] flex flex-col items-center justify-center z-10">
                    <i class="fa-solid fa-rocket text-3xl text-yellow-500 mb-2 animate-bounce"></i>
                    <span class="text-lg font-bold text-white">Coming Soon</span>
                    <span class="text-xs text-gray-400">Automated Payments System</span>
                </div>
                
                <!-- Blurred Dummy Inputs -->
                <div class="opacity-30 blur-sm pointer-events-none select-none">
                    <label class="text-xs font-bold block mb-1">Exchange Rate</label>
                    <input class="w-full bg-black p-2 rounded mb-2" value="1000">
                    <label class="text-xs font-bold block mb-1">ProBot ID</label>
                    <input class="w-full bg-black p-2 rounded" value="2828...">
                </div>
            </div>

        </div>

        <!-- USERS -->
        <div class="lg:col-span-2 glass p-6 rounded-3xl border border-white/5 flex flex-col h-[750px]">
            <h3 class="font-bold mb-4 text-gray-400 uppercase text-xs">Users</h3>
            <div class="overflow-y-auto flex-1 space-y-2 pr-2 custom-scroll">
                <% users.forEach(u => { %>
                <div class="bg-white/5 p-3 rounded-2xl flex justify-between items-center hover:bg-white/10 transition border border-white/5">
                    <div class="flex items-center gap-3">
                        <img src="https://cdn.discordapp.com/avatars/<%= u.id %>/<%= u.avatar %>.png" class="w-10 h-10 rounded-full">
                        <div><div class="font-bold text-sm text-white"><%= u.username %></div><div class="text-[10px] text-yellow-500"><%= u.coins %> Coins</div></div>
                    </div>
                    <button onclick="manage('<%= u.id %>', '<%= u.username %>', <%= u.coins %>, <%= u.isAdmin %>)" class="bg-indigo-600/20 text-indigo-300 px-4 py-2 rounded-xl text-xs font-bold hover:bg-indigo-600 hover:text-white transition">Manage</button>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
    
    <!-- SERVERS -->
    <div class="glass p-6 rounded-3xl border border-white/5 mt-8">
        <h3 class="font-bold mb-4 text-gray-400 uppercase text-xs">Active Servers</h3>
        <div class="overflow-y-auto max-h-96 space-y-2 pr-2 custom-scroll">
            <% servers.forEach(s => { %>
            <div class="bg-white/5 p-3 rounded-2xl flex justify-between items-center hover:bg-white/10 transition border border-white/5">
                <div><div class="font-bold text-sm text-white flex items-center gap-2"><%= s.name %> <% if(s.isSuspended){ %><span class="text-red-500 bg-red-500/10 px-2 rounded text-[10px]">SUSPENDED</span><% } %></div><div class="text-[10px] text-gray-500">ID: <%= s.id %></div></div>
                <form action="/admin/server" method="POST" class="flex gap-2">
                    <input type="hidden" name="id" value="<%= s.id %>">
                    <% if(!s.isSuspended) { %> <button name="action" value="suspend" class="text-orange-400 bg-orange-500/10 p-2 rounded hover:bg-orange-500 hover:text-white transition"><i class="fa-solid fa-pause"></i></button>
                    <% } else { %> <button name="action" value="unsuspend" class="text-green-400 bg-green-500/10 p-2 rounded hover:bg-green-500 hover:text-white transition"><i class="fa-solid fa-play"></i></button> <% } %>
                    <button name="action" value="delete" class="text-red-400 bg-red-500/10 p-2 rounded hover:bg-red-500 hover:text-white transition" onclick="return confirm('Delete?')"><i class="fa-solid fa-trash"></i></button>
                </form>
            </div>
            <% }) %>
        </div>
    </div>
</div>

<!-- Modal -->
<div id="uModal" class="hidden fixed inset-0 bg-black/90 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="glass bg-[#151515] p-8 rounded-3xl w-full max-w-md border border-white/10 shadow-2xl relative">
        <button onclick="document.getElementById('uModal').classList.add('hidden')" class="absolute top-4 right-4 text-gray-500 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
        <h3 class="text-xl font-bold mb-1">Manage User</h3>
        <p id="uDetails" class="text-indigo-400 text-xs font-mono mb-6"></p>
        <form action="/admin/user" method="POST" class="space-y-4">
            <input type="hidden" name="id" id="uId">
            <div class="grid grid-cols-3 gap-2">
                <input name="val" type="number" placeholder="Amt" class="col-span-3 bg-black/50 border border-white/10 p-3 rounded-xl text-white outline-none mb-2">
                <button name="action" value="add" class="bg-green-600/20 text-green-400 hover:bg-green-600 hover:text-white py-2 rounded-lg text-xs font-bold transition">Add</button>
                <button name="action" value="remove" class="bg-red-600/20 text-red-400 hover:bg-red-600 hover:text-white py-2 rounded-lg text-xs font-bold transition">Remove</button>
                <button name="action" value="set" class="bg-blue-600/20 text-blue-400 hover:bg-blue-600 hover:text-white py-2 rounded-lg text-xs font-bold transition">Set</button>
            </div>
            <div class="pt-4 border-t border-white/10" id="roleSection"></div>
            <div class="pt-2 flex gap-2">
                <input name="reason" placeholder="Ban reason..." class="flex-1 bg-black/50 border border-white/10 p-2 rounded-lg text-xs text-white">
                <button name="action" value="ban" class="bg-red-600 text-white px-3 py-2 rounded-lg text-xs font-bold hover:bg-red-500">Ban</button>
                <button name="action" value="unban" class="bg-gray-700 text-white px-3 py-2 rounded-lg text-xs font-bold hover:bg-gray-600">Unban</button>
            </div>
        </form>
    </div>
</div>
<script>
const SUPER_ADMINS = <%- JSON.stringify(superAdmins) %>;
function isSuperAdmin(id) {
    return SUPER_ADMINS.includes(id);
}
function manage(id, name, coins, isAdmin) {
    document.getElementById('uId').value = id;
    document.getElementById('uDetails').innerText = name + ' | ' + coins + ' Coins';
    const rs = document.getElementById('roleSection');
    if(isSuperAdmin(id)) rs.innerHTML = '<div class="text-center text-yellow-500 text-xs font-bold border border-yellow-500/20 py-2 rounded">👑 Super Admin</div>';
    else if(isAdmin) rs.innerHTML = '<button name="action" value="demote" class="w-full bg-orange-600/20 text-orange-400 hover:bg-orange-600 hover:text-white py-3 rounded-xl text-sm font-bold transition">Revoke Admin</button>';
    else rs.innerHTML = '<button name="action" value="promote" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white py-3 rounded-xl text-sm font-bold transition">Make Admin</button>';
    document.getElementById('uModal').classList.remove('hidden');
}
</script>
<%- include('../partials/footer') %>