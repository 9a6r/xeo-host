<%- include('./partials/header') %>

<div class="max-w-7xl mx-auto">
    <h2 class="text-3xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">
        <i class="fa-solid fa-users mr-3"></i>Users Management
    </h2>

    <!-- Search -->
    <div class="glass p-4 rounded-2xl mb-6">
        <div class="relative">
            <i class="fa-solid fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
            <input type="text" id="searchInput" placeholder="Search users..." 
                class="w-full bg-black/40 border border-white/10 rounded-xl pl-12 pr-4 py-3 text-white outline-none focus:border-indigo-500 transition">
        </div>
    </div>

    <!-- Users List -->
    <div class="glass p-6 rounded-2xl">
        <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-gray-400 uppercase text-xs">All Users (<span id="userCount"><%= users.length %></span>)</h3>
        </div>
        <div class="space-y-3 max-h-[600px] overflow-y-auto custom-scroll" id="usersList">
            <% users.forEach(u => { %>
            <div class="user-item bg-white/5 p-4 rounded-xl flex flex-col sm:flex-row justify-between sm:items-center gap-4 hover:bg-white/10 transition border border-white/5" data-username="<%= u.username.toLowerCase() %>">
                <div class="flex items-center gap-4">
                    <img src="https://cdn.discordapp.com/avatars/<%= u.id %>/<%= u.avatar %>.png" class="w-12 h-12 rounded-full" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                    <div>
                        <div class="font-bold text-white flex flex-wrap items-center gap-2">
                            <%= u.username %>
                            <% if(superAdmins.includes(u.id)) { %>
                            <span class="bg-yellow-500/20 text-yellow-400 px-2 py-0.5 rounded text-[10px]">👑 Super Admin</span>
                            <% } else if(u.isAdmin) { %>
                            <span class="bg-indigo-600/20 text-indigo-400 px-2 py-0.5 rounded text-[10px]">Admin</span>
                            <% } %>
                            <% if(u.isBanned) { %>
                                <% if(u.banType === 'ip') { %>
                                <span class="bg-orange-600/30 border border-orange-500/50 text-orange-300 px-2 py-0.5 rounded text-[10px]"><i class="fa-solid fa-network-wired mr-1"></i>IP Banned</span>
                                <% } else { %>
                                <span class="bg-red-500/20 text-red-400 px-2 py-0.5 rounded text-[10px]">Account Banned</span>
                                <% } %>
                            <% } %>
                        </div>
                        <div class="text-xs text-gray-500 flex flex-wrap gap-3 mt-0.5">
                            <span>ID: <%= u.id %></span>
                            <% if(u.lastIp) { %>
                            <span class="text-cyan-400/80"><i class="fa-solid fa-globe mr-1"></i><%= u.lastIp %></span>
                            <% } %>
                        </div>
                        <div class="text-sm text-yellow-500 mt-1"><i class="fa-solid fa-coins mr-1"></i><%= u.coins %> Coins</div>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="manage('<%= u.id %>', '<%= u.username %>', <%= u.coins %>, <%= u.isAdmin %>, <%= u.isBanned %>, '<%= u.banType || 'account' %>')" 
                        class="bg-indigo-600/20 text-indigo-300 px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-indigo-600 hover:text-white transition">
                        <i class="fa-solid fa-pen mr-2"></i>Manage
                    </button>
                    <% if(!superAdmins.includes(u.id)) { %>
                    <form action="/admin/user" method="POST" onsubmit="return confirm('هل أنت متأكد من حذف حساب (<%= u.username %>) وجميع سيرفراته نهائياً؟');">
                        <input type="hidden" name="id" value="<%= u.id %>">
                        <button name="action" value="delete" title="حذف المستخدم نهائياً"
                            class="bg-red-600/20 text-red-400 px-4 py-2.5 rounded-xl text-sm font-bold hover:bg-red-600 hover:text-white transition">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                    <% } %>
                </div>
            </div>
            <% }) %>
        </div>
    </div>
</div>

<!-- Modal -->
<div id="uModal" class="hidden fixed inset-0 bg-black/90 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="glass bg-[#151515] p-8 rounded-3xl w-full max-w-md border border-white/10 shadow-2xl relative max-h-[92vh] overflow-y-auto">
        <button onclick="document.getElementById('uModal').classList.add('hidden')" class="absolute top-4 right-4 text-gray-500 hover:text-white">
            <i class="fa-solid fa-xmark text-xl"></i>
        </button>
        <h3 class="text-xl font-bold mb-1">Manage User</h3>
        <p id="uDetails" class="text-indigo-400 text-sm font-mono mb-6"></p>
        
        <form action="/admin/user" method="POST" class="space-y-4">
            <input type="hidden" name="id" id="uId">
            
            <!-- Coins Management -->
            <div class="bg-white/5 p-4 rounded-xl">
                <label class="text-xs text-gray-400 font-bold mb-2 block">Coins Management</label>
                <input name="val" type="number" placeholder="Amount" 
                    class="w-full bg-black/50 border border-white/10 p-3 rounded-xl text-white outline-none mb-3 focus:border-indigo-500">
                <div class="grid grid-cols-3 gap-2">
                    <button name="action" value="add" class="bg-green-600/20 text-green-400 hover:bg-green-600 hover:text-white py-2.5 rounded-lg text-sm font-bold transition">
                        <i class="fa-solid fa-plus mr-1"></i>Add
                    </button>
                    <button name="action" value="remove" class="bg-red-600/20 text-red-400 hover:bg-red-600 hover:text-white py-2.5 rounded-lg text-sm font-bold transition">
                        <i class="fa-solid fa-minus mr-1"></i>Remove
                    </button>
                    <button name="action" value="set" class="bg-blue-600/20 text-blue-400 hover:bg-blue-600 hover:text-white py-2.5 rounded-lg text-sm font-bold transition">
                        <i class="fa-solid fa-equals mr-1"></i>Set
                    </button>
                </div>
            </div>

            <!-- Role Management -->
            <div class="bg-white/5 p-4 rounded-xl" id="roleSection"></div>

            <!-- Ban Management (Account Ban + IP Ban) -->
            <div class="bg-white/5 p-4 rounded-xl space-y-2.5" id="banSection">
                <label class="text-xs text-gray-400 font-bold block">Ban Management (نظام الحظر)</label>
                <input name="reason" placeholder="سبب الباند (اختياري)..." 
                    class="w-full bg-black/50 border border-white/10 p-3 rounded-xl text-sm text-white focus:border-indigo-500 outline-none">
                
                <div class="grid grid-cols-2 gap-2 pt-1">
                    <button name="action" value="ban_account" class="bg-red-600 text-white hover:bg-red-500 py-2.5 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-user-slash"></i>
                        <span>باند حساب (Account)</span>
                    </button>

                    <button name="action" value="ban_ip" class="bg-orange-600 text-white hover:bg-orange-500 py-2.5 px-3 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-network-wired"></i>
                        <span>باند شبكة (IP Ban)</span>
                    </button>
                </div>

                <button name="action" value="unban" class="w-full bg-gray-700 text-white py-2.5 rounded-xl text-xs font-bold hover:bg-emerald-600 transition mt-1">
                    <i class="fa-solid fa-unlock mr-1"></i> فك الباند (Unban)
                </button>
            </div>

            <!-- Permanent Delete Section -->
            <div class="bg-red-950/30 border border-red-500/20 p-4 rounded-xl" id="deleteSection"></div>
        </form>
    </div>
</div>

<script>
const SUPER_ADMINS = <%- JSON.stringify(superAdmins) %>;
const IS_OWNER = <%= isOwner %>;

function isSuperAdmin(id) {
    return SUPER_ADMINS.includes(id);
}

function manage(id, name, coins, isAdmin, isBanned, banType) {
    document.getElementById('uId').value = id;
    document.getElementById('uDetails').innerHTML = `<i class="fa-solid fa-user mr-2"></i>${name} | <i class="fa-solid fa-coins mr-1"></i>${coins} Coins`;
    
    const rs = document.getElementById('roleSection');
    const ds = document.getElementById('deleteSection');

    if(isSuperAdmin(id)) {
        rs.innerHTML = `
            <div class="text-center text-yellow-500 text-sm font-bold border border-yellow-500/20 py-3 rounded-xl">
                <i class="fa-solid fa-crown mr-2"></i>Super Admin (Protected)
            </div>`;
        ds.innerHTML = `
            <div class="text-center text-gray-500 text-xs font-bold py-2">
                <i class="fa-solid fa-shield-halved mr-1"></i>لا يمكن حذف حساب Super Admin
            </div>`;
    } else {
        if(!IS_OWNER) {
            rs.innerHTML = `
                <div class="text-center text-gray-500 text-sm font-bold border border-gray-500/20 py-3 rounded-xl">
                    <i class="fa-solid fa-lock mr-2"></i>Only Super Admins Can Manage Admins
                </div>`;
        } else if(isAdmin) {
            rs.innerHTML = `
                <label class="text-xs text-gray-400 font-bold mb-2 block">Role Management</label>
                <button name="action" value="demote" class="w-full bg-orange-600/20 text-orange-400 hover:bg-orange-600 hover:text-white py-3 rounded-xl text-sm font-bold transition">
                    <i class="fa-solid fa-user-minus mr-2"></i>Revoke Admin
                </button>`;
        } else {
            rs.innerHTML = `
                <label class="text-xs text-gray-400 font-bold mb-2 block">Role Management</label>
                <button name="action" value="promote" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white py-3 rounded-xl text-sm font-bold transition">
                    <i class="fa-solid fa-user-plus mr-2"></i>Make Admin
                </button>`;
        }

        ds.innerHTML = `
            <label class="text-xs text-red-400 font-bold mb-2 block"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Danger Zone (حذف نهائي)</label>
            <button name="action" value="delete" onclick="return confirm('هل أنت متأكد من حذف هذا المستخدم وجميع سيرفراته نهائياً؟ لا يمكن التراجع عن هذا الإجراء!');" class="w-full bg-red-600/20 border border-red-500/40 text-red-400 hover:bg-red-600 hover:text-white py-3 rounded-xl text-sm font-bold transition">
                <i class="fa-solid fa-user-xmark mr-2"></i>Delete User Permanently (حذف الحساب نهائياً)
            </button>`;
    }
    
    document.getElementById('uModal').classList.remove('hidden');
}

// Search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
    const search = e.target.value.toLowerCase();
    const items = document.querySelectorAll('.user-item');
    let count = 0;
    
    items.forEach(item => {
        const username = item.dataset.username;
        if(username.includes(search)) {
            item.style.display = 'flex';
            count++;
        } else {
            item.style.display = 'none';
        }
    });
    
    document.getElementById('userCount').textContent = count;
});
</script>

<%- include('./partials/footer') %>

