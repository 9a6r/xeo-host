<%- include('./partials/header') %>

<div class="max-w-7xl mx-auto">
    <h2 class="text-3xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">
        <i class="fa-solid fa-credit-card mr-3"></i>Payments & Coins
    </h2>

    <!-- Alert Messages -->
    <% if(message) { %>
    <div class="mb-6 p-4 rounded-xl <%= message.type === 'success' ? 'bg-green-500/20 border border-green-500/30 text-green-400' : 'bg-red-500/20 border border-red-500/30 text-red-400' %>">
        <i class="fa-solid <%= message.type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle' %> mr-2"></i>
        <%= message.text %>
    </div>
    <% } %>

    <!-- AFK Settings -->
    <div class="glass p-6 rounded-2xl border border-white/5 mb-8">
        <h3 class="font-bold text-white mb-4 flex items-center gap-2">
            <i class="fa-solid fa-clock text-yellow-400"></i>
            AFK Rewards Settings
        </h3>
        <form action="/admin/payments/afk-settings" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">Enable AFK</label>
                    <select name="afk_enabled" class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                        <option value="true" <%= afkSettings.enabled ? 'selected' : '' %>>Enabled</option>
                        <option value="false" <%= !afkSettings.enabled ? 'selected' : '' %>>Disabled</option>
                    </select>
                </div>
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">Coins Per Reward</label>
                    <input type="number" name="afk_coins" value="<%= afkSettings.coins %>" min="1" required
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                </div>
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">Interval (Seconds)</label>
                    <input type="number" name="afk_interval" value="<%= afkSettings.interval %>" min="10" required
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                </div>
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">Max Daily Coins</label>
                    <input type="number" name="afk_max_daily" value="<%= afkSettings.maxDaily %>" min="0" placeholder="0 = Unlimited"
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                </div>
            </div>
            <div class="flex items-center gap-4">
                <button class="bg-yellow-600 hover:bg-yellow-500 text-white px-6 py-3 rounded-xl font-bold transition">
                    <i class="fa-solid fa-save mr-2"></i>Save AFK Settings
                </button>
                <span class="text-xs text-gray-500">
                    <i class="fa-solid fa-info-circle mr-1"></i>
                    Users will earn <%= afkSettings.coins %> coins every <%= afkSettings.interval %> seconds on the AFK page
                </span>
            </div>
        </form>
    </div>

    <!-- Store Pricing Settings -->
    <div class="glass p-6 rounded-2xl border border-white/5 mb-8">
        <h3 class="font-bold text-white mb-4 flex items-center gap-2">
            <i class="fa-solid fa-store text-green-400"></i>
            Store Pricing Settings
        </h3>
        <form action="/admin/payments/store-settings" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">
                        <i class="fa-solid fa-memory text-blue-400 mr-1"></i>RAM Price (coins per MB)
                    </label>
                    <input type="number" name="store_price_ram" value="<%= storePrices.ram %>" min="0.01" step="0.01" required
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-blue-500 transition">
                </div>
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">
                        <i class="fa-solid fa-microchip text-purple-400 mr-1"></i>CPU Price (coins per %)
                    </label>
                    <input type="number" name="store_price_cpu" value="<%= storePrices.cpu %>" min="0.01" step="0.01" required
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-purple-500 transition">
                </div>
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">
                        <i class="fa-solid fa-hard-drive text-green-400 mr-1"></i>Disk Price (coins per MB)
                    </label>
                    <input type="number" name="store_price_disk" value="<%= storePrices.disk %>" min="0.01" step="0.01" required
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-green-500 transition">
                </div>
            </div>
            <div class="flex items-center gap-4">
                <button class="bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-xl font-bold transition">
                    <i class="fa-solid fa-save mr-2"></i>Save Store Prices
                </button>
                <span class="text-xs text-gray-500">
                    <i class="fa-solid fa-info-circle mr-1"></i>
                    Example: 512 MB RAM = <%= (storePrices.ram * 512).toFixed(0) %> coins
                </span>
            </div>
        </form>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="glass p-4 rounded-xl flex items-center gap-4">
            <div class="w-12 h-12 bg-green-600/20 rounded-xl flex items-center justify-center">
                <i class="fa-solid fa-coins text-green-400 text-xl"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-white"><%= stats.totalRedeemed %></div>
                <div class="text-xs text-gray-400">Total Redeemed</div>
            </div>
        </div>
        <div class="glass p-4 rounded-xl flex items-center gap-4">
            <div class="w-12 h-12 bg-red-600/20 rounded-xl flex items-center justify-center">
                <i class="fa-solid fa-shopping-cart text-red-400 text-xl"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-white"><%= stats.totalSpent %></div>
                <div class="text-xs text-gray-400">Total Spent</div>
            </div>
        </div>
        <div class="glass p-4 rounded-xl flex items-center gap-4">
            <div class="w-12 h-12 bg-indigo-600/20 rounded-xl flex items-center justify-center">
                <i class="fa-solid fa-ticket text-indigo-400 text-xl"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-white"><%= stats.activeCodes %></div>
                <div class="text-xs text-gray-400">Active Codes</div>
            </div>
        </div>
        <div class="glass p-4 rounded-xl flex items-center gap-4">
            <div class="w-12 h-12 bg-yellow-600/20 rounded-xl flex items-center justify-center">
                <i class="fa-solid fa-layer-group text-yellow-400 text-xl"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-white"><%= stats.totalCodes %></div>
                <div class="text-xs text-gray-400">Total Codes</div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Create Code Panel -->
        <div class="glass p-6 rounded-2xl border border-white/5">
            <h3 class="font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-plus-circle text-green-400"></i>
                Create Redeem Code
            </h3>
            
            <!-- Single Code -->
            <form action="/admin/payments/create-code" method="POST" class="space-y-4 mb-6">
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">Coins Amount *</label>
                    <input type="number" name="coins" required min="1" placeholder="100"
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                </div>
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">Max Uses</label>
                    <input type="number" name="max_uses" value="1" min="1"
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                </div>
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">Expires In (Days)</label>
                    <input type="number" name="expires_days" placeholder="Never"
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                </div>
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">Custom Code (Optional)</label>
                    <input type="text" name="custom_code" placeholder="AUTO-GENERATED" pattern="[A-Z0-9-]+"
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition uppercase">
                </div>
                <button class="w-full bg-green-600 hover:bg-green-500 text-white py-3 rounded-xl font-bold transition">
                    <i class="fa-solid fa-plus mr-2"></i>Create Code
                </button>
            </form>

            <!-- Bulk Create -->
            <div class="border-t border-white/10 pt-6">
                <h4 class="font-bold text-white mb-4 text-sm">Bulk Create</h4>
                <form action="/admin/payments/bulk-create" method="POST" class="space-y-4">
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-xs text-gray-400 font-bold mb-1 block">Coins</label>
                            <input type="number" name="coins" required min="1" placeholder="100"
                                class="w-full bg-black/40 border border-white/10 rounded-lg p-2 text-white text-sm outline-none focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="text-xs text-gray-400 font-bold mb-1 block">Count</label>
                            <input type="number" name="count" required min="1" max="100" placeholder="10"
                                class="w-full bg-black/40 border border-white/10 rounded-lg p-2 text-white text-sm outline-none focus:border-indigo-500">
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-xs text-gray-400 font-bold mb-1 block">Max Uses</label>
                            <input type="number" name="max_uses" value="1" min="1"
                                class="w-full bg-black/40 border border-white/10 rounded-lg p-2 text-white text-sm outline-none focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="text-xs text-gray-400 font-bold mb-1 block">Expires (Days)</label>
                            <input type="number" name="expires_days" placeholder="Never"
                                class="w-full bg-black/40 border border-white/10 rounded-lg p-2 text-white text-sm outline-none focus:border-indigo-500">
                        </div>
                    </div>
                    <button class="w-full bg-indigo-600 hover:bg-indigo-500 text-white py-2 rounded-lg font-bold transition text-sm">
                        <i class="fa-solid fa-layer-group mr-2"></i>Generate Multiple
                    </button>
                </form>
            </div>
        </div>

        <!-- Codes List -->
        <div class="lg:col-span-2 glass p-6 rounded-2xl border border-white/5">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-gray-400 uppercase text-xs">
                    <i class="fa-solid fa-ticket mr-2"></i>Redeem Codes (<%= codes.length %>)
                </h3>
            </div>

            <% if(codes.length === 0) { %>
            <div class="text-center py-12 text-gray-500">
                <i class="fa-solid fa-ticket text-4xl mb-4"></i>
                <p>No codes created yet</p>
            </div>
            <% } else { %>
            <div class="space-y-3 max-h-[500px] overflow-y-auto custom-scroll">
                <% codes.forEach(c => { 
                    const isExpired = c.expires_at && new Date(c.expires_at) < new Date();
                    const isUsedUp = c.used_count >= c.max_uses;
                %>
                <div class="bg-white/5 p-4 rounded-xl border border-white/5 hover:bg-white/10 transition">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-3">
                            <code class="bg-black/50 px-3 py-1 rounded-lg text-indigo-400 font-mono text-sm select-all"><%= c.code %></code>
                            <button onclick="copyCode('<%= c.code %>')" class="text-gray-400 hover:text-white transition" title="Copy">
                                <i class="fa-solid fa-copy"></i>
                            </button>
                        </div>
                        <div class="flex items-center gap-2">
                            <% if(!c.is_active) { %>
                            <span class="bg-red-500/20 text-red-400 px-2 py-0.5 rounded text-[10px]">INACTIVE</span>
                            <% } else if(isExpired) { %>
                            <span class="bg-orange-500/20 text-orange-400 px-2 py-0.5 rounded text-[10px]">EXPIRED</span>
                            <% } else if(isUsedUp) { %>
                            <span class="bg-gray-500/20 text-gray-400 px-2 py-0.5 rounded text-[10px]">USED UP</span>
                            <% } else { %>
                            <span class="bg-green-500/20 text-green-400 px-2 py-0.5 rounded text-[10px]">ACTIVE</span>
                            <% } %>
                        </div>
                    </div>
                    <div class="flex items-center justify-between text-xs text-gray-400">
                        <div class="flex items-center gap-4">
                            <span><i class="fa-solid fa-coins text-yellow-400 mr-1"></i><%= c.coins %> coins</span>
                            <span><i class="fa-solid fa-users mr-1"></i><%= c.used_count %>/<%= c.max_uses %> uses</span>
                            <% if(c.expires_at) { %>
                            <span><i class="fa-solid fa-clock mr-1"></i><%= new Date(c.expires_at).toLocaleDateString() %></span>
                            <% } %>
                        </div>
                        <div class="flex items-center gap-2">
                            <form action="/admin/payments/toggle-code" method="POST" class="inline">
                                <input type="hidden" name="id" value="<%= c.id %>">
                                <button class="<%= c.is_active ? 'text-orange-400 hover:text-orange-300' : 'text-green-400 hover:text-green-300' %> transition" title="<%= c.is_active ? 'Deactivate' : 'Activate' %>">
                                    <i class="fa-solid <%= c.is_active ? 'fa-toggle-on' : 'fa-toggle-off' %>"></i>
                                </button>
                            </form>
                            <form action="/admin/payments/delete-code" method="POST" class="inline" onsubmit="return confirm('Delete this code?')">
                                <input type="hidden" name="id" value="<%= c.id %>">
                                <button class="text-red-400 hover:text-red-300 transition" title="Delete">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>
    </div>

    <!-- Recent Transactions -->
    <div class="glass p-6 rounded-2xl border border-white/5 mt-8">
        <h3 class="font-bold text-gray-400 uppercase text-xs mb-4">
            <i class="fa-solid fa-clock-rotate-left mr-2"></i>Recent Transactions
        </h3>

        <% if(transactions.length === 0) { %>
        <div class="text-center py-8 text-gray-500">
            <i class="fa-solid fa-receipt text-3xl mb-3"></i>
            <p>No transactions yet</p>
        </div>
        <% } else { %>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-gray-400 border-b border-white/10">
                        <th class="pb-3 font-medium">User</th>
                        <th class="pb-3 font-medium">Type</th>
                        <th class="pb-3 font-medium">Amount</th>
                        <th class="pb-3 font-medium">Description</th>
                        <th class="pb-3 font-medium">Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    <% transactions.forEach(t => { %>
                    <tr class="hover:bg-white/5">
                        <td class="py-3 text-white"><%= t.username || 'Unknown' %></td>
                        <td class="py-3">
                            <span class="px-2 py-1 rounded text-xs font-bold
                                <%= t.type === 'redeem' ? 'bg-green-500/20 text-green-400' : 
                                   t.type === 'purchase' ? 'bg-red-500/20 text-red-400' : 
                                   t.type === 'admin' ? 'bg-indigo-500/20 text-indigo-400' : 
                                   'bg-gray-500/20 text-gray-400' %>">
                                <%= t.type.toUpperCase() %>
                            </span>
                        </td>
                        <td class="py-3 <%= t.amount >= 0 ? 'text-green-400' : 'text-red-400' %>">
                            <%= t.amount >= 0 ? '+' : '' %><%= t.amount %> coins
                        </td>
                        <td class="py-3 text-gray-400 max-w-xs truncate"><%= t.description || '-' %></td>
                        <td class="py-3 text-gray-500"><%= new Date(t.created_at).toLocaleString() %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } %>
    </div>
</div>

<script>
function copyCode(code) {
    navigator.clipboard.writeText(code).then(() => {
        // Show toast or feedback
        const toast = document.createElement('div');
        toast.className = 'fixed bottom-4 right-4 bg-green-600 text-white px-4 py-2 rounded-lg shadow-lg z-50';
        toast.innerHTML = '<i class="fa-solid fa-check mr-2"></i>Code copied!';
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 2000);
    });
}
</script>

<%- include('./partials/footer') %>
