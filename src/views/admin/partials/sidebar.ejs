<!-- Mobile Top Bar -->
<div class="md:hidden fixed top-0 w-full bg-[#0a0a0f]/95 backdrop-blur-xl z-50 flex justify-between items-center px-4 py-3 border-b border-white/5">
    <a href="/admin" class="flex items-center gap-3">
        <div class="w-9 h-9 bg-gradient-to-br from-red-500 to-orange-500 rounded-xl flex items-center justify-center shadow-lg shadow-red-500/20">
            <i class="fa-solid fa-shield-halved text-white text-sm"></i>
        </div>
        <span class="font-bold text-white">Admin</span>
    </a>
    <button onclick="toggleAdminSidebar()" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 text-white">
        <i class="fa-solid fa-bars"></i>
    </button>
</div>

<!-- Sidebar -->
<aside id="admin-sidebar" class="fixed left-0 top-0 h-full bg-[#0a0a0f] border-r border-white/5 z-40 flex flex-col transform -translate-x-full md:translate-x-0 transition-all duration-300 ease-in-out admin-sidebar-expanded">
    <!-- Logo Section -->
    <div class="p-3 hidden md:flex items-center justify-between admin-logo-section">
        <a href="/admin" class="flex items-center gap-3 sidebar-logo-full flex-1 min-w-0">
            <div class="w-10 h-10 bg-gradient-to-br from-red-500 to-orange-500 rounded-xl flex items-center justify-center shadow-lg shadow-red-500/20 flex-shrink-0">
                <i class="fa-solid fa-shield-halved text-white"></i>
            </div>
            <div class="sidebar-text min-w-0">
                <div class="font-bold text-white truncate">Admin Panel</div>
                <div class="text-[10px] text-gray-500">Control Center</div>
            </div>
        </a>
        <button onclick="toggleAdminSidebarCollapse()" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-white/10 flex items-center justify-center text-gray-400 hover:text-white transition sidebar-collapse-btn flex-shrink-0 ml-2">
            <i class="fa-solid fa-chevron-left text-xs transition-transform duration-300"></i>
        </button>
    </div>

    <!-- Mobile Close Button -->
    <div class="md:hidden p-4 flex justify-between items-center border-b border-white/5">
        <span class="font-bold text-white">Navigation</span>
        <button onclick="toggleAdminSidebar()" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 text-gray-400 hover:text-white">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 px-2 py-4 overflow-y-auto custom-scroll">
        <!-- Main Section -->
        <div class="mb-4">
            <div class="px-3 mb-2 text-[10px] font-bold text-gray-500 uppercase tracking-wider sidebar-text">Overview</div>
            <a href="/admin" onclick="closeSidebarOnMobile()" class="admin-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 <%= page === 'dashboard' ? 'bg-gradient-to-r from-indigo-600 to-indigo-500 text-white shadow-lg shadow-indigo-500/20' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>" title="Dashboard">
                <div class="w-9 h-9 rounded-lg <%= page === 'dashboard' ? 'bg-white/20' : 'bg-indigo-500/10' %> flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-chart-pie text-sm <%= page === 'dashboard' ? 'text-white' : 'text-indigo-400' %>"></i>
                </div>
                <span class="font-medium sidebar-text">Dashboard</span>
            </a>
        </div>

        <!-- Management Section -->
        <div class="mb-4">
            <div class="px-3 mb-2 text-[10px] font-bold text-gray-500 uppercase tracking-wider sidebar-text">Management</div>
            
            <a href="/admin/users" onclick="closeSidebarOnMobile()" class="admin-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 <%= page === 'users' ? 'bg-gradient-to-r from-blue-600 to-blue-500 text-white shadow-lg shadow-blue-500/20' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>" title="Users">
                <div class="w-9 h-9 rounded-lg <%= page === 'users' ? 'bg-white/20' : 'bg-blue-500/10' %> flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-users text-sm <%= page === 'users' ? 'text-white' : 'text-blue-400' %>"></i>
                </div>
                <span class="font-medium sidebar-text">Users</span>
            </a>

            <a href="/admin/servers" onclick="closeSidebarOnMobile()" class="admin-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 <%= page === 'servers' ? 'bg-gradient-to-r from-green-600 to-green-500 text-white shadow-lg shadow-green-500/20' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>" title="Servers">
                <div class="w-9 h-9 rounded-lg <%= page === 'servers' ? 'bg-white/20' : 'bg-green-500/10' %> flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-server text-sm <%= page === 'servers' ? 'text-white' : 'text-green-400' %>"></i>
                </div>
                <span class="font-medium sidebar-text">Servers</span>
            </a>

            <a href="/admin/payments" onclick="closeSidebarOnMobile()" class="admin-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 <%= page === 'payments' ? 'bg-gradient-to-r from-yellow-600 to-yellow-500 text-white shadow-lg shadow-yellow-500/20' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>" title="Payments">
                <div class="w-9 h-9 rounded-lg <%= page === 'payments' ? 'bg-white/20' : 'bg-yellow-500/10' %> flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-coins text-sm <%= page === 'payments' ? 'text-white' : 'text-yellow-400' %>"></i>
                </div>
                <span class="font-medium sidebar-text">Payments</span>
            </a>

            <a href="/admin/tickets" onclick="closeSidebarOnMobile()" class="admin-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 <%= page === 'admin-tickets' ? 'bg-gradient-to-r from-orange-600 to-orange-500 text-white shadow-lg shadow-orange-500/20' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>" title="Tickets">
                <div class="w-9 h-9 rounded-lg <%= page === 'admin-tickets' ? 'bg-white/20' : 'bg-orange-500/10' %> flex items-center justify-center flex-shrink-0 relative">
                    <i class="fa-solid fa-headset text-sm <%= page === 'admin-tickets' ? 'text-white' : 'text-orange-400' %>"></i>
                    <% if(typeof openTickets !== 'undefined' && openTickets > 0) { %>
                    <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 text-white text-[8px] font-bold rounded-full flex items-center justify-center animate-pulse"><%= openTickets %></span>
                    <% } %>
                </div>
                <span class="font-medium sidebar-text">Tickets</span>
                <% if(typeof openTickets !== 'undefined' && openTickets > 0) { %>
                <span class="ml-auto bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full sidebar-text"><%= openTickets %></span>
                <% } %>
            </a>
        </div>

        <!-- System Section -->
        <div class="mb-4">
            <div class="px-3 mb-2 text-[10px] font-bold text-gray-500 uppercase tracking-wider sidebar-text">System</div>
            
            <a href="/admin/backup" onclick="closeSidebarOnMobile()" class="admin-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 <%= page === 'backup' ? 'bg-gradient-to-r from-cyan-600 to-cyan-500 text-white shadow-lg shadow-cyan-500/20' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>" title="Backup">
                <div class="w-9 h-9 rounded-lg <%= page === 'backup' ? 'bg-white/20' : 'bg-cyan-500/10' %> flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-cloud-arrow-up text-sm <%= page === 'backup' ? 'text-white' : 'text-cyan-400' %>"></i>
                </div>
                <span class="font-medium sidebar-text">Backup</span>
            </a>

            <a href="/admin/plugins" onclick="closeSidebarOnMobile()" class="admin-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 <%= page === 'plugins' ? 'bg-gradient-to-r from-purple-600 to-purple-500 text-white shadow-lg shadow-purple-500/20' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>" title="Plugins">
                <div class="w-9 h-9 rounded-lg <%= page === 'plugins' ? 'bg-white/20' : 'bg-purple-500/10' %> flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-puzzle-piece text-sm <%= page === 'plugins' ? 'text-white' : 'text-purple-400' %>"></i>
                </div>
                <span class="font-medium sidebar-text">Plugins</span>
            </a>

            <a href="/admin/api" onclick="closeSidebarOnMobile()" class="admin-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 <%= page === 'api' ? 'bg-gradient-to-r from-pink-600 to-pink-500 text-white shadow-lg shadow-pink-500/20' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>" title="API Keys">
                <div class="w-9 h-9 rounded-lg <%= page === 'api' ? 'bg-white/20' : 'bg-pink-500/10' %> flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-code text-sm <%= page === 'api' ? 'text-white' : 'text-pink-400' %>"></i>
                </div>
                <span class="font-medium sidebar-text">API Keys</span>
            </a>

            <a href="/admin/announcements" onclick="closeSidebarOnMobile()" class="admin-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 <%= page === 'announcements' ? 'bg-gradient-to-r from-rose-600 to-rose-500 text-white shadow-lg shadow-rose-500/20' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>" title="Announcements">
                <div class="w-9 h-9 rounded-lg <%= page === 'announcements' ? 'bg-white/20' : 'bg-rose-500/10' %> flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-bullhorn text-sm <%= page === 'announcements' ? 'text-white' : 'text-rose-400' %>"></i>
                </div>
                <span class="font-medium sidebar-text">Announcements</span>
            </a>

            <a href="/admin/settings" onclick="closeSidebarOnMobile()" class="admin-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 <%= page === 'settings' ? 'bg-gradient-to-r from-gray-600 to-gray-500 text-white shadow-lg shadow-gray-500/20' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>" title="Settings">
                <div class="w-9 h-9 rounded-lg <%= page === 'settings' ? 'bg-white/20' : 'bg-gray-500/10' %> flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-gear text-sm <%= page === 'settings' ? 'text-white' : 'text-gray-400' %>"></i>
                </div>
                <span class="font-medium sidebar-text">Settings</span>
            </a>
        </div>
    </nav>

    <!-- Footer -->
    <div class="p-2 border-t border-white/5">
        <!-- Admin Info -->
        <div class="flex items-center gap-3 px-2 py-2 mb-2 rounded-xl bg-white/5 admin-user-info">
            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" 
                 class="w-9 h-9 rounded-lg flex-shrink-0" 
                 onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
            <div class="flex-1 min-w-0 sidebar-text">
                <div class="text-sm font-medium text-white truncate"><%= user.username %></div>
                <div class="text-[10px] text-red-400 font-bold">Administrator</div>
            </div>
        </div>
        
        <!-- Back Button -->
        <a href="/dashboard" class="admin-nav-link flex items-center justify-center gap-2 px-2 py-2 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition text-sm" title="Back to Dashboard">
            <i class="fa-solid fa-arrow-left"></i>
            <span class="sidebar-text">Back to Dashboard</span>
        </a>
    </div>
</aside>

<!-- Backdrop for Mobile -->
<div id="admin-backdrop" onclick="toggleAdminSidebar()" class="fixed inset-0 bg-black/80 z-30 hidden md:hidden backdrop-blur-sm"></div>

<style>
    .admin-sidebar-expanded { width: 260px; }
    .admin-sidebar-collapsed { width: 70px; }
    .admin-sidebar-collapsed .sidebar-text { display: none; }
    .admin-sidebar-collapsed .sidebar-logo-full { flex: 0; }
    .admin-sidebar-collapsed .sidebar-collapse-btn i { transform: rotate(180deg); }
    .admin-sidebar-collapsed .sidebar-collapse-btn { margin-left: 0; }
    .admin-sidebar-collapsed .admin-nav-link { justify-content: center; padding-left: 0; padding-right: 0; }
    .admin-sidebar-collapsed .admin-user-info { justify-content: center; padding: 0.5rem; }
    .admin-sidebar-collapsed .admin-user-info img { margin: 0; }
    .admin-sidebar-collapsed .admin-logo-section { justify-content: center; padding: 0.75rem; }
    
    /* Prevent transition on page load */
    .no-transition, .no-transition * { transition: none !important; }
    
    @media (max-width: 768px) {
        .admin-sidebar-expanded, .admin-sidebar-collapsed { width: 260px; }
        .admin-sidebar-collapsed .sidebar-text { display: block; }
        .admin-sidebar-collapsed .admin-nav-link { justify-content: flex-start; padding-left: 0.5rem; padding-right: 0.5rem; }
        .admin-sidebar-collapsed .sidebar-logo-full { flex: 1; }
    }
</style>

<script data-turbo-permanent id="admin-sidebar-functions">
function toggleAdminSidebar() {
    const sidebar = document.getElementById('admin-sidebar');
    const backdrop = document.getElementById('admin-backdrop');
    
    if (sidebar.classList.contains('-translate-x-full')) {
        sidebar.classList.remove('-translate-x-full');
        sidebar.classList.add('translate-x-0');
        backdrop.classList.remove('hidden');
    } else {
        sidebar.classList.add('-translate-x-full');
        sidebar.classList.remove('translate-x-0');
        backdrop.classList.add('hidden');
    }
}

function toggleAdminSidebarCollapse() {
    const sidebar = document.getElementById('admin-sidebar');
    const isCollapsed = sidebar.classList.contains('admin-sidebar-collapsed');
    
    if (isCollapsed) {
        sidebar.classList.remove('admin-sidebar-collapsed');
        sidebar.classList.add('admin-sidebar-expanded');
        localStorage.setItem('adminSidebarCollapsed', 'false');
    } else {
        sidebar.classList.remove('admin-sidebar-expanded');
        sidebar.classList.add('admin-sidebar-collapsed');
        localStorage.setItem('adminSidebarCollapsed', 'true');
    }
    
    updateAdminMainMargin();
}

function updateAdminMainMargin() {
    const sidebar = document.getElementById('admin-sidebar');
    const main = document.querySelector('.admin-main');
    if (main && window.innerWidth >= 768) {
        if (sidebar.classList.contains('admin-sidebar-collapsed')) {
            main.style.marginLeft = '70px';
        } else {
            main.style.marginLeft = '260px';
        }
    }
}

function closeSidebarOnMobile() {
    if (window.innerWidth < 768) {
        const sidebar = document.getElementById('admin-sidebar');
        const backdrop = document.getElementById('admin-backdrop');
        sidebar.classList.add('-translate-x-full');
        sidebar.classList.remove('translate-x-0');
        backdrop.classList.add('hidden');
    }
}

function initAdminSidebar() {
    const sidebar = document.getElementById('admin-sidebar');
    if (!sidebar) return;
    
    const isCollapsed = localStorage.getItem('adminSidebarCollapsed') === 'true';
    
    if (isCollapsed && window.innerWidth >= 768) {
        sidebar.classList.remove('admin-sidebar-expanded');
        sidebar.classList.add('admin-sidebar-collapsed');
    } else if (window.innerWidth >= 768) {
        sidebar.classList.remove('admin-sidebar-collapsed');
        sidebar.classList.add('admin-sidebar-expanded');
    }
    
    updateAdminMainMargin();
}

// Run on initial load and Turbo navigation
document.addEventListener('DOMContentLoaded', initAdminSidebar);
document.addEventListener('turbo:load', initAdminSidebar);
document.addEventListener('turbo:render', initAdminSidebar);
window.addEventListener('resize', updateAdminMainMargin);
</script>
