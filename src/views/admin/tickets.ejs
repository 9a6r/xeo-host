<%- include('./partials/header') %>

<div class="flex-1 overflow-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-400">
                <i class="fa-solid fa-headset mr-3"></i>Support Tickets
            </h2>
            <p class="text-gray-400 mt-1">Manage user support requests</p>
        </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="glass p-4 rounded-xl">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-green-600/20 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-envelope-open text-green-400 text-xl"></i>
                </div>
                <div>
                    <div class="text-2xl font-bold text-green-400"><%= stats.open %></div>
                    <div class="text-xs text-gray-400">Open</div>
                </div>
            </div>
        </div>
        <div class="glass p-4 rounded-xl">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-yellow-600/20 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-clock text-yellow-400 text-xl"></i>
                </div>
                <div>
                    <div class="text-2xl font-bold text-yellow-400"><%= stats.pending %></div>
                    <div class="text-xs text-gray-400">Pending</div>
                </div>
            </div>
        </div>
        <div class="glass p-4 rounded-xl">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-gray-600/20 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-check text-gray-400 text-xl"></i>
                </div>
                <div>
                    <div class="text-2xl font-bold text-gray-400"><%= stats.closed %></div>
                    <div class="text-xs text-gray-400">Closed</div>
                </div>
            </div>
        </div>
        <div class="glass p-4 rounded-xl">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-indigo-600/20 rounded-xl flex items-center justify-center">
                    <i class="fa-solid fa-ticket text-indigo-400 text-xl"></i>
                </div>
                <div>
                    <div class="text-2xl font-bold text-white"><%= stats.total %></div>
                    <div class="text-xs text-gray-400">Total</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
        <a href="/admin/tickets" class="px-4 py-2 rounded-xl font-bold text-sm transition <%= !filter ? 'bg-indigo-600 text-white' : 'bg-white/5 text-gray-400 hover:bg-white/10' %>">
            All
        </a>
        <a href="/admin/tickets?filter=open" class="px-4 py-2 rounded-xl font-bold text-sm transition <%= filter === 'open' ? 'bg-green-600 text-white' : 'bg-white/5 text-gray-400 hover:bg-white/10' %>">
            Open (<%= stats.open %>)
        </a>
        <a href="/admin/tickets?filter=pending" class="px-4 py-2 rounded-xl font-bold text-sm transition <%= filter === 'pending' ? 'bg-yellow-600 text-white' : 'bg-white/5 text-gray-400 hover:bg-white/10' %>">
            Pending (<%= stats.pending %>)
        </a>
        <a href="/admin/tickets?filter=closed" class="px-4 py-2 rounded-xl font-bold text-sm transition <%= filter === 'closed' ? 'bg-gray-600 text-white' : 'bg-white/5 text-gray-400 hover:bg-white/10' %>">
            Closed (<%= stats.closed %>)
        </a>
    </div>

    <!-- Tickets List -->
    <% if(tickets.length === 0) { %>
    <div class="glass p-12 rounded-2xl text-center">
        <i class="fa-solid fa-inbox text-6xl text-gray-600 mb-4"></i>
        <h3 class="text-xl font-bold text-gray-400 mb-2">No Tickets</h3>
        <p class="text-gray-500">No tickets found with the current filter</p>
    </div>
    <% } else { %>
    <div class="glass rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-black/30">
                    <tr>
                        <th class="text-left p-4 text-xs font-bold text-gray-400 uppercase">Ticket</th>
                        <th class="text-left p-4 text-xs font-bold text-gray-400 uppercase">User</th>
                        <th class="text-left p-4 text-xs font-bold text-gray-400 uppercase hidden md:table-cell">Category</th>
                        <th class="text-left p-4 text-xs font-bold text-gray-400 uppercase">Priority</th>
                        <th class="text-left p-4 text-xs font-bold text-gray-400 uppercase">Status</th>
                        <th class="text-left p-4 text-xs font-bold text-gray-400 uppercase hidden md:table-cell">Updated</th>
                        <th class="text-right p-4 text-xs font-bold text-gray-400 uppercase">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    <% tickets.forEach(ticket => { %>
                    <tr class="hover:bg-white/5 transition">
                        <td class="p-4">
                            <div class="font-bold text-white">#<%= ticket.id %></div>
                            <div class="text-sm text-gray-400 truncate max-w-[200px]"><%= ticket.subject %></div>
                            <div class="text-xs text-gray-500"><%= ticket.message_count %> messages</div>
                        </td>
                        <td class="p-4">
                            <div class="flex items-center gap-2">
                                <img src="<%= ticket.avatar ? `https://cdn.discordapp.com/avatars/${ticket.user_id}/${ticket.avatar}.png` : '/img/default-avatar.png' %>" 
                                     class="w-8 h-8 rounded-full" alt="Avatar">
                                <span class="text-white"><%= ticket.username %></span>
                            </div>
                        </td>
                        <td class="p-4 hidden md:table-cell">
                            <span class="px-2 py-1 rounded text-xs font-bold uppercase bg-indigo-500/20 text-indigo-400"><%= ticket.category %></span>
                        </td>
                        <td class="p-4">
                            <span class="px-2 py-1 rounded text-xs font-bold uppercase <%= 
                                ticket.priority === 'urgent' ? 'bg-red-500/20 text-red-400' : 
                                ticket.priority === 'high' ? 'bg-orange-500/20 text-orange-400' : 
                                ticket.priority === 'medium' ? 'bg-yellow-500/20 text-yellow-400' : 'bg-gray-500/20 text-gray-400' 
                            %>"><%= ticket.priority %></span>
                        </td>
                        <td class="p-4">
                            <span class="px-2 py-1 rounded text-xs font-bold uppercase <%= 
                                ticket.status === 'open' ? 'bg-green-500/20 text-green-400' : 
                                ticket.status === 'pending' ? 'bg-yellow-500/20 text-yellow-400' : 'bg-gray-500/20 text-gray-400' 
                            %>"><%= ticket.status %></span>
                        </td>
                        <td class="p-4 hidden md:table-cell">
                            <span class="text-gray-400 text-sm"><%= new Date(ticket.updated_at).toLocaleDateString() %></span>
                        </td>
                        <td class="p-4 text-right">
                            <a href="/tickets/<%= ticket.id %>" class="bg-indigo-600/20 text-indigo-400 hover:bg-indigo-600 hover:text-white px-3 py-1.5 rounded-lg font-bold text-sm transition inline-flex items-center gap-1">
                                <i class="fa-solid fa-eye"></i>
                                <span class="hidden sm:inline">View</span>
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>
</div>

<%- include('./partials/footer') %>
