<%- include('./partials/header') %>

<div class="max-w-7xl mx-auto">
    <h2 class="text-3xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">
        <i class="fa-solid fa-server mr-3"></i>Servers Management
    </h2>

    <!-- Search -->
    <div class="glass p-4 rounded-2xl mb-6">
        <div class="relative">
            <i class="fa-solid fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
            <input type="text" id="searchInput" placeholder="Search servers..." 
                class="w-full bg-black/40 border border-white/10 rounded-xl pl-12 pr-4 py-3 text-white outline-none focus:border-indigo-500 transition">
        </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="glass p-4 rounded-xl flex items-center gap-4">
            <div class="w-10 h-10 bg-green-600/20 rounded-lg flex items-center justify-center">
                <i class="fa-solid fa-circle-check text-green-400"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-white"><%= servers.filter(s => !s.isSuspended).length %></div>
                <div class="text-xs text-gray-400">Active Servers</div>
            </div>
        </div>
        <div class="glass p-4 rounded-xl flex items-center gap-4">
            <div class="w-10 h-10 bg-red-600/20 rounded-lg flex items-center justify-center">
                <i class="fa-solid fa-circle-pause text-red-400"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-white"><%= servers.filter(s => s.isSuspended).length %></div>
                <div class="text-xs text-gray-400">Suspended</div>
            </div>
        </div>
        <div class="glass p-4 rounded-xl flex items-center gap-4">
            <div class="w-10 h-10 bg-indigo-600/20 rounded-lg flex items-center justify-center">
                <i class="fa-solid fa-server text-indigo-400"></i>
            </div>
            <div>
                <div class="text-2xl font-bold text-white"><%= servers.length %></div>
                <div class="text-xs text-gray-400">Total Servers</div>
            </div>
        </div>
    </div>

    <!-- Servers List -->
    <div class="glass p-6 rounded-2xl">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between mb-4 gap-3">
            <h3 class="font-bold text-gray-400 uppercase text-xs">All Servers (<span id="serverCount"><%= servers.length %></span>)</h3>
            <div class="flex gap-2">
                <form action="/admin/servers/suspend-all" method="POST" class="inline">
                    <button type="submit" onclick="return confirm('Are you sure you want to SUSPEND ALL servers?')" 
                        class="bg-orange-500/20 text-orange-400 hover:bg-orange-500 hover:text-white px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-2">
                        <i class="fa-solid fa-pause"></i> Suspend All
                    </button>
                </form>
                <form action="/admin/servers/unsuspend-all" method="POST" class="inline">
                    <button type="submit" onclick="return confirm('Are you sure you want to UNSUSPEND ALL servers?')" 
                        class="bg-green-500/20 text-green-400 hover:bg-green-500 hover:text-white px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-2">
                        <i class="fa-solid fa-play"></i> Unsuspend All
                    </button>
                </form>
            </div>
        </div>
        <div class="space-y-3 max-h-[600px] overflow-y-auto custom-scroll" id="serversList">
            <% if(servers.length === 0) { %>
            <div class="text-center py-12 text-gray-500">
                <i class="fa-solid fa-server text-4xl mb-4"></i>
                <p>No servers found</p>
            </div>
            <% } %>
            <% servers.forEach(s => { 
                const owner = users.find(u => u.id === s.ownerId);
            %>
            <div class="server-item bg-white/5 p-4 rounded-xl flex justify-between items-center hover:bg-white/10 transition border border-white/5" data-name="<%= s.name.toLowerCase() %>">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-gradient-to-br <%= s.isSuspended ? 'from-red-600 to-red-800' : 'from-indigo-600 to-purple-600' %> rounded-xl flex items-center justify-center">
                        <i class="fa-solid fa-server text-white"></i>
                    </div>
                    <div>
                        <div class="font-bold text-white flex items-center gap-2">
                            <%= s.name %>
                            <% if(s.isSuspended) { %>
                            <span class="bg-red-500/20 text-red-400 px-2 py-0.5 rounded text-[10px]">SUSPENDED</span>
                            <% } %>
                        </div>
                        <div class="text-xs text-gray-500">ID: <%= s.id %></div>
                        <div class="text-xs text-gray-400 mt-1">
                            <i class="fa-solid fa-user mr-1"></i>
                            Owner: <%= owner ? owner.username : 'Unknown' %>
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/server/<%= s.id %>" class="bg-indigo-600/20 text-indigo-300 p-2.5 rounded-lg hover:bg-indigo-600 hover:text-white transition" title="View">
                        <i class="fa-solid fa-eye"></i>
                    </a>
                    <form action="/admin/server" method="POST" class="flex gap-2">
                        <input type="hidden" name="id" value="<%= s.id %>">
                        <% if(!s.isSuspended) { %>
                        <button name="action" value="suspend" class="bg-orange-500/20 text-orange-400 p-2.5 rounded-lg hover:bg-orange-500 hover:text-white transition" title="Suspend">
                            <i class="fa-solid fa-pause"></i>
                        </button>
                        <% } else { %>
                        <button name="action" value="unsuspend" class="bg-green-500/20 text-green-400 p-2.5 rounded-lg hover:bg-green-500 hover:text-white transition" title="Unsuspend">
                            <i class="fa-solid fa-play"></i>
                        </button>
                        <% } %>
                        <button name="action" value="delete" class="bg-red-500/20 text-red-400 p-2.5 rounded-lg hover:bg-red-500 hover:text-white transition" title="Delete" onclick="return confirm('Are you sure you want to delete this server?')">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
            <% }) %>
        </div>
    </div>
</div>

<script>
// Search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
    const search = e.target.value.toLowerCase();
    const items = document.querySelectorAll('.server-item');
    let count = 0;
    
    items.forEach(item => {
        const name = item.dataset.name;
        if(name.includes(search)) {
            item.style.display = 'flex';
            count++;
        } else {
            item.style.display = 'none';
        }
    });
    
    document.getElementById('serverCount').textContent = count;
});
</script>

<%- include('./partials/footer') %>
