<%- include('./partials/header') %>

<div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">
        <i class="fa-solid fa-gear mr-3"></i>Settings
    </h2>

    <div class="space-y-6">
        <!-- General Settings -->
        <div class="glass p-6 rounded-2xl">
            <h3 class="font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-sliders text-indigo-400"></i>
                General Settings
            </h3>
            <form action="/admin/config" method="POST" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs text-gray-400 font-bold mb-2 block">Site Name</label>
                        <input name="sitename" value="<%= config.sitename %>" 
                            class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                    </div>
                    <div>
                        <label class="text-xs text-gray-400 font-bold mb-2 block">Server Price (Coins)</label>
                        <input type="number" name="price" value="<%= config.price %>" 
                            class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                    </div>
                </div>
                <button class="bg-indigo-600 px-6 py-3 rounded-xl font-bold hover:bg-indigo-500 transition shadow-lg">
                    <i class="fa-solid fa-save mr-2"></i>Save Settings
                </button>
            </form>
        </div>

        <!-- Site Logo Settings -->
        <div class="glass p-6 rounded-2xl">
            <h3 class="font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-image text-cyan-400"></i>
                Site Logo
            </h3>
            
            <div class="flex flex-col md:flex-row gap-6 items-start">
                <!-- Current Logo Preview -->
                <div class="flex-shrink-0">
                    <div class="w-32 h-32 rounded-xl bg-black/40 border border-white/10 flex items-center justify-center overflow-hidden">
                        <% if (config.site_logo) { %>
                        <img src="<%= config.site_logo %>" alt="Site Logo" class="max-w-full max-h-full object-contain">
                        <% } else { %>
                        <div class="text-center text-gray-500">
                            <i class="fa-solid fa-image text-3xl mb-2"></i>
                            <div class="text-xs">No Logo</div>
                        </div>
                        <% } %>
                    </div>
                </div>
                
                <!-- Upload Form -->
                <div class="flex-1 space-y-4">
                    <form action="/admin/logo/upload" method="POST" enctype="multipart/form-data" class="space-y-4">
                        <div>
                            <label class="text-xs text-gray-400 font-bold mb-2 block">Upload New Logo</label>
                            <input type="file" name="logo" accept="image/*" required
                                class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-cyan-500 transition file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-cyan-600 file:text-white file:font-bold file:cursor-pointer hover:file:bg-cyan-500">
                            <p class="text-xs text-gray-500 mt-2">Supported formats: PNG, JPG, GIF, WebP, SVG (Max 5MB)</p>
                        </div>
                        <button class="bg-cyan-600 px-6 py-3 rounded-xl font-bold hover:bg-cyan-500 transition shadow-lg">
                            <i class="fa-solid fa-upload mr-2"></i>Upload Logo
                        </button>
                    </form>
                    
                    <% if (config.site_logo) { %>
                    <form action="/admin/logo/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete the logo?')">
                        <button class="bg-red-600/20 text-red-400 px-6 py-3 rounded-xl font-bold hover:bg-red-600 hover:text-white transition">
                            <i class="fa-solid fa-trash mr-2"></i>Delete Logo
                        </button>
                    </form>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- UI Settings -->
        <div class="glass p-6 rounded-2xl">
            <h3 class="font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-palette text-purple-400"></i>
                Interface Settings
            </h3>
            <form action="/admin/config" method="POST" class="space-y-4">
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-3 block">Server Navigation Style</label>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Tabs Option -->
                        <label class="cursor-pointer">
                            <input type="radio" name="server_nav_style" value="tabs" 
                                <%= (config.server_nav_style || 'tabs') === 'tabs' ? 'checked' : '' %>
                                class="hidden peer">
                            <div class="p-4 rounded-xl border-2 border-white/10 peer-checked:border-indigo-500 peer-checked:bg-indigo-500/10 transition hover:border-white/20">
                                <div class="flex items-center gap-3 mb-3">
                                    <div class="w-10 h-10 rounded-lg bg-indigo-500/20 flex items-center justify-center">
                                        <i class="fa-solid fa-grip-lines text-indigo-400"></i>
                                    </div>
                                    <div>
                                        <div class="font-bold text-white">Top Tabs</div>
                                        <div class="text-xs text-gray-400">Navigation at the top</div>
                                    </div>
                                </div>
                                <!-- Preview -->
                                <div class="bg-black/40 rounded-lg p-2 mt-2">
                                    <div class="flex gap-1 text-[10px]">
                                        <span class="px-2 py-1 bg-indigo-500/30 rounded text-indigo-300">Console</span>
                                        <span class="px-2 py-1 text-gray-500">Files</span>
                                        <span class="px-2 py-1 text-gray-500">Backup</span>
                                        <span class="px-2 py-1 text-gray-500">...</span>
                                    </div>
                                </div>
                            </div>
                        </label>

                        <!-- Sidebar Option -->
                        <label class="cursor-pointer">
                            <input type="radio" name="server_nav_style" value="sidebar" 
                                <%= config.server_nav_style === 'sidebar' ? 'checked' : '' %>
                                class="hidden peer">
                            <div class="p-4 rounded-xl border-2 border-white/10 peer-checked:border-indigo-500 peer-checked:bg-indigo-500/10 transition hover:border-white/20">
                                <div class="flex items-center gap-3 mb-3">
                                    <div class="w-10 h-10 rounded-lg bg-purple-500/20 flex items-center justify-center">
                                        <i class="fa-solid fa-table-columns text-purple-400"></i>
                                    </div>
                                    <div>
                                        <div class="font-bold text-white">Side Navigation</div>
                                        <div class="text-xs text-gray-400">Sidebar on the left</div>
                                    </div>
                                </div>
                                <!-- Preview -->
                                <div class="bg-black/40 rounded-lg p-2 mt-2 flex gap-2">
                                    <div class="w-12 bg-white/5 rounded p-1 space-y-1">
                                        <div class="h-2 bg-indigo-500/50 rounded"></div>
                                        <div class="h-2 bg-white/10 rounded"></div>
                                        <div class="h-2 bg-white/10 rounded"></div>
                                    </div>
                                    <div class="flex-1 bg-white/5 rounded"></div>
                                </div>
                            </div>
                        </label>
                    </div>
                </div>
                <button class="bg-purple-600 px-6 py-3 rounded-xl font-bold hover:bg-purple-500 transition shadow-lg">
                    <i class="fa-solid fa-save mr-2"></i>Save Interface Settings
                </button>
            </form>
        </div>

        <!-- Console Settings -->
        <div class="glass p-6 rounded-2xl">
            <h3 class="font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-terminal text-orange-400"></i>
                Console Settings
            </h3>
            <form action="/admin/config" method="POST" class="space-y-4">
                <!-- Console Commands Toggle -->
                <div class="bg-white/5 p-4 rounded-xl flex items-center justify-between">
                    <div>
                        <div class="font-bold text-white">Allow Console Commands</div>
                        <div class="text-xs text-gray-400 mt-1">
                            <span class="text-green-400"><i class="fa-solid fa-check mr-1"></i>ON:</span> Users can execute commands in server stdin
                        </div>
                        <div class="text-xs text-gray-400 mt-0.5">
                            <span class="text-yellow-400"><i class="fa-solid fa-minus mr-1"></i>OFF:</span> Users can only send text (appears in console but doesn't execute)
                        </div>
                    </div>
                    <% const consoleEnabled = config.console_commands === 'true' || config.console_commands === true; %>
                    <button type="button" onclick="toggleConsoleCommands(this)" 
                        data-enabled="<%= consoleEnabled %>"
                        class="w-12 h-6 rounded-full transition-colors duration-200 <%= consoleEnabled ? 'bg-orange-500' : 'bg-gray-600' %> relative">
                        <span class="absolute top-0.5 <%= consoleEnabled ? 'right-0.5' : 'left-0.5' %> w-5 h-5 bg-white rounded-full shadow transition-all duration-200"></span>
                    </button>
                    <input type="hidden" name="console_commands" id="consoleCommandsInput" value="<%= consoleEnabled ? 'true' : 'false' %>">
                </div>
                
                <input type="hidden" name="_console_settings" value="1">
                <button type="submit" class="bg-orange-600 px-6 py-3 rounded-xl font-bold hover:bg-orange-500 transition shadow-lg">
                    <i class="fa-solid fa-save mr-2"></i>Save Console Settings
                </button>
            </form>
            
            <script>
            function toggleConsoleCommands(btn) {
                const isEnabled = btn.dataset.enabled === 'true';
                const newState = !isEnabled;
                
                btn.dataset.enabled = newState;
                document.getElementById('consoleCommandsInput').value = newState ? 'true' : 'false';
                
                const dot = btn.querySelector('span');
                
                // Update button style
                if (newState) {
                    btn.classList.remove('bg-gray-600');
                    btn.classList.add('bg-orange-500');
                    dot.classList.remove('left-0.5');
                    dot.classList.add('right-0.5');
                } else {
                    btn.classList.remove('bg-orange-500');
                    btn.classList.add('bg-gray-600');
                    dot.classList.remove('right-0.5');
                    dot.classList.add('left-0.5');
                }
            }
            </script>
        </div>

        <!-- Payment Settings -->
        <div class="glass p-6 rounded-2xl">
            <h3 class="font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-credit-card text-green-400"></i>
                Payment Settings
            </h3>
            <form action="/admin/config" method="POST" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs text-gray-400 font-bold mb-2 block">Exchange Rate (1 USD = X Coins)</label>
                        <input type="number" name="credit_rate" value="<%= config.credit_rate || 100 %>" min="1"
                            class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                        <p class="text-xs text-gray-500 mt-1">How many coins per 1 USD</p>
                    </div>
                    <div>
                        <label class="text-xs text-gray-400 font-bold mb-2 block">Payment Bot ID</label>
                        <input type="text" name="payment_id" value="<%= config.payment_id || '' %>" placeholder="ProBot or other bot ID"
                            class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                        <p class="text-xs text-gray-500 mt-1">Bot ID for automated payments</p>
                    </div>
                </div>
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">Payment Channel ID</label>
                    <input type="text" name="payment_channel" value="<%= config.payment_channel || '' %>" placeholder="Discord channel ID for payment logs"
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                    <p class="text-xs text-gray-500 mt-1">Channel where payment notifications will be sent</p>
                </div>
                <div>
                    <label class="text-xs text-gray-400 font-bold mb-2 block">Minimum Deposit (Coins)</label>
                    <input type="number" name="min_deposit" value="<%= config.min_deposit || 10 %>" min="1"
                        class="w-full bg-black/40 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-indigo-500 transition">
                    <p class="text-xs text-gray-500 mt-1">Minimum coins for a deposit</p>
                </div>
                <button class="bg-green-600 px-6 py-3 rounded-xl font-bold hover:bg-green-500 transition shadow-lg">
                    <i class="fa-solid fa-save mr-2"></i>Save Payment Settings
                </button>
            </form>
        </div>

        <!-- Developer Tools -->
        <div class="glass p-6 rounded-2xl border border-red-500/20">
            <h3 class="font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-code text-red-400"></i>
                Developer Tools
                <span class="bg-red-500/20 text-red-400 px-2 py-0.5 rounded text-[10px] ml-2">DANGER ZONE</span>
            </h3>
            
            <div class="space-y-4">
                <!-- Maintenance Mode -->
                <div class="bg-white/5 p-4 rounded-xl flex items-center justify-between">
                    <div>
                        <div class="font-bold text-white">Maintenance Mode</div>
                        <div class="text-xs text-gray-400">Temporarily disable access for non-admin users</div>
                    </div>
                    <form action="/admin/dev" method="POST">
                        <button name="action" value="toggle_maint" 
                            class="<%= config.maintenance === 'true' ? 'bg-green-600 hover:bg-green-500' : 'bg-orange-600 hover:bg-orange-500' %> text-white px-4 py-2 rounded-lg font-bold transition">
                            <% if(config.maintenance === 'true') { %>
                            <i class="fa-solid fa-toggle-on mr-2"></i>Enabled
                            <% } else { %>
                            <i class="fa-solid fa-toggle-off mr-2"></i>Disabled
                            <% } %>
                        </button>
                    </form>
                </div>

                <!-- Reset All -->
                <div class="bg-red-500/10 p-4 rounded-xl border border-red-500/20">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="font-bold text-red-400">Reset Everything</div>
                            <div class="text-xs text-gray-400">Delete all users (except super admin) and servers</div>
                        </div>
                        <form action="/admin/dev" method="POST" onsubmit="return confirm('⚠️ WARNING: This will delete ALL users and servers! This action cannot be undone. Are you absolutely sure?')">
                            <button name="action" value="reset_all" class="bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-lg font-bold transition">
                                <i class="fa-solid fa-skull-crossbones mr-2"></i>Reset All
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>
