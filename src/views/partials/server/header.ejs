<% const navStyle = typeof serverNavStyle !== 'undefined' ? serverNavStyle : 'tabs'; %>

<!-- Suspended Banner -->
<% if(s.isSuspended) { %>
<div class="bg-red-600/20 border border-red-500/50 rounded-xl p-4 mb-4 flex items-center gap-3">
    <i class="fa-solid fa-ban text-red-500 text-2xl"></i>
    <div>
        <div class="font-bold text-red-400">Server Suspended</div>
        <div class="text-sm text-red-300/70">This server has been suspended by an administrator. You cannot start or restart it.</div>
    </div>
</div>
<% } %>

<% if (navStyle === 'tabs') { %>
<!-- ========== TABS STYLE ========== -->
<!-- Top Bar -->
<div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
    <div class="flex items-center gap-4 w-full">
        <a href="/dashboard" class="glass w-10 h-10 flex items-center justify-center rounded-xl hover:bg-white/10 transition">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold"><%= s.name %></h1>
            <div class="text-xs text-gray-400 font-mono"><%= s.startup_file %></div>
        </div>
    </div>
    
    <div class="flex gap-2 w-full md:w-auto">
        <% if(s.isSuspended) { %>
        <button disabled class="flex-1 md:flex-none bg-gray-600/20 text-gray-500 px-5 py-2 rounded-xl font-bold cursor-not-allowed flex items-center justify-center gap-2">
            <i class="fa-solid fa-play"></i> Start
        </button>
        <button disabled class="flex-1 md:flex-none bg-gray-600/20 text-gray-500 px-5 py-2 rounded-xl font-bold cursor-not-allowed flex items-center justify-center gap-2">
            <i class="fa-solid fa-rotate"></i> Restart
        </button>
        <button onclick="p('stop')" class="flex-1 md:flex-none bg-red-600/20 text-red-400 hover:bg-red-600 hover:text-white px-5 py-2 rounded-xl font-bold transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-stop"></i> Stop
        </button>
        <% } else { %>
        <button onclick="p('start')" class="flex-1 md:flex-none bg-green-600/20 text-green-400 hover:bg-green-600 hover:text-white px-5 py-2 rounded-xl font-bold transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-play"></i> Start
        </button>
        <button onclick="p('restart')" class="flex-1 md:flex-none bg-blue-600/20 text-blue-400 hover:bg-blue-600 hover:text-white px-5 py-2 rounded-xl font-bold transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-rotate"></i> Restart
        </button>
        <button onclick="p('stop')" class="flex-1 md:flex-none bg-red-600/20 text-red-400 hover:bg-red-600 hover:text-white px-5 py-2 rounded-xl font-bold transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-stop"></i> Stop
        </button>
        <% } %>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="flex gap-1 mb-6 border-b border-white/10 overflow-x-auto">
    <a href="/server/<%= s.id %>/" class="tab-link px-6 py-3 text-sm font-bold rounded-t-xl transition border-b-2 border-transparent text-gray-400 hover:text-white hover:border-gray-400">
        <i class="fa-solid fa-terminal mr-2"></i> Console
    </a>
    <a href="/server/<%= s.id %>/files" class="tab-link px-6 py-3 text-sm font-bold rounded-t-xl transition border-b-2 border-transparent text-gray-400 hover:text-white hover:border-gray-400">
        <i class="fa-solid fa-folder-open mr-2"></i> Files
    </a>
    <a href="/server/<%= s.id %>/backup" class="tab-link px-6 py-3 text-sm font-bold rounded-t-xl transition border-b-2 border-transparent text-gray-400 hover:text-white hover:border-gray-400">
        <i class="fa-solid fa-cloud-arrow-up mr-2"></i> Backup
    </a>
    <a href="/server/<%= s.id %>/startup" class="tab-link px-6 py-3 text-sm font-bold rounded-t-xl transition border-b-2 border-transparent text-gray-400 hover:text-white hover:border-gray-400">
        <i class="fa-solid fa-rocket mr-2"></i> Startup
    </a>
    <a href="/server/<%= s.id %>/resources" class="tab-link px-6 py-3 text-sm font-bold rounded-t-xl transition border-b-2 border-transparent text-gray-400 hover:text-white hover:border-gray-400">
        <i class="fa-solid fa-sliders mr-2"></i> Resources
    </a>
    <a href="/server/<%= s.id %>/settings" class="tab-link px-6 py-3 text-sm font-bold rounded-t-xl transition border-b-2 border-transparent text-gray-400 hover:text-white hover:border-gray-400">
        <i class="fa-solid fa-gear mr-2"></i> Settings
    </a>
    <a href="/server/<%= s.id %>/users" class="tab-link px-6 py-3 text-sm font-bold rounded-t-xl transition border-b-2 border-transparent text-gray-400 hover:text-white hover:border-gray-400">
        <i class="fa-solid fa-users mr-2"></i> Users
    </a>
</div>

<% } else { %>
<!-- ========== SIDEBAR STYLE ========== -->
<!-- Power Controls Only (no back button, sidebar has it) -->
<div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
    <div>
        <h1 class="text-2xl font-bold"><%= s.name %></h1>
        <div class="text-xs text-gray-400 font-mono"><%= s.startup_file %></div>
    </div>
    
    <div class="flex gap-2 w-full md:w-auto">
        <% if(s.isSuspended) { %>
        <button disabled class="flex-1 md:flex-none bg-gray-600/20 text-gray-500 px-5 py-2 rounded-xl font-bold cursor-not-allowed flex items-center justify-center gap-2">
            <i class="fa-solid fa-play"></i> Start
        </button>
        <button disabled class="flex-1 md:flex-none bg-gray-600/20 text-gray-500 px-5 py-2 rounded-xl font-bold cursor-not-allowed flex items-center justify-center gap-2">
            <i class="fa-solid fa-rotate"></i> Restart
        </button>
        <button onclick="p('stop')" class="flex-1 md:flex-none bg-red-600/20 text-red-400 hover:bg-red-600 hover:text-white px-5 py-2 rounded-xl font-bold transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-stop"></i> Stop
        </button>
        <% } else { %>
        <button onclick="p('start')" class="flex-1 md:flex-none bg-green-600/20 text-green-400 hover:bg-green-600 hover:text-white px-5 py-2 rounded-xl font-bold transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-play"></i> Start
        </button>
        <button onclick="p('restart')" class="flex-1 md:flex-none bg-blue-600/20 text-blue-400 hover:bg-blue-600 hover:text-white px-5 py-2 rounded-xl font-bold transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-rotate"></i> Restart
        </button>
        <button onclick="p('stop')" class="flex-1 md:flex-none bg-red-600/20 text-red-400 hover:bg-red-600 hover:text-white px-5 py-2 rounded-xl font-bold transition flex items-center justify-center gap-2">
            <i class="fa-solid fa-stop"></i> Stop
        </button>
        <% } %>
    </div>
</div>
<% } %>

<script>
    // Highlight the current tab/sidebar item based on URL
    const currentPath = window.location.pathname;
    document.querySelectorAll('.tab-link, .sidebar-nav-item').forEach(link => {
        if (currentPath === link.getAttribute('href')) {
            link.classList.remove('text-gray-400', 'hover:text-white', 'hover:border-gray-400');
            link.classList.add('border-b-2', 'border-indigo-500', 'text-white');
        }
    });
</script>

<style>
    .custom-scroll::-webkit-scrollbar { width:6px; background:#111; }
    .custom-scroll::-webkit-scrollbar-thumb { background:#333; border-radius:3px; }
    .CodeMirror { height:100% !important; border-radius:0.5rem; }
</style>
