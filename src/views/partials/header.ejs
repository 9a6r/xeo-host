<% 
const isServerPage = typeof s !== 'undefined';
const navStyle = typeof serverNavStyle !== 'undefined' ? serverNavStyle : 'tabs';
const showServerSidebar = isServerPage && navStyle === 'sidebar';
%>
<!DOCTYPE html>
<html class="dark">
<head>
    <title><%= sitename %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

    <link rel="icon" type="image/png" href="<%= siteLogo %>">
    <% if (typeof siteLogo !== 'undefined' && siteLogo) { %>
    <link rel="apple-touch-icon" href="<%= siteLogo %>">
    <% } %>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/theme/dracula.min.css">
    <style>
        body { background-color: #050505; color: #fff; font-family: sans-serif; }
        .glass { background: rgba(20, 20, 25, 0.9); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.05); }
        .sidebar-link.active { background: linear-gradient(90deg, rgba(99,102,241,0.2), transparent); border-left: 3px solid #6366f1; }
        
        /* Mobile Slide Animation */
        #mobile-menu, #server-sidebar { transition: transform 0.3s ease-in-out; }
        .slide-in { transform: translateX(0); }
        .slide-out { transform: translateX(-100%); }

        /* Server Sidebar Styles */
        .server-sidebar-item.active {
            background: linear-gradient(90deg, rgba(99, 102, 241, 0.2), transparent);
            border-left: 3px solid #6366f1;
            color: #fff;
        }

        /* Custom Scrollbar */
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        /* Line clamp utility */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Safe area for mobile */
        .safe-area-top {
            padding-top: max(1rem, env(safe-area-inset-top));
        }
        .safe-area-bottom {
            padding-bottom: max(1rem, env(safe-area-inset-bottom));
        }

        /* Notification bell animation */
        @keyframes bellRing {
            0%, 100% { transform: rotate(0); }
            10%, 30%, 50% { transform: rotate(10deg); }
            20%, 40% { transform: rotate(-10deg); }
            60% { transform: rotate(0); }
        }
        .notification-bell:hover i {
            animation: bellRing 0.5s ease-in-out;
        }
    </style>
    <%# Theme CSS %>
    <% if (typeof themeCSS !== 'undefined' && themeCSS) { %>
    <style id="theme-css"><%- themeCSS %></style>
    <% } %>
    <%# Plugin Styles %>
    <% if (typeof pluginStyles !== 'undefined' && pluginStyles) { %>
    <%- pluginStyles %>
    <% } %>
</head>
<body class="bg-black flex h-screen overflow-hidden">
    
    <% if(user) { %>
    
    <% if (showServerSidebar) { %>
    <!-- ========== SERVER SIDEBAR MODE ========== -->
    <!-- Mobile Top Bar for Server -->
    <div class="md:hidden fixed top-0 w-full glass z-50 flex justify-between items-center p-4 border-b border-white/10">
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-server text-indigo-400"></i>
            <h1 class="font-bold text-lg"><%= s.name %></h1>
        </div>
        <button onclick="toggleServerSidebar()" class="text-white text-xl"><i class="fa-solid fa-bars"></i></button>
    </div>

    <!-- Server Sidebar -->
    <aside id="server-sidebar" class="fixed inset-y-0 left-0 w-64 glass z-50 slide-out md:static md:translate-x-0 md:flex flex-col border-r border-white/5">
        <div class="p-6 border-b border-white/5">
            <h1 class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-500">Server</h1>
            <div class="text-xs text-gray-400 mt-1 flex items-center gap-2">
                <i class="fa-solid fa-server"></i>
                <span class="truncate"><%= s.name %></span>
            </div>
        </div>
        
        <!-- Mobile Close -->
        <div class="md:hidden p-4 flex justify-end border-b border-white/5">
            <button onclick="toggleServerSidebar()" class="text-gray-400"><i class="fa-solid fa-xmark text-2xl"></i></button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
            <a href="/server/<%= s.id %>/" class="server-sidebar-item flex items-center p-3 rounded-xl hover:bg-white/5 transition text-gray-300 hover:text-white">
                <i class="fa-solid fa-terminal w-8 text-center text-red-400"></i> Console
            </a>
            <a href="/server/<%= s.id %>/files" class="server-sidebar-item flex items-center p-3 rounded-xl hover:bg-white/5 transition text-gray-300 hover:text-white">
                <i class="fa-solid fa-folder-open w-8 text-center"></i> Files
            </a>
            <a href="/server/<%= s.id %>/backup" class="server-sidebar-item flex items-center p-3 rounded-xl hover:bg-white/5 transition text-gray-300 hover:text-white">
                <i class="fa-solid fa-cloud-arrow-up w-8 text-center"></i> Backup
            </a>
            <a href="/server/<%= s.id %>/startup" class="server-sidebar-item flex items-center p-3 rounded-xl hover:bg-white/5 transition text-gray-300 hover:text-white">
                <i class="fa-solid fa-rocket w-8 text-center"></i> Startup
            </a>
            <a href="/server/<%= s.id %>/resources" class="server-sidebar-item flex items-center p-3 rounded-xl hover:bg-indigo-500/10 transition text-gray-300 hover:text-indigo-400">
                <i class="fa-solid fa-sliders w-8 text-center"></i> Resources
            </a>
            <a href="/server/<%= s.id %>/settings" class="server-sidebar-item flex items-center p-3 rounded-xl hover:bg-white/5 transition text-gray-300 hover:text-white">
                <i class="fa-solid fa-gear w-8 text-center"></i> Settings
            </a>
            <a href="/server/<%= s.id %>/users" class="server-sidebar-item flex items-center p-3 rounded-xl hover:bg-white/5 transition text-gray-300 hover:text-white">
                <i class="fa-solid fa-users w-8 text-center"></i> Users
            </a>
        </nav>

        <div class="p-4 border-t border-white/5 bg-black/20">
            <a href="/dashboard" class="flex items-center gap-3 p-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition">
                <i class="fa-solid fa-arrow-left w-8 text-center"></i>
                Back to Dashboard
            </a>
        </div>
    </aside>

    <!-- Backdrop for Server Sidebar -->
    <div id="server-backdrop" onclick="toggleServerSidebar()" class="fixed inset-0 bg-black/80 z-40 hidden md:hidden backdrop-blur-sm"></div>

    <script>
        function toggleServerSidebar() {
            const menu = document.getElementById('server-sidebar');
            const drop = document.getElementById('server-backdrop');
            if (menu.classList.contains('slide-out')) {
                menu.classList.remove('slide-out');
                menu.classList.add('slide-in');
                drop.classList.remove('hidden');
            } else {
                menu.classList.add('slide-out');
                menu.classList.remove('slide-in');
                drop.classList.add('hidden');
            }
        }
        // Highlight active sidebar item
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname;
            document.querySelectorAll('.server-sidebar-item').forEach(link => {
                if (currentPath === link.getAttribute('href')) {
                    link.classList.add('active');
                }
            });
        });
    </script>

    <% } else { %>
    <!-- ========== NORMAL SIDEBAR MODE ========== -->
    <!-- MOBILE TOP BAR -->
    <div class="md:hidden fixed top-0 w-full bg-[#0a0a0f]/95 backdrop-blur-xl z-50 flex justify-between items-center px-4 py-3 border-b border-white/5">
        <a href="/dashboard" class="flex items-center gap-3">
            <% if (typeof siteLogo !== 'undefined' && siteLogo) { %>
            <img src="<%= siteLogo %>" alt="<%= sitename %>" class="h-9 w-9 rounded-xl object-contain">
            <% } else { %>
            <div class="w-9 h-9 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center">
                <i class="fa-solid fa-cube text-white text-sm"></i>
            </div>
            <% } %>
            <span class="font-bold text-white"><%= sitename %></span>
        </a>
        <button onclick="toggleSidebar()" class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 text-white">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <!-- SIDEBAR -->
    <aside id="mobile-menu" class="fixed inset-y-0 left-0 bg-[#0a0a0f] z-50 -translate-x-full md:translate-x-0 md:static flex flex-col border-r border-white/5 transition-all duration-300 user-sidebar-expanded">
        <!-- Logo Section -->
        <div class="p-3 hidden md:flex items-center justify-between user-logo-section">
            <a href="/dashboard" class="flex items-center gap-3 sidebar-logo-full flex-1 min-w-0">
                <% if (typeof siteLogo !== 'undefined' && siteLogo) { %>
                <img src="<%= siteLogo %>" alt="<%= sitename %>" class="h-10 w-10 rounded-xl object-contain flex-shrink-0">
                <% } else { %>
                <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/20 flex-shrink-0">
                    <i class="fa-solid fa-cube text-white"></i>
                </div>
                <% } %>
                <div class="sidebar-text min-w-0">
                    <div class="font-bold text-white truncate"><%= sitename %></div>
                    <div class="text-[10px] text-gray-500">Dashboard</div>
                </div>
            </a>
            <button onclick="toggleUserSidebarCollapse()" class="w-8 h-8 rounded-lg bg-white/5 hover:bg-white/10 flex items-center justify-center text-gray-400 hover:text-white transition sidebar-collapse-btn flex-shrink-0 ml-2">
                <i class="fa-solid fa-chevron-left text-xs transition-transform duration-300"></i>
            </button>
        </div>
        
        <!-- Mobile Close -->
        <div class="md:hidden p-4 flex justify-between items-center border-b border-white/5">
            <span class="font-bold text-white">Navigation</span>
            <button onclick="toggleSidebar()" class="w-8 h-8 flex items-center justify-center rounded-lg bg-white/5 text-gray-400 hover:text-white">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 px-2 py-4 overflow-y-auto custom-scrollbar">
            <!-- Main Section -->
            <div class="mb-4">
                <div class="px-3 mb-2 text-[10px] font-bold text-gray-500 uppercase tracking-wider sidebar-text">Main</div>
                
                <a href="/dashboard" class="sidebar-link user-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 text-gray-400 hover:bg-white/5 hover:text-white" title="Dashboard">
                    <div class="w-9 h-9 rounded-lg bg-indigo-500/10 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-th-large text-sm text-indigo-400"></i>
                    </div>
                    <span class="font-medium sidebar-text">Dashboard</span>
                </a>

                <a href="/wallet" class="sidebar-link user-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 text-gray-400 hover:bg-white/5 hover:text-white" title="Wallet">
                    <div class="w-9 h-9 rounded-lg bg-yellow-500/10 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-wallet text-sm text-yellow-400"></i>
                    </div>
                    <span class="font-medium sidebar-text">Wallet</span>
                </a>
            </div>

            <!-- Services Section -->
            <div class="mb-4">
                <div class="px-3 mb-2 text-[10px] font-bold text-gray-500 uppercase tracking-wider sidebar-text">Services</div>
                
                <a href="/store" class="sidebar-link user-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 text-gray-400 hover:bg-white/5 hover:text-white" title="Store">
                    <div class="w-9 h-9 rounded-lg bg-green-500/10 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-store text-sm text-green-400"></i>
                    </div>
                    <span class="font-medium sidebar-text">Store</span>
                </a>

                <a href="/afk" class="sidebar-link user-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 text-gray-400 hover:bg-white/5 hover:text-white" title="AFK Rewards">
                    <div class="w-9 h-9 rounded-lg bg-cyan-500/10 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-coins text-sm text-cyan-400"></i>
                    </div>
                    <span class="font-medium sidebar-text">AFK Rewards</span>
                </a>

                <a href="/activity" class="sidebar-link user-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 text-gray-400 hover:bg-white/5 hover:text-white" title="Activity">
                    <div class="w-9 h-9 rounded-lg bg-purple-500/10 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-clock-rotate-left text-sm text-purple-400"></i>
                    </div>
                    <span class="font-medium sidebar-text">Activity</span>
                </a>
            </div>

            <!-- Support Section -->
            <div class="mb-4">
                <div class="px-3 mb-2 text-[10px] font-bold text-gray-500 uppercase tracking-wider sidebar-text">Support</div>
                
                <a href="/tickets" class="sidebar-link user-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 text-gray-400 hover:bg-white/5 hover:text-white" title="Support Tickets">
                    <div class="w-9 h-9 rounded-lg bg-orange-500/10 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-headset text-sm text-orange-400"></i>
                    </div>
                    <span class="font-medium sidebar-text">Support</span>
                </a>
            </div>

            <% if(user.isAdmin) { %>
            <!-- Admin Section -->
            <div class="mb-4">
                <div class="px-3 mb-2 text-[10px] font-bold text-gray-500 uppercase tracking-wider sidebar-text">Admin</div>
                
                <a href="/admin" class="sidebar-link user-nav-link flex items-center gap-3 px-2 py-2 rounded-xl transition mb-1 text-gray-400 hover:bg-white/5 hover:text-white" title="Admin Panel">
                    <div class="w-9 h-9 rounded-lg bg-red-500/10 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-shield-halved text-sm text-red-400"></i>
                    </div>
                    <span class="font-medium sidebar-text">Admin Panel</span>
                </a>
            </div>
            <% } %>
        </nav>

        <!-- Footer / User Info -->
        <div class="p-2 border-t border-white/5">
            <!-- User Info -->
            <div class="flex items-center gap-3 px-2 py-2 mb-2 rounded-xl bg-white/5 user-info-box">
                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" 
                     class="w-9 h-9 rounded-lg flex-shrink-0" 
                     onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
                <div class="flex-1 min-w-0 sidebar-text">
                    <div class="text-sm font-medium text-white truncate"><%= user.username %></div>
                    <div class="text-[10px] text-yellow-400 font-bold"><%= user.coins %> Coins</div>
                </div>
            </div>
            
            <!-- Logout Button -->
            <a href="/logout" class="user-nav-link flex items-center justify-center gap-2 px-2 py-2 rounded-xl bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white transition text-sm font-bold" title="Logout">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span class="sidebar-text">Logout</span>
            </a>
        </div>
    </aside>

    <!-- BACKDROP -->
    <div id="backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-black/80 z-40 hidden md:hidden backdrop-blur-sm"></div>

    <style>
        .user-sidebar-expanded { width: 260px; }
        .user-sidebar-collapsed { width: 70px; }
        .user-sidebar-collapsed .sidebar-text { display: none; }
        .user-sidebar-collapsed .sidebar-logo-full { flex: 0; }
        .user-sidebar-collapsed .sidebar-collapse-btn i { transform: rotate(180deg); }
        .user-sidebar-collapsed .sidebar-collapse-btn { margin-left: 0; }
        .user-sidebar-collapsed .user-nav-link { justify-content: center; padding-left: 0; padding-right: 0; }
        .user-sidebar-collapsed .user-info-box { justify-content: center; padding: 0.5rem; }
        .user-sidebar-collapsed .user-info-box img { margin: 0; }
        .user-sidebar-collapsed .user-logo-section { justify-content: center; padding: 0.75rem; }
        
        /* Prevent transition on page load */
        .no-transition { transition: none !important; }
        
        @media (max-width: 768px) {
            .user-sidebar-expanded, .user-sidebar-collapsed { width: 260px; }
            .user-sidebar-collapsed .sidebar-text { display: block; }
            .user-sidebar-collapsed .user-nav-link { justify-content: flex-start; padding-left: 0.5rem; padding-right: 0.5rem; }
            .user-sidebar-collapsed .sidebar-logo-full { flex: 1; }
        }
    </style>

    <script data-turbo-permanent id="sidebar-functions">
        function toggleSidebar() {
            const menu = document.getElementById('mobile-menu');
            const drop = document.getElementById('backdrop');
            if (menu.classList.contains('-translate-x-full')) {
                menu.classList.remove('-translate-x-full');
                menu.classList.add('translate-x-0');
                drop.classList.remove('hidden');
            } else {
                menu.classList.add('-translate-x-full');
                menu.classList.remove('translate-x-0');
                drop.classList.add('hidden');
            }
        }
        
        function toggleUserSidebarCollapse() {
            const sidebar = document.getElementById('mobile-menu');
            const isCollapsed = sidebar.classList.contains('user-sidebar-collapsed');
            
            if (isCollapsed) {
                sidebar.classList.remove('user-sidebar-collapsed');
                sidebar.classList.add('user-sidebar-expanded');
                localStorage.setItem('userSidebarCollapsed', 'false');
            } else {
                sidebar.classList.remove('user-sidebar-expanded');
                sidebar.classList.add('user-sidebar-collapsed');
                localStorage.setItem('userSidebarCollapsed', 'true');
            }
        }
        
        function initSidebar() {
            const sidebar = document.getElementById('mobile-menu');
            if (!sidebar) return;
            
            const isCollapsed = localStorage.getItem('userSidebarCollapsed') === 'true';
            
            if (isCollapsed && window.innerWidth >= 768) {
                sidebar.classList.remove('user-sidebar-expanded');
                sidebar.classList.add('user-sidebar-collapsed');
            } else if (window.innerWidth >= 768) {
                sidebar.classList.remove('user-sidebar-collapsed');
                sidebar.classList.add('user-sidebar-expanded');
            }
            
            // Update active link
            const currentPath = window.location.pathname;
            document.querySelectorAll('.sidebar-link').forEach(link => {
                const href = link.getAttribute('href');
                // Reset all links first
                link.classList.remove('bg-gradient-to-r', 'from-indigo-600', 'to-indigo-500', 'text-white', 'shadow-lg', 'shadow-indigo-500/20');
                link.classList.add('text-gray-400', 'hover:bg-white/5', 'hover:text-white');
                const iconDiv = link.querySelector('div');
                if (iconDiv) {
                    iconDiv.classList.remove('bg-white/20');
                }
                
                // Highlight active
                if (currentPath === href || (href !== '/dashboard' && currentPath.startsWith(href))) {
                    link.classList.remove('text-gray-400', 'hover:bg-white/5', 'hover:text-white');
                    link.classList.add('bg-gradient-to-r', 'from-indigo-600', 'to-indigo-500', 'text-white', 'shadow-lg', 'shadow-indigo-500/20');
                    if (iconDiv) {
                        iconDiv.classList.remove('bg-indigo-500/10', 'bg-yellow-500/10', 'bg-green-500/10', 'bg-cyan-500/10', 'bg-purple-500/10', 'bg-orange-500/10', 'bg-red-500/10');
                        iconDiv.classList.add('bg-white/20');
                    }
                    const icon = link.querySelector('i');
                    if (icon) {
                        icon.className = icon.className.replace(/text-\w+-400/g, 'text-white');
                    }
                }
            });
        }
        
        // Run on initial load and Turbo navigation
        document.addEventListener('DOMContentLoaded', initSidebar);
        document.addEventListener('turbo:load', initSidebar);
        document.addEventListener('turbo:render', initSidebar);
    </script>
    <% } %>
    
    <% } %>

    <main class="flex-1 overflow-y-auto relative w-full pt-16 md:pt-0">
        <div class="p-4 md:p-10 max-w-7xl mx-auto">