<%- include('./partials/header') %>

<div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div>
            <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-400">
                <i class="fa-solid fa-headset mr-3"></i>Support Tickets
            </h2>
            <p class="text-gray-400 mt-1">Get help from our support team</p>
        </div>
        <button onclick="openNewTicketModal()" class="bg-gradient-to-r from-orange-600 to-red-600 hover:from-orange-500 hover:to-red-500 px-6 py-3 rounded-xl font-bold transition shadow-lg flex items-center gap-2">
            <i class="fa-solid fa-plus"></i>
            New Ticket
        </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="glass p-4 rounded-xl text-center">
            <div class="text-2xl font-bold text-green-400"><%= tickets.filter(t => t.status === 'open').length %></div>
            <div class="text-xs text-gray-400">Open</div>
        </div>
        <div class="glass p-4 rounded-xl text-center">
            <div class="text-2xl font-bold text-yellow-400"><%= tickets.filter(t => t.status === 'pending').length %></div>
            <div class="text-xs text-gray-400">Pending</div>
        </div>
        <div class="glass p-4 rounded-xl text-center">
            <div class="text-2xl font-bold text-gray-400"><%= tickets.filter(t => t.status === 'closed').length %></div>
            <div class="text-xs text-gray-400">Closed</div>
        </div>
        <div class="glass p-4 rounded-xl text-center">
            <div class="text-2xl font-bold text-white"><%= tickets.length %></div>
            <div class="text-xs text-gray-400">Total</div>
        </div>
    </div>

    <!-- Alert Messages -->
    <% if(typeof message !== 'undefined' && message) { %>
    <div class="mb-6 p-4 rounded-xl <%= message.type === 'success' ? 'bg-green-500/20 border border-green-500/30 text-green-400' : 'bg-red-500/20 border border-red-500/30 text-red-400' %>">
        <i class="fa-solid <%= message.type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle' %> mr-2"></i>
        <%= message.text %>
    </div>
    <% } %>

    <!-- Tickets List -->
    <% if(tickets.length === 0) { %>
    <div class="glass p-12 rounded-2xl text-center">
        <i class="fa-solid fa-ticket text-6xl text-gray-600 mb-4"></i>
        <h3 class="text-xl font-bold text-gray-400 mb-2">No Tickets Yet</h3>
        <p class="text-gray-500 mb-6">You haven't created any support tickets</p>
        <button onclick="openNewTicketModal()" class="bg-orange-600 hover:bg-orange-500 px-6 py-3 rounded-xl font-bold transition">
            <i class="fa-solid fa-plus mr-2"></i>Create Your First Ticket
        </button>
    </div>
    <% } else { %>
    <div class="space-y-4">
        <% tickets.forEach(ticket => { %>
        <a href="/tickets/<%= ticket.id %>" class="glass p-5 rounded-xl block hover:border-orange-500/30 transition group">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-start gap-4">
                    <!-- Status Icon -->
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center <%= 
                        ticket.status === 'open' ? 'bg-green-600/20' : 
                        ticket.status === 'pending' ? 'bg-yellow-600/20' : 'bg-gray-600/20' 
                    %>">
                        <i class="fa-solid <%= 
                            ticket.status === 'open' ? 'fa-envelope-open text-green-400' : 
                            ticket.status === 'pending' ? 'fa-clock text-yellow-400' : 'fa-check text-gray-400' 
                        %> text-xl"></i>
                    </div>
                    <div class="flex-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="font-bold text-white group-hover:text-orange-400 transition"><%= ticket.subject %></h3>
                            <!-- Priority Badge -->
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= 
                                ticket.priority === 'urgent' ? 'bg-red-500/20 text-red-400' : 
                                ticket.priority === 'high' ? 'bg-orange-500/20 text-orange-400' : 
                                ticket.priority === 'medium' ? 'bg-yellow-500/20 text-yellow-400' : 'bg-gray-500/20 text-gray-400' 
                            %>"><%= ticket.priority %></span>
                            <!-- Category Badge -->
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-indigo-500/20 text-indigo-400"><%= ticket.category %></span>
                        </div>
                        <div class="text-sm text-gray-400 mt-1">
                            <span class="text-gray-500">#<%= ticket.id %></span>
                            <span class="mx-2">•</span>
                            <span><%= ticket.message_count %> messages</span>
                            <span class="mx-2">•</span>
                            <span>Updated <%= new Date(ticket.updated_at).toLocaleDateString() %></span>
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <!-- Status Badge -->
                    <span class="px-3 py-1 rounded-lg text-xs font-bold uppercase <%= 
                        ticket.status === 'open' ? 'bg-green-500/20 text-green-400 border border-green-500/30' : 
                        ticket.status === 'pending' ? 'bg-yellow-500/20 text-yellow-400 border border-yellow-500/30' : 
                        'bg-gray-500/20 text-gray-400 border border-gray-500/30' 
                    %>"><%= ticket.status %></span>
                    <i class="fa-solid fa-chevron-right text-gray-500 group-hover:text-orange-400 transition"></i>
                </div>
            </div>
        </a>
        <% }) %>
    </div>
    <% } %>
</div>

<!-- New Ticket Modal -->
<div id="newTicketModal" class="hidden fixed inset-0 bg-black/90 backdrop-blur-md flex items-center justify-center z-50 p-4">
    <div class="glass bg-[#151515] p-6 md:p-8 rounded-3xl w-full max-w-lg border border-white/10 shadow-2xl max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-2xl font-bold text-white">
                <i class="fa-solid fa-ticket text-orange-400 mr-2"></i>New Ticket
            </h3>
            <button onclick="closeNewTicketModal()" class="text-gray-400 hover:text-white transition">
                <i class="fa-solid fa-times text-xl"></i>
            </button>
        </div>
        
        <form action="/tickets/create" method="POST" class="space-y-4">
            <!-- Subject -->
            <div>
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Subject</label>
                <input name="subject" class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-orange-500 mt-2 transition" placeholder="Brief description of your issue" required maxlength="100">
            </div>
            
            <!-- Category -->
            <div>
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Category</label>
                <select name="category" class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-orange-500 mt-2 transition">
                    <option value="general">General Question</option>
                    <option value="technical">Technical Issue</option>
                    <option value="billing">Billing & Payments</option>
                    <option value="account">Account Issue</option>
                    <option value="bug">Bug Report</option>
                    <option value="feature">Feature Request</option>
                    <option value="other">Other</option>
                </select>
            </div>
            
            <!-- Priority -->
            <div>
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Priority</label>
                <select name="priority" class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-orange-500 mt-2 transition">
                    <option value="low">Low - General inquiry</option>
                    <option value="medium" selected>Medium - Need help soon</option>
                    <option value="high">High - Affecting my work</option>
                    <option value="urgent">Urgent - Critical issue</option>
                </select>
            </div>
            
            <!-- Message -->
            <div>
                <label class="text-xs font-bold text-gray-500 uppercase ml-1">Message</label>
                <textarea name="message" rows="5" class="w-full bg-black/50 border border-white/10 rounded-xl p-3 text-white outline-none focus:border-orange-500 mt-2 transition resize-none" placeholder="Describe your issue in detail..." required></textarea>
            </div>
            
            <div class="flex gap-3 pt-2">
                <button type="button" onclick="closeNewTicketModal()" class="flex-1 bg-transparent hover:bg-white/5 py-3 rounded-xl font-bold text-gray-400 transition border border-white/10">
                    Cancel
                </button>
                <button type="submit" class="flex-1 bg-gradient-to-r from-orange-600 to-red-600 hover:from-orange-500 hover:to-red-500 py-3 rounded-xl font-bold transition shadow-lg">
                    <i class="fa-solid fa-paper-plane mr-2"></i>Submit Ticket
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function openNewTicketModal() {
    document.getElementById('newTicketModal').classList.remove('hidden');
}

function closeNewTicketModal() {
    document.getElementById('newTicketModal').classList.add('hidden');
}

// Close modal on escape key
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeNewTicketModal();
});

// Close modal on backdrop click
document.getElementById('newTicketModal').addEventListener('click', (e) => {
    if (e.target.id === 'newTicketModal') closeNewTicketModal();
});
</script>

<%- include('./partials/footer') %>
