<!DOCTYPE html>
<html class="dark">
<head>
    <title>Login | <%= sitename %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% if (typeof siteLogo !== 'undefined' && siteLogo) { %>
    <link rel="icon" type="image/png" href="<%= siteLogo %>">
    <link rel="apple-touch-icon" href="<%= siteLogo %>">
    <% } %>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #020617; font-family: sans-serif; min-height: 100vh; }
        .hero-gradient { background: radial-gradient(circle at center, #1e1b4b 0%, #020617 70%); }
        .glass { background: rgba(255,255,255,0.05); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); }
        .floating { animation: float 6s ease-in-out infinite; }
        @keyframes float { 0% { transform: translateY(0px); } 50% { transform: translateY(-12px); } 100% { transform: translateY(0px); } }
    </style>
</head>
<body class="hero-gradient text-white min-h-screen flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 pointer-events-none"></div>

    <div class="glass p-8 rounded-3xl max-w-md w-full relative z-10 shadow-2xl border border-indigo-500/20">
        <div class="text-center mb-6">
            <div class="mb-3 inline-block p-3.5 rounded-full bg-indigo-600/20 text-indigo-400 floating">
                <i class="fa-solid fa-bolt text-3xl"></i>
            </div>
            <h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-purple-400"><%= sitename %></h1>
            <p class="text-gray-400 mt-1 text-xs">سجل دخولك أو أنشئ حساباً جديداً في ثوانٍ بدون إيميل أو رقم هاتف</p>
        </div>

        <!-- Tabs: Login / Register -->
        <div class="grid grid-cols-2 gap-2 p-1 bg-black/40 rounded-xl mb-6 border border-white/10">
            <button type="button" id="tabLogin" onclick="switchMode('login')" class="py-2.5 rounded-lg text-sm font-bold transition">
                <i class="fa-solid fa-right-to-bracket mr-1"></i> تسجيل الدخول
            </button>
            <button type="button" id="tabRegister" onclick="switchMode('register')" class="py-2.5 rounded-lg text-sm font-bold transition">
                <i class="fa-solid fa-user-plus mr-1"></i> حساب جديد
            </button>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-4 p-3 rounded-xl bg-red-500/20 border border-red-500/40 text-red-300 text-xs text-center flex items-center justify-center gap-2">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span><%= error %></span>
        </div>
        <% } %>

        <!-- Login Form -->
        <form id="loginForm" action="/auth/local/login" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs text-gray-400 mb-1 font-medium">اسم المستخدم (Username)</label>
                <div class="relative">
                    <i class="fa-solid fa-user absolute left-3.5 top-3.5 text-gray-500 text-sm"></i>
                    <input type="text" name="username" required placeholder="أدخل اسم المستخدم" class="w-full bg-black/40 border border-white/10 rounded-xl py-3 pl-10 pr-4 text-sm text-white focus:border-indigo-500 outline-none transition">
                </div>
            </div>
            <div>
                <label class="block text-xs text-gray-400 mb-1 font-medium">كلمة المرور (Password)</label>
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-gray-500 text-sm"></i>
                    <input type="password" name="password" required placeholder="أدخل كلمة المرور" class="w-full bg-black/40 border border-white/10 rounded-xl py-3 pl-10 pr-4 text-sm text-white focus:border-indigo-500 outline-none transition">
                </div>
            </div>
            <button type="submit" class="w-full bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold py-3.5 rounded-xl transition shadow-lg flex items-center justify-center gap-2">
                <i class="fa-solid fa-right-to-bracket"></i>
                <span>دخول إلى اللوحة</span>
            </button>
        </form>

        <!-- Register Form -->
        <form id="registerForm" action="/auth/local/register" method="POST" class="space-y-4 hidden">
            <div>
                <label class="block text-xs text-gray-400 mb-1 font-medium">اختر اسم مستخدم (Username)</label>
                <div class="relative">
                    <i class="fa-solid fa-user-plus absolute left-3.5 top-3.5 text-gray-500 text-sm"></i>
                    <input type="text" name="username" required minlength="3" maxlength="24" placeholder="مثال: ahmed_dev" class="w-full bg-black/40 border border-white/10 rounded-xl py-3 pl-10 pr-4 text-sm text-white focus:border-indigo-500 outline-none transition">
                </div>
            </div>
            <div>
                <label class="block text-xs text-gray-400 mb-1 font-medium">كلمة المرور (Password)</label>
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-3.5 top-3.5 text-gray-500 text-sm"></i>
                    <input type="password" name="password" required minlength="4" placeholder="4 أحرف أو أرقام على الأقل" class="w-full bg-black/40 border border-white/10 rounded-xl py-3 pl-10 pr-4 text-sm text-white focus:border-indigo-500 outline-none transition">
                </div>
            </div>
            <div>
                <label class="block text-xs text-gray-400 mb-1 font-medium">تأكيد كلمة المرور (Confirm Password)</label>
                <div class="relative">
                    <i class="fa-solid fa-shield-halved absolute left-3.5 top-3.5 text-gray-500 text-sm"></i>
                    <input type="password" name="confirm_password" required minlength="4" placeholder="أعد كتابة كلمة المرور" class="w-full bg-black/40 border border-white/10 rounded-xl py-3 pl-10 pr-4 text-sm text-white focus:border-indigo-500 outline-none transition">
                </div>
            </div>
            <button type="submit" class="w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold py-3.5 rounded-xl transition shadow-lg flex items-center justify-center gap-2">
                <i class="fa-solid fa-user-check"></i>
                <span>إنشاء حساب والبدء فوراً</span>
            </button>
        </form>

        <!-- Divider -->
        <div class="relative flex py-5 items-center">
            <div class="flex-grow border-t border-white/10"></div>
            <span class="flex-shrink mx-3 text-gray-500 text-xs">أو عبر الديسكورد</span>
            <div class="flex-grow border-t border-white/10"></div>
        </div>

        <a href="/auth/discord" class="block w-full bg-[#5865F2] hover:bg-[#4752C4] text-white font-bold py-3.5 rounded-xl transition transform hover:scale-[1.01] shadow-lg flex items-center justify-center gap-3 text-sm">
            <i class="fa-brands fa-discord text-lg"></i> Login with Discord
        </a>
    </div>

    <script>
        function switchMode(mode) {
            var loginForm = document.getElementById('loginForm');
            var registerForm = document.getElementById('registerForm');
            var tabLogin = document.getElementById('tabLogin');
            var tabRegister = document.getElementById('tabRegister');

            if (mode === 'register') {
                loginForm.classList.add('hidden');
                registerForm.classList.remove('hidden');
                tabRegister.className = 'py-2.5 rounded-lg text-sm font-bold transition bg-indigo-600 text-white shadow';
                tabLogin.className = 'py-2.5 rounded-lg text-sm font-bold transition text-gray-400 hover:text-white';
            } else {
                registerForm.classList.add('hidden');
                loginForm.classList.remove('hidden');
                tabLogin.className = 'py-2.5 rounded-lg text-sm font-bold transition bg-indigo-600 text-white shadow';
                tabRegister.className = 'py-2.5 rounded-lg text-sm font-bold transition text-gray-400 hover:text-white';
            }
        }
        switchMode('<%= typeof mode !== "undefined" && mode === "register" ? "register" : "login" %>');
    </script>
</body>
</html>


