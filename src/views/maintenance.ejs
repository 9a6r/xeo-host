<!DOCTYPE html>
<html class="dark">
<head>
    <title>Under Maintenance</title>
    <% if (typeof siteLogo !== 'undefined' && siteLogo) { %>
    <link rel="icon" type="image/png" href="<%= siteLogo %>">
    <link rel="apple-touch-icon" href="<%= siteLogo %>">
    <% } %>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>body { background-color: #020617; color: white; }</style>
</head>
<body class="flex flex-col items-center justify-center h-screen bg-black">
    <div class="text-center p-10 glass rounded-3xl border border-yellow-500/20 max-w-lg">
        <i class="fa-solid fa-person-digging text-6xl text-yellow-500 mb-6 animate-bounce"></i>
        <h1 class="text-4xl font-bold mb-4">Under Maintenance</h1>
        <p class="text-gray-400 mb-8">We are currently upgrading our infrastructure. Please check back later.</p>
        <a href="https://discord.gg/bV86tv4PPA" class="bg-indigo-600 hover:bg-indigo-500 px-8 py-3 rounded-full font-bold transition">Join Discord for Updates</a>
        
        <% if(user && user.isAdmin) { %>
            <div class="mt-8 border-t border-white/10 pt-4">
                <p class="text-xs text-gray-500 mb-2">Admin Bypass Active</p>
                <a href="/dashboard" class="text-indigo-400 underline text-sm">Continue to Dashboard</a>
            </div>
        <% } %>
    </div>
</body>
</html>