<!DOCTYPE html>
<html class="dark">
<head>
    <title>Error <%= code %></title>
    <% if (typeof siteLogo !== 'undefined' && siteLogo) { %>
    <link rel="icon" type="image/png" href="<%= siteLogo %>">
    <link rel="apple-touch-icon" href="<%= siteLogo %>">
    <% } %>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>body { background: #020617; color: white; }</style>
</head>
<body class="flex items-center justify-center h-screen bg-black">
    <div class="text-center p-12 rounded-3xl bg-white/5 border border-white/10 max-w-lg w-full">
        <h1 class="text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-500 mb-4"><%= code %></h1>
        <p class="text-2xl font-bold text-white mb-2"><%= msg %></p>
        <% if(locals.reason) { %>
            <div class="bg-black/30 p-3 rounded-xl text-red-300 text-sm font-mono mb-6"><%= reason %></div>
        <% } %>
        <div class="flex items-center justify-center gap-3">
            <a href="/" class="inline-block bg-white/10 hover:bg-white/20 px-6 py-3 rounded-xl font-bold transition">Return Home</a>
            <% if(code === 'BANNED') { %>
            <% } %>
        </div>
    </div>
</body>
</html>


