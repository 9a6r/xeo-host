<!DOCTYPE html>
<html class="dark">
<head>
    <title>500 Server Error</title>
    <% if (typeof siteLogo !== 'undefined' && siteLogo) { %>
    <link rel="icon" type="image/png" href="<%= siteLogo %>">
    <link rel="apple-touch-icon" href="<%= siteLogo %>">
    <% } %>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-white h-screen flex flex-col items-center justify-center">
    <h1 class="text-9xl font-bold text-red-600 mb-4">500</h1>
    <p class="text-2xl text-gray-400 mb-8">Internal Server Error.</p>
    <a href="/" class="bg-white/10 hover:bg-white/20 px-6 py-2 rounded-full transition">Go Home</a>
</body></html>